<view class="shell has-submit"><view class="mast"><view class="title">灵活就业养老</view><button wx:if="{{result}}" class="result-region-link" bindtap="toggleRegion" aria-label="更换领取地区"><text>{{result.region}}</text><text>{{regionOpen?'收起 −':'更换 ›'}}</text></button></view>
<region-picker wx:if="{{!result || regionOpen}}" value="{{form.regionId||'440100'}}" kind="flexible" bindchange="regionChanged"/>
<block wx:if="{{!result && regionReady}}"><view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<view class="card employee-form pension-form"><view class="card-top"><view class="card-title">参保信息</view><button class="text-button" bindtap="reset">重新填写</button></view>
<checkbox-group wx:if="{{form.regionId==='440300'}}" bindchange="szScope"><label class="switch-row"><checkbox value="yes" checked="{{form.szScopeConfirmed==='yes'}}" color="#2463eb"/>非深户，深圳实缴满10年、在此领取，无地方补充权益</label></checkbox-group><view class="basic-grid"><view class="basic-field"><view class="basic-label">出生年月</view><picker mode="date" fields="month" start="{{dateBounds.birthStart}}" end="{{dateBounds.birthEnd}}" value="{{form.birthMonth}}" data-key="birthMonth" bindchange="input"><view class="control">{{form.birthMonth}}</view></picker></view><view class="basic-field"><view class="basic-label label-with-info">退休类别<button class="info-trigger" data-key="category" bindtap="info" aria-label="查看退休类别说明">!</button></view><picker range="{{categoryLabels}}" value="{{categoryIndex}}" bindchange="category"><view class="control">{{categoryLabels[categoryIndex]}}</view></picker></view></view>
<view class="form-section-title">已经交的</view>
<view class="entry-row"><text class="row-label">单位交过</text><view class="input-wrap row-entry duration-input"><input type="number" value="{{form.unitYears}}" data-key="unitYears" bindinput="input" aria-label="单位缴费年数"/><text>年</text><input type="number" value="{{form.unitMonths}}" data-key="unitMonths" bindinput="input" aria-label="单位缴费剩余月数"/><text>个月</text></view></view>
<view class="entry-row"><text class="row-label">自己交过</text><view class="input-wrap row-entry duration-input"><input type="number" value="{{form.flexYears}}" data-key="flexYears" bindinput="input" aria-label="灵活就业缴费年数"/><text>年</text><input type="number" value="{{form.flexMonths}}" data-key="flexMonths" bindinput="input" aria-label="灵活就业缴费剩余月数"/><text>个月</text></view></view>
<button class="history-total" data-key="history" bindtap="info"><text>累计已交 {{paidDuration}}</text><text aria-label="查看累计年限说明">ⓘ</text></button>
<view class="compact-section"><button class="compact-heading" data-section="accountOpen" bindtap="toggleSection"><text class="compact-title">个人账户{{accountMode==='estimate'?'（估）':''}}</text><view class="compact-values"><view class="compact-amount">{{accountMode==='estimate'?'约':''}}{{accountSummary||'待填写'}}{{accountSummary?'元':''}}</view><text class="compact-change">{{accountOpen?'收起 −':'修改 ›'}}</text></view></button><view wx:if="{{accountOpen && accountMode==='estimate'}}" class="compact-note">{{historyModeIndex===0?'按当前最低档粗算，未计历年变化和利息。':'按以前平均缴费粗算，未加利息。'}}</view>
<view wx:if="{{accountOpen}}" class="compact-editor"><view class="segment field"><button class="{{accountMode==='estimate'?'selected':''}}" data-value="estimate" bindtap="accountMode">帮我估</button><button class="{{accountMode==='known'?'selected':''}}" data-value="known" bindtap="accountMode">填查询余额</button></view>
<block wx:if="{{accountMode==='estimate'}}"><picker range="{{['按当前最低档粗算','填以前每月交的钱']}}" value="{{historyModeIndex}}" bindchange="historyMode"><view class="control">{{['按当前最低档粗算','填以前每月交的钱'][historyModeIndex]}}</view></picker><block wx:if="{{historyModeIndex===1}}"><view wx:if="{{historySummary.unit>0}}" class="field"><text>以前单位每月扣养老</text><view class="input-wrap"><input type="digit" value="{{form.unitPayment}}" data-key="unitPayment" bindinput="input" placeholder="历史平均个人扣款"/><text>元</text></view></view><view wx:if="{{historySummary.flex>0}}" class="field"><text>以前自己每月交养老</text><view class="input-wrap"><input type="digit" value="{{form.flexPayment}}" data-key="flexPayment" bindinput="input" placeholder="历史平均全额缴费"/><text>元</text></view></view><view class="hint">只填养老，不含医保。自己交的全额，只有40%进个人账户。</view></block></block>
<block wx:else><view class="input-wrap field"><input type="digit" value="{{form.principal}}" data-key="principal" bindinput="input" placeholder="含利息的账户余额"/><text>元</text></view><button class="small-help" data-key="account" bindtap="info">账户余额去哪查 ›</button></block><view wx:if="{{accountError}}" class="hint field">{{accountError}}</view></view></view>
<view class="compact-section future-section"><button class="compact-heading" data-section="paymentOpen" bindtap="toggleSection"><text class="compact-title">自己每月交</text><view class="compact-values"><view class="compact-amount">{{futurePayment||'待填写'}}{{futurePayment!==''?'元':''}}</view><text class="compact-change">{{paymentOpen?'收起 −':'修改 ›'}}</text></view></button><view wx:if="{{paymentOpen}}" class="compact-editor"><picker range="{{baseModeLabels}}" value="{{baseModeIndex}}" bindchange="baseMode"><view class="control">{{baseModeLabels[baseModeIndex]}}</view></picker><view wx:if="{{baseModeIndex>0}}" class="field"><text>{{baseModeIndex===1?'每月养老缴费':'每月缴费基数'}}</text></view><view wx:if="{{baseModeIndex>0}}" class="input-wrap field"><input type="digit" value="{{baseInput}}" bindinput="baseInput" placeholder="{{baseModeIndex===1?'每月自己交的养老费':'月缴费基数'}}"/><text>元</text></view><view class="hint">每月可交{{minimumPayment}}至{{maximumPayment}}元，今后基数调整另计。</view><view wx:if="{{planIndex===1||planIndex===2}}" class="hint">当前计划用最低档；要用自填金额，请选“照这个金额交到退休”。</view><view wx:if="{{baseError&&baseInput!==''}}" class="hint">{{baseError}}</view></view></view>
<view class="entry-row plan-entry"><text class="row-label">交多久</text><picker class="row-entry" range="{{planLabels}}" value="{{planIndex}}" bindchange="plan"><view class="control">{{planLabels[planIndex]}}</view></picker></view><view wx:if="{{planIndex===3}}" class="input-wrap field"><input type="number" value="{{form.customMonths}}" data-key="customMonths" bindinput="input"/><text>个月</text></view>
<button class="fold" bindtap="toggle">更多设置<text>{{advanced?'收起':'选填 ＋'}}</text></button><view wx:if="{{advanced}}"><view class="entry-row"><text class="row-label">首次缴费</text><picker class="row-entry" mode="date" fields="month" start="{{firstStart}}" end="{{form.dataAsOf}}" value="{{form.firstInsuredMonth}}" data-key="firstInsuredMonth" bindchange="input"><view class="control">{{form.firstInsuredMonth}}</view></picker></view><view class="entry-row"><text class="row-label">数据截至</text><picker class="row-entry" mode="date" fields="month" end="{{dateBounds.todayMonth}}" value="{{form.dataAsOf}}" data-key="dataAsOf" bindchange="input"><view class="control">{{form.dataAsOf}}</view></picker></view><view class="field"><text>先停交几个月</text><input class="control" type="number" value="{{form.pauseMonths}}" data-key="pauseMonths" bindinput="input"/></view><view class="field"><text>历史平均缴费指数</text><input class="control" type="digit" value="{{form.historicalIndex}}" data-key="historicalIndex" bindinput="input" placeholder="不知道按0.6估算"/></view><view class="switch-row"><text>有视同缴费等特殊情况</text><switch checked="{{form.historicalRights}}" bindchange="historyRights" color="#2463eb"/></view><button class="small-help" data-key="rules" bindtap="info">缴费和补缴有什么规定 ›</button></view>
</view><view class="submit-dock"><button class="primary" bindtap="calculate">开始计算</button></view></block>
<block wx:if="{{result}}">
<view class="pension-income"><view class="income-top"><text class="pension-label">{{result.chosen.qualified?'退休后，每月约领':'缴费年限不足'}}</text><button class="info-trigger" bindtap="resultInfo" aria-label="查看计算说明">!</button></view><block wx:if="{{result.chosen.qualified}}"><view class="pension-value">{{result.chosen.monthly}}<text>元</text></view><view class="pension-start">{{result.chosen.receiptMonth}}起领</view></block><view wx:else class="short-result">{{result.chosen.unsupported?result.chosen.error:'还差'+result.chosen.shortMonths+'个月'}}</view><view wx:if="{{result.warnings.length}}" class="scope-tag">日期待核对</view></view>
<view class="card field payment-card"><view class="card-title">接下来这样交</view><view class="payment-condition">已交{{paidDuration}} · 累计需交{{result.chosen.minimumMonths/12}}年</view><view class="payment-grid"><view>每月交<text>{{result.chosen.monthlyPersonalPayment}}元</text></view><view>还交<text>{{result.chosen.years}}</text></view></view><view class="payment-date">交至{{result.chosen.lastPaymentMonth}}<text wx:if="{{result.chosen.lastPaymentMonth>result.retirement.month}}"> · 到龄后继续交</text></view><view class="total-row"><text>还需交</text><text>{{result.chosen.futurePersonalCost}}元</text></view></view>
<view class="submit-dock result-dock"><view class="result-actions"><button class="secondary restart-button" bindtap="reset">重新填写</button><button class="primary" bindtap="edit">修改信息</button></view></view>
<view class="card result-section"><button class="fold result-fold" bindtap="compare"><view>换个方案</view><text>{{compare?'收起 −':'选择 ›'}}</text></button><view wx:if="{{compare}}" class="section-body"><button wx:for="{{planChoices}}" wx:key="plan" data-plan="{{item.plan}}" bindtap="selectPlan" class="plan-choice {{item.plan===(pendingPlan||form.plan)?'chosen-plan':''}}" aria-label="{{item.name}}，{{item.qualified?'每月约'+item.monthly+'元':item.unsupported?'暂不支持':'缴费年限不足'}}"><view>{{item.name}}<text>{{item.plan===(pendingPlan||form.plan)?(pendingPlan?'待确认':'当前方案'):'选择'}}</text></view><view class="plan-monthly">{{item.qualified?'每月约'+item.monthly+'元':item.unsupported?'暂不支持该年龄':'还差'+item.shortMonths+'个月'}}</view></button><button class="primary confirm-plan" bindtap="applySelectedPlan" disabled="{{!pendingPlan}}">按所选方案计算</button></view></view>
<view class="card result-section"><button class="fold result-fold" bindtap="toggle"><view>缴费明细与说明</view><text>{{advanced?'收起 −':'查看 ›'}}</text></button><view wx:if="{{advanced}}" class="detail-text"><view>单位{{form.unitYears}}年{{form.unitMonths}}个月 · 自己{{form.flexYears}}年{{form.flexMonths}}个月</view><view>个人账户{{result.accountPrincipal}}元{{result.estimatedAccount?'（估算）':''}}</view><view>出生{{form.birthMonth}} · 首次参保{{form.firstInsuredMonth}}</view><view>记录截至{{form.dataAsOf}} · 退休年月{{result.retirement.month}}</view><view wx:if="{{form.plan==='MINIMUM_STOP'}}">交够年限可停缴，仍需等到领取年龄。</view><view wx:if="{{result.chosen.lastPaymentMonth>result.retirement.month}}">到龄后还需延缴，能否办理以参保地确认为准。</view><view wx:if="{{result.chosen.qualified && result.chosen.recoveryMonthsSlow>0}}">开始领取后，按{{result.chosen.recovery}}算，能领回以后交的这笔钱。包含以前积累的权益，未计等待时间和利息。</view><view>个人承担全部养老费；现行比例20%，其中缴费基数的8%进入个人账户。</view><view wx:if="{{result.estimatedAccount}}">账户按{{historyModeIndex===0?'当前最低档':'以前平均缴费'}}估算，未计历年变化和利息。</view><view>历史指数未知时按0.6，未知利息为0；待遇参考{{result.parameter.year}}年参数，未来调整未计入。</view><view wx:if="{{result.referenceNote}}">{{result.referenceNote}}</view><view wx:for="{{result.warnings}}" wx:key="*this">{{item}}</view><view>通常不能补交以前断缴年限，到龄不足需按规定继续交。</view><button class="small-help" bindtap="policy">当地缴费规定 ›</button><view>按{{result.region}}作为领取地计算，实际条件和金额以社保核定为准。</view></view></view></block>
<view wx:if="{{result}}" class="share-entry"><button class="secondary" bindtap="openShareCard">保存／分享方案</button></view></view><tool-nav active="flexible"/>
