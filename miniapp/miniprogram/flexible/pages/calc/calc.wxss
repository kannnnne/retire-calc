@import "../../../pages/index/index.wxss";
.duration-input{gap:12rpx}.duration-input input{width:56rpx;min-width:0;text-align:center;flex:1}.duration-input text{flex:none}.history-total{width:100%;display:flex;justify-content:space-between;align-items:center;min-height:88rpx;padding:12rpx 0;font-size:26rpx;color:var(--muted);text-align:left}.history-total text:last-child{color:var(--brand)}.history-total::after{border:0}

.income-top{display:flex;align-items:center;justify-content:space-between}.info-trigger{position:relative;display:inline-flex!important;align-items:center;justify-content:center;width:88rpx!important;min-height:88rpx;padding:0;font-size:25rpx;font-weight:600;color:var(--muted);background:transparent;flex-shrink:0}.info-trigger::before{content:"";position:absolute;width:32rpx;height:32rpx;border:2rpx solid currentColor;border-radius:50%}.info-trigger::after{border:0}.label-with-info{display:flex;align-items:center;justify-content:space-between;min-height:48rpx}.label-with-info .info-trigger{margin:-20rpx -16rpx -20rpx 0}.income-top .info-trigger{margin:-18rpx -16rpx -18rpx 0}.payment-condition{color:var(--muted);font-size:27rpx;line-height:1.6;margin:14rpx 0}.scope-tag{font-size:24rpx;color:var(--muted);margin-top:16rpx}.short-result{font-size:34rpx;margin-top:18rpx}.confirm-plan{margin-top:24rpx}.confirm-plan[disabled]{background:#edf1f7;color:#66758b}.section-body{padding-top:16rpx}.history-total text:last-child{min-width:60rpx;text-align:right}.payment-card .total-row{margin-bottom:0}.compact-section.future-section{margin-top:28rpx}
