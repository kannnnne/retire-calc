page{--brand:#2463eb;--ink:#172b4d;--muted:#576579;--line:#e3e8ef;--surface:#fff;--canvas:#f5f7fa;background:var(--canvas);color:var(--ink);font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx;line-height:1.5}button{box-sizing:border-box;max-width:100%;margin:0;padding:0;font-size:28rpx;line-height:1.5;border-radius:12rpx;background:transparent;color:var(--ink)}button::after{border:0}button[disabled]{opacity:.5}button.button-hover{opacity:.72}.shell{max-width:900rpx;margin:0 auto;padding:24rpx 28rpx calc(170rpx + env(safe-area-inset-bottom))}.mast{display:flex;justify-content:space-between;align-items:center;gap:20rpx;margin-bottom:24rpx}.eyebrow{font-size:25rpx;color:var(--muted)}.title{font-size:40rpx;font-weight:650;line-height:1.35;margin-top:8rpx}.help-link,.text-button{display:inline-flex;align-items:center;justify-content:center;color:var(--brand);min-height:88rpx;padding:8rpx 16rpx;font-size:27rpx;flex-shrink:0}.card{background:var(--surface);border:1rpx solid var(--line);border-radius:18rpx;padding:28rpx;box-shadow:none}.card+.card{margin-top:24rpx}.card-top{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:16rpx}.card-title{font-size:32rpx;font-weight:600}.field{margin-top:24rpx}.field>text,.label{font-size:29rpx;color:var(--ink)}.label{display:flex;align-items:center;gap:8rpx}.control,.input-wrap{margin-top:12rpx;min-height:88rpx;padding:0 22rpx;border:1rpx solid #c8d1de;border-radius:12rpx;background:#fff;display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;font-size:31rpx;color:var(--ink)}input.control{height:88rpx}.input-wrap input{flex:1;min-width:0;height:86rpx;font-size:31rpx}.control text,.input-wrap>text{color:var(--muted);font-size:26rpx;margin-left:12rpx}.placeholder{color:#637186}.question{flex:none;display:inline-flex;align-items:center;justify-content:center;width:72rpx;min-width:72rpx;height:72rpx;border-radius:50%;font-size:28rpx;color:var(--brand);background:transparent;padding:0;margin:0}.tutorial{display:block;width:100%;min-height:88rpx;text-align:left;background:#f0f5ff;color:var(--brand);padding:22rpx;margin-top:20rpx;font-size:28rpx}.switch-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx;font-size:28rpx}.switch-row switch{flex:none;transform:scale(.85)}.actions{display:flex;gap:16rpx;margin-top:24rpx}.primary{display:flex;align-items:center;justify-content:center;flex:1;width:100%!important;min-height:96rpx;background:var(--brand);color:#fff;padding:20rpx 24rpx;font-size:32rpx;font-weight:600;box-sizing:border-box}.secondary{display:flex;align-items:center;justify-content:center;min-height:96rpx;padding:20rpx 24rpx;background:#edf2fa;color:var(--brand);font-size:29rpx}.quiet{font-size:25rpx;line-height:1.6;color:var(--muted);text-align:center;margin:24rpx 0}.hint{font-size:26rpx;line-height:1.65;color:var(--muted);margin-top:16rpx}.segment{display:flex;gap:16rpx}.segment button{flex:1;display:flex;align-items:center;justify-content:center;min-height:88rpx;font-size:27rpx;padding:14rpx 8rpx;background:#f5f7fa;border:1rpx solid #c8d1de;color:#48586e}.segment .selected{background:#eaf1ff;color:#174ab5;border-color:#2463eb;font-weight:600}.fold{display:flex;align-items:center;justify-content:space-between;gap:16rpx;background:transparent;color:var(--ink);width:100%!important;min-height:88rpx;padding:18rpx 0;font-size:28rpx;text-align:left;box-sizing:border-box;border-top:1rpx solid var(--line);margin-top:20rpx}.fold text{color:var(--muted);font-weight:400}.error{color:#a32b25;background:#fff0ee;border:1rpx solid #f2c3bd;padding:20rpx;border-radius:12rpx;font-size:28rpx;line-height:1.6;margin:20rpx 0}.footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8rpx;margin-top:24rpx;color:#a7b0bc}.footer button{display:flex;align-items:center;min-height:88rpx;padding:10rpx;color:#465b78;font-size:25rpx}.result-card{background:#edf4ff;color:var(--ink);border:1rpx solid #cdddf6;border-radius:18rpx;padding:32rpx}.light{color:#455b7e}.amount{font-size:54rpx;line-height:1.3;font-weight:650;letter-spacing:-1rpx;margin-top:20rpx;word-break:break-word;color:#174ab5}.amount text{font-size:26rpx;font-weight:400;letter-spacing:0;margin-left:8rpx}.receipt{font-size:28rpx;color:#455b7e;margin-top:16rpx}.result-meta{display:flex;gap:24rpx;border-top:1rpx solid #d4e0f4;padding-top:24rpx;margin-top:24rpx}.result-meta view{flex:1;font-size:25rpx;color:#455b7e}.result-meta text{display:block;font-size:30rpx;font-weight:600;margin-top:8rpx;color:var(--ink)}.summary{margin-top:24rpx}.metrics{display:flex;gap:24rpx;margin-top:20rpx}.metrics view{flex:1;font-size:26rpx;color:var(--muted)}.metrics text{display:block;font-size:32rpx;color:var(--ink);font-weight:600;margin-top:8rpx}.total-row{display:flex;justify-content:space-between;gap:16rpx;padding:24rpx 0;margin-top:20rpx;border-top:1rpx solid var(--line);font-size:28rpx}.total-row text:last-child{font-size:32rpx;font-weight:600}.payback{padding:22rpx;background:#f4f7fc;border-radius:12rpx}.payback>text{display:block;font-size:34rpx;font-weight:600;margin-top:8rpx}.incremental,.result-notice{font-size:26rpx;color:var(--muted);line-height:1.65;margin-top:20rpx}.comparison{padding:24rpx 0;border-bottom:1rpx solid var(--line);font-size:28rpx}.comparison>view:first-child{display:flex;justify-content:space-between;gap:16rpx}.comparison text{font-weight:600}.not-enough{font-size:36rpx;font-weight:600;margin-top:20rpx}.parameter-note{display:flex;align-items:center;gap:8rpx;font-size:25rpx;color:var(--muted);line-height:1.5;margin-top:12rpx}.auto-summary{display:flex;justify-content:space-between;gap:16rpx;background:#f0f5ff;border-radius:10rpx;padding:18rpx;margin-top:16rpx;font-size:27rpx;flex-wrap:wrap}.auto-summary text:last-child{font-weight:600;color:#174ab5}.section-heading{font-size:30rpx;font-weight:600;padding:24rpx 0 0;margin-top:28rpx;border-top:1rpx solid var(--line)}.section-heading:first-child{margin-top:0;padding-top:0;border-top:0}.form-caption{color:var(--muted);font-size:26rpx;margin-top:8rpx}.submit-dock{position:fixed;left:0;right:0;bottom:calc(118rpx + env(safe-area-inset-bottom));z-index:15;padding:16rpx 28rpx;background:#fff;border-top:1rpx solid var(--line)}.submit-dock .primary{max-width:844rpx;margin:auto}.has-submit{padding-bottom:calc(300rpx + env(safe-area-inset-bottom))}.inline-mode{font-size:27rpx;color:var(--brand);min-height:88rpx;display:flex;align-items:center;justify-content:flex-end}.notice-box{background:#f5f7fa;border-radius:12rpx;padding:20rpx;font-size:26rpx;color:var(--muted);line-height:1.6}.dual-fields{display:flex;gap:20rpx}.dual-fields>.field{flex:1;min-width:0}

.mast .help-link,.card-top .text-button{width:auto!important}.tutorial{background:#f5f7fa;color:#2456a6}.field-error{font-size:26rpx;color:#a32b25;margin-top:10rpx}.employee-form .field{margin-top:20rpx}

.question{width:88rpx!important;min-width:88rpx;max-width:88rpx;height:88rpx}.eligibility-check,.condition-link{width:auto!important}.payback .label{font-size:27rpx}

.tutorial{width:100%!important;box-sizing:border-box}

page{--motion-press:130ms;--motion-enter:220ms}button{transition:background-color var(--motion-press) ease,opacity var(--motion-press) ease}button.button-hover{opacity:.78}.primary.button-hover{background:#174fca;opacity:1}.income-tile,.employee-income{animation:soft-appear var(--motion-enter) ease-out both}@keyframes soft-appear{from{opacity:.35}to{opacity:1}}@media(prefers-reduced-motion:reduce){button{transition:none}.income-tile,.employee-income{animation:none}}

/* Shared native picker affordance and result actions. */
picker .control{gap:18rpx;background:#f8faff;border-color:#bac9dd;padding-right:24rpx;position:relative}
picker .control::after{content:'';display:block;width:14rpx;height:14rpx;flex:none;border-right:3rpx solid #526984;border-bottom:3rpx solid #526984;transform:rotate(45deg);margin:-7rpx 3rpx 0 14rpx}
.result-actions{display:flex;align-items:stretch;gap:20rpx;max-width:844rpx;margin:auto}.result-actions .primary{width:auto!important;margin:0;min-width:0}.result-actions .restart-button{flex:none;min-width:196rpx;border:1rpx solid #c8d1de;background:#fff;color:var(--muted)}
