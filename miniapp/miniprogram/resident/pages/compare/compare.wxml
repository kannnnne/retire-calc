<template name="pk-grid"><view class="pk-matrix"><view class="pk-fixed-labels"><view class="pk-label pk-head" style="height:{{table.headerHeight}}rpx">以后年缴</view><view wx:for="{{rows}}" wx:key="id" class="pk-label pk-{{item.kind}}" style="height:{{item.height}}rpx"><view>{{item.label}}</view></view></view><scroll-view scroll-x class="pk-values-scroll"><view class="pk-values" style="width:{{ids.length>2?(tableWidth-190)+'rpx':'100%'}}"><view class="pk-line pk-head" style="height:{{table.headerHeight}}rpx"><view wx:for="{{table.columns}}" wx:key="tier" class="pk-cell">{{item.label}}<text wx:if="{{item.current}}" class="pk-current">当前方案</text></view></view><view wx:for="{{rows}}" wx:key="id" class="pk-line pk-{{item.kind}}" style="height:{{item.height}}rpx"><view wx:for="{{item.values}}" wx:for-item="value" wx:for-index="valueIndex" wx:key="index" class="pk-cell {{item.tones?item.tones[valueIndex]:''}}">{{value}}</view></view></view></scroll-view></view></template>
<view class="pk-shell"><block wx:if="{{ready}}"><view class="pk-title">缴费档次对比</view><view class="pk-sub">{{region}} · {{asOf}}</view><view wx:if="{{table}}" class="pk-facts"><view wx:for="{{table.facts}}" wx:key="label" class="pk-fact {{item.label==='方案范围'?'pk-fact-wide':''}}"><text>{{item.label}}</text><view>{{item.value}}</view></view></view><view class="pk-toolbar"><view class="pk-filter-row"><button class="pk-tier-select" bindtap="tiers" aria-label="选择对比档次" aria-expanded="{{showTiers}}"><view>选择档次</view><view class="select-chevron {{showTiers?'is-open':''}}" aria-hidden="true"/></button><button class="pk-all-action" bindtap="selectAll">对比全部档次</button></view><view class="pk-selection-summary">已选 {{ids.length}} 个方案<text wx:if="{{ids.length>2}}"> · 左右滑动查看</text></view></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!table}}" class="pk-empty">再选一档，就能看出差别。</view><block wx:if="{{table}}"><view wx:for="{{table.shared}}" wx:key="label" class="pk-shared"><text>{{item.label}}</text><view>{{item.value}}</view></view><view class="pk-table-intro">从现在起，还需交多少、每月领多少</view><template is="pk-grid" data="{{table:table,rows:table.mainRows,ids:ids,tableWidth:tableWidth}}"/><view class="pk-caption">{{table.recoveryBasis}}</view><view class="pk-receipt-details"><button class="pk-disclosure" bindtap="receipts" aria-expanded="{{showReceipts}}"><text>领取明细</text><view class="pk-disclosure-end">{{showReceipts?'收起':'展开'}}<view class="select-chevron {{showReceipts?'is-open':''}}"/></view></button><block wx:if="{{showReceipts}}"><view class="pk-period"><text>领取多久</text><picker range="{{periods}}" value="{{periodIndex}}" bindchange="period"><view class="period-select">{{periods[periodIndex]}}<view class="select-chevron"/></view></picker></view><template is="pk-grid" data="{{table:table,rows:table.extraRows,ids:ids,tableWidth:tableWidth}}"/><view class="pk-caption">扣除缴费后＝{{table.balanceBasis}}</view></block></view><view class="pk-explanation"><button class="pk-disclosure" bindtap="notes" aria-expanded="{{showNotes}}"><text>计算说明与来源</text><view class="pk-disclosure-end">{{showNotes?'收起':'展开'}}<view class="select-chevron {{showNotes?'is-open':''}}"/></view></button><view wx:if="{{showNotes}}" class="pk-notes"><view wx:for="{{table.notes}}" wx:key="*this">{{item}}</view><view wx:for="{{conditions}}" wx:key="*this">{{item}}</view><button wx:for="{{sources}}" wx:key="url" class="source-link" data-index="{{index}}" bindtap="copySource"><view>{{item.name||'政策来源'}}</view><text>复制原文链接 ›</text></button></view></view></block><view class="pk-dock"><button class="primary" disabled="{{!table}}" bindtap="share">分享给朋友</button></view></block><view wx:else class="pk-empty">请从计算结果进入，先确定个人资料。<button bindtap="back">返回</button></view><view wx:if="{{showTiers}}" class="pk-picker-mask" bindtap="tiers" catchtouchmove="hold"><view class="pk-picker-sheet" catchtap="hold"><view class="pk-picker-header"><view><view class="pk-picker-title">选择对比档次</view><text>可多选 · 已选 {{ids.length}} 档</text></view><button class="pk-picker-close" bindtap="tiers">收起</button></view><scroll-view scroll-y class="pk-picker-scroll"><view class="pk-chips"><button wx:for="{{plans}}" wx:key="tier" class="{{item.selected?'chosen':''}}" data-tier="{{item.tier}}" bindtap="toggle" aria-label="{{item.label}}，{{item.selected?'已选':'未选'}}">{{item.label}}<text wx:if="{{item.current}}">当前</text></button></view></scroll-view><view class="pk-picker-actions"><button class="pk-select-all" bindtap="selectAll">全部选中</button><button class="primary" bindtap="tiers">完成选择</button></view></view></view></view>