<view class="pk-shell"><block wx:if="{{ready}}"><view class="pk-title">换个档次，差多少？</view><view class="pk-sub">{{region}} · 同一份资料 · {{asOf}}</view><view class="pk-select-label">选2—3档对比 <text>已选{{ids.length}}档</text></view><view class="pk-chips"><button wx:for="{{plans}}" wx:key="tier" class="{{item.selected?'chosen':''}}" data-tier="{{item.tier}}" bindtap="toggle" aria-label="{{item.label}}，{{item.selected?'已选':'未选'}}">{{item.label}}<text wx:if="{{item.current}}">当前</text></button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!table}}" class="pk-empty">再选一档，就能看出差别。</view><block wx:if="{{table}}"><view wx:if="{{ids.length===3}}" class="pk-caption">左右滑动表格，查看第三档 →</view><scroll-view scroll-x class="pk-scroll"><view class="pk-table {{ids.length===3?'three':''}}"><view class="pk-line pk-head"><view class="pk-label">方案年档</view><view wx:for="{{table.columns}}" wx:key="tier" class="pk-cell">{{item.label}}<text wx:if="{{item.current}}" class="pk-current">当前方案</text></view></view><view wx:for="{{table.rows}}" wx:key="label" class="pk-line {{index===0?'pk-income':''}}"><view class="pk-label">{{item.label}}</view><view wx:for="{{item.values}}" wx:for-item="value" wx:key="index" class="pk-cell">{{value}}</view></view></view></scroll-view><view class="pk-caption">金额为情景估算。</view><view class="pk-period"><text>累计领取示例</text><picker range="{{periods}}" value="{{periodIndex}}" bindchange="period"><view>{{periods[periodIndex]}}⌄</view></picker></view><button class="pk-link" bindtap="all">{{showAll?'收起全部档次':'看看其他档次的大致结果'}} ›</button><view wx:if="{{showAll}}" class="pk-overview"><view class="pk-over-line"><text>年档</text><text>后续需交</text><text>每月约领</text><text></text></view><button wx:for="{{plans}}" wx:key="tier" class="pk-over-line" data-tier="{{item.tier}}" bindtap="toggle"><text>{{item.tier}}</text><text>{{item.future}}</text><text>{{item.monthly}}</text><text>{{item.selected?'已选':'＋'}}</text></button></view><button class="pk-link" bindtap="notes">计算口径与条件 {{showNotes?'收起 −':'查看 ＋'}}</button><view wx:if="{{showNotes}}" class="pk-notes"><view wx:for="{{table.notes}}" wx:key="*this">{{item}}</view><view wx:for="{{conditions}}" wx:key="*this">{{item}}</view><button wx:for="{{sources}}" wx:key="url" class="pk-link" data-index="{{index}}" bindtap="copySource">{{item.name||'政策来源'}} · 复制链接</button></view></block><view class="pk-dock"><button class="primary" disabled="{{!table}}" bindtap="share">保存这份对比</button></view></block><view wx:else class="pk-empty">请从计算结果进入，先确定个人资料。<button bindtap="back">返回</button></view></view>