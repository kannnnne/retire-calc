.pk-shell{padding:36rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));max-width:820rpx;margin:auto}.pk-title{font-size:40rpx;font-weight:650;color:#182c47}.pk-sub,.pk-caption{font-size:25rpx;color:#506078;line-height:1.65;margin:16rpx 0 24rpx}.pk-chips{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:28rpx}.pk-chips button{min-height:48px;font-size:26rpx;background:#fff;border:1rpx solid #dce4ef;padding:16rpx 20rpx;border-radius:20rpx;margin:0;display:flex;align-items:center;gap:8rpx}.pk-chips .chosen{background:#edf3ff;border-color:#2463eb;color:#174ab5}.pk-chips text{font-size:21rpx;color:#506078}.pk-table{background:white;border:1rpx solid #dce4ef;border-radius:20rpx;overflow:hidden;min-width:100%}.pk-table.three{min-width:800rpx}.pk-line{display:flex;border-bottom:1rpx solid #e5eaf2;align-items:stretch}.pk-line:last-child{border-bottom:0}.pk-label{width:170rpx;flex:none;color:#506078;padding:25rpx 15rpx;box-sizing:border-box;font-size:26rpx;display:flex;align-items:center}.pk-cell{flex:1;min-width:0;padding:25rpx 12rpx;text-align:center;font-size:28rpx;line-height:1.6;white-space:pre-line;word-break:break-word;box-sizing:border-box;border-left:1rpx solid #eef1f6}.pk-head{background:#f3f6fb;font-weight:600}.pk-income{background:#edf3ff}.pk-income .pk-cell{color:#174ab5;font-weight:650;font-size:34rpx}.pk-current{display:block;font-size:22rpx;font-weight:400;color:#506078}.pk-period{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;min-height:96rpx}.pk-period picker{color:#245bc1;min-height:48px;display:flex;align-items:center}.pk-link{width:100%;text-align:left;min-height:48px;font-size:27rpx;padding:20rpx 0;color:#245bc1;background:transparent}.pk-notes{font-size:25rpx;line-height:1.75;color:#506078}.pk-notes view{margin-bottom:12rpx}.pk-dock{position:fixed;left:0;right:0;bottom:0;background:#fff;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dce4ef;z-index:10}.pk-dock button{max-width:820rpx;margin:auto}.pk-empty{padding:40rpx 0;color:#506078;font-size:28rpx}.pk-overview{background:white;border-radius:20rpx;padding:12rpx}.pk-over-line{display:flex;align-items:center;width:100%;min-height:48px;font-size:25rpx;text-align:left;background:white}.pk-over-line text{flex:1}.pk-over-line text:last-child{max-width:56rpx}.pk-over-line:first-child{color:#506078}
.pk-chips button{width:calc((100% - 28rpx) / 3);min-width:0;flex:none;flex-direction:column;justify-content:center;padding:10rpx 4rpx;gap:2rpx;line-height:1.35}.pk-scroll{width:100%}


.pk-label{position:sticky;left:0;background:#fff;z-index:1}.pk-head .pk-label{background:#f3f6fb}.pk-income .pk-label{background:#edf3ff}
.period-select{display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:44px;min-width:210rpx;padding:10rpx 22rpx;box-sizing:border-box;border:1rpx solid #b9c8de;border-radius:18rpx;background:#fff;color:var(--ink)}
.select-chevron{width:12rpx;height:12rpx;border-right:3rpx solid #526984;border-bottom:3rpx solid #526984;transform:rotate(45deg);margin-top:-6rpx;flex:none}

.pk-toolbar{margin:28rpx 0 20rpx}.pk-filter-row{display:flex;align-items:center;gap:24rpx;width:100%;min-width:0}
.pk-filter-row .pk-tier-select{flex:1;min-width:0;width:auto!important;display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:16rpx 24rpx;min-height:48px;box-sizing:border-box;background:#fff;border:1rpx solid #b9c8de;border-radius:18rpx;font-size:28rpx;text-align:left;color:var(--ink);margin:0}
.pk-filter-row .pk-all-action{flex:none;min-width:0;width:auto!important;min-height:48px;padding:10rpx 0;display:flex;align-items:center;background:transparent;border:0;box-shadow:none;border-radius:0;font-size:27rpx;white-space:nowrap;color:var(--brand);margin:0}
.pk-selection-summary{display:block;width:100%;font-size:25rpx;color:var(--muted);line-height:1.6;margin-top:16rpx;white-space:nowrap}.pk-selection-summary text{font-size:24rpx}
.pk-chips{padding:20rpx;border:1rpx solid var(--line);border-radius:20rpx;background:#fff;box-sizing:border-box}.select-chevron.is-open{transform:rotate(225deg);margin-top:6rpx}

/* The labels sit outside scroll-view: stable on iOS and Android without sticky. */
.pk-matrix{display:flex;width:100%;min-width:0;border:1rpx solid #dce4ef;border-radius:20rpx;overflow:hidden;background:#fff;box-sizing:border-box}.pk-fixed-labels{width:170rpx;flex:none}.pk-fixed-labels .pk-label{position:static;width:170rpx;line-height:1.5;border-bottom:1rpx solid #e5eaf2;background:#fff}.pk-fixed-labels .pk-head{background:#f3f6fb}.pk-fixed-labels .pk-income{background:#edf3ff}.pk-values-scroll{flex:1;min-width:0;width:0}.pk-values{min-width:100%}.pk-values .pk-line{box-sizing:border-box}.pk-values .pk-cell{padding:25rpx 12rpx;line-height:1.6}.pk-fixed-labels .pk-label:last-child{border-bottom:0}

.pk-period{margin:0 0 20rpx;min-height:88rpx;font-size:27rpx}.pk-caption{font-size:24rpx;margin:18rpx 0 28rpx}.pk-fixed-labels .pk-balance,.pk-balance{background:#f5f8fd}.pk-balance .pk-cell{font-weight:600}.pk-cell.positive{color:#a33736}.pk-cell.negative{color:#176652}.pk-cell.neutral{color:#506078}
.pk-explanation{background:#fff;border:1rpx solid var(--line);border-radius:24rpx;padding:0 24rpx}.pk-disclosure{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%!important;min-height:52px;border:0;border-radius:0;background:transparent;box-shadow:none;text-align:left;font-size:28rpx;color:var(--ink);padding:16rpx 0}.pk-disclosure-end{display:flex;align-items:center;gap:16rpx;color:var(--muted);font-size:25rpx}.pk-notes{padding:12rpx 0 24rpx}.pk-notes>view{margin-bottom:18rpx}
.pk-picker-mask{position:fixed;inset:0;left:0;right:0;top:0;bottom:0;background:rgba(24,44,71,.32);z-index:50;display:flex;align-items:flex-end;justify-content:center}.pk-picker-sheet{width:100%;max-width:900rpx;background:#fff;border-radius:32rpx 32rpx 0 0;padding:28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box}.pk-picker-header{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-bottom:24rpx}.pk-picker-title{font-size:33rpx;font-weight:600}.pk-picker-header text{font-size:25rpx;color:var(--muted)}.pk-picker-close{width:auto!important;min-height:44px;padding:10rpx 16rpx;color:var(--muted);font-size:27rpx;border:0;border-radius:0;background:transparent}.pk-picker-scroll{max-height:50vh}.pk-picker-sheet .pk-chips{margin:0;padding:0;border:0;background:transparent}.pk-picker-sheet .pk-chips button{border-radius:18rpx;white-space:normal}.pk-picker-actions{display:flex;gap:24rpx;align-items:center;margin-top:28rpx}.pk-select-all{width:auto!important;flex:none;padding:12rpx 8rpx;min-height:48px;color:var(--brand);font-size:27rpx;border-radius:0;background:transparent}.pk-picker-actions .primary{width:auto!important;flex:1;min-width:0}
.source-link{display:block;width:100%!important;height:auto;min-height:44px;text-align:left;white-space:normal;word-break:break-all;overflow:visible;border:0;border-bottom:1rpx solid var(--line);border-radius:0;background:transparent;box-shadow:none;padding:22rpx 0;font-size:27rpx;line-height:1.65;color:var(--brand)}.source-link text{display:block;color:var(--muted);font-size:24rpx;margin-top:8rpx}.source-link:last-child{border-bottom:0}

.pk-fixed-labels .pk-label{flex-direction:column;align-items:flex-start;justify-content:center}.pk-label-age{display:block;font-size:24rpx;line-height:1.5;margin-top:8rpx;color:var(--muted);font-weight:400}

/* Totals lead; their components remain visually subordinate. */
.pk-facts{display:flex;flex-wrap:wrap;gap:20rpx 24rpx;padding:22rpx 24rpx;border:1rpx solid var(--line);border-radius:24rpx;background:#fff}.pk-fact{width:calc(50% - 12rpx);min-width:0;font-size:27rpx;line-height:1.55;word-break:break-word}.pk-fact>text{display:block;font-size:24rpx;color:var(--muted)}.pk-fact-wide{width:100%;font-size:25rpx}.pk-fact-wide>text{display:none}.pk-shared{display:flex;flex-wrap:wrap;gap:10rpx 24rpx;margin:20rpx 0;font-size:27rpx;line-height:1.6}.pk-shared>text{color:var(--muted)}.pk-table-intro{font-size:25rpx;color:var(--muted);margin:20rpx 0}.pk-cost{background:#f5f8fd}.pk-cost .pk-cell{font-size:32rpx;font-weight:650;color:var(--ink)}.pk-fixed-labels .pk-cost{background:#f5f8fd;color:var(--ink);font-weight:600}.pk-income .pk-cell{font-size:32rpx}.pk-detail .pk-cell{font-size:28rpx;font-weight:400}.pk-receipt-details{margin:24rpx 0}.pk-receipt-details>.pk-disclosure{border-bottom:1rpx solid var(--line)}.pk-fixed-labels .pk-income{color:var(--brand)}

.pk-fixed-labels,.pk-fixed-labels .pk-label{width:190rpx}.pk-fixed-labels .pk-label{font-size:28rpx;line-height:1.6}.pk-cell{font-size:30rpx}.pk-cost .pk-cell,.pk-income .pk-cell{font-size:34rpx}.pk-detail .pk-cell{font-size:30rpx}.pk-fact{font-size:30rpx}.pk-fact>text{font-size:27rpx}.pk-fact-wide{font-size:27rpx}.pk-caption,.pk-table-intro{font-size:27rpx}
