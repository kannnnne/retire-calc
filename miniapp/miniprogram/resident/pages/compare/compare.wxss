.pk-shell{padding:36rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));max-width:820rpx;margin:auto}.pk-title{font-size:40rpx;font-weight:650;color:#182c47}.pk-sub,.pk-caption{font-size:25rpx;color:#506078;line-height:1.65;margin:16rpx 0 24rpx}.pk-select-label{font-size:29rpx;display:flex;justify-content:space-between;margin:28rpx 0 16rpx}.pk-select-label text{color:#506078;font-size:25rpx}.pk-chips{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:28rpx}.pk-chips button{min-height:48px;font-size:26rpx;background:#fff;border:1rpx solid #dce4ef;padding:16rpx 20rpx;border-radius:20rpx;margin:0;display:flex;align-items:center;gap:8rpx}.pk-chips .chosen{background:#edf3ff;border-color:#2463eb;color:#174ab5}.pk-chips text{font-size:21rpx;color:#506078}.pk-table{background:white;border:1rpx solid #dce4ef;border-radius:20rpx;overflow:hidden;min-width:100%}.pk-table.three{min-width:800rpx}.pk-line{display:flex;border-bottom:1rpx solid #e5eaf2;align-items:stretch}.pk-line:last-child{border-bottom:0}.pk-label{width:170rpx;flex:none;color:#506078;padding:25rpx 15rpx;box-sizing:border-box;font-size:26rpx;display:flex;align-items:center}.pk-cell{flex:1;min-width:0;padding:25rpx 12rpx;text-align:center;font-size:28rpx;line-height:1.6;white-space:pre-line;word-break:break-word;box-sizing:border-box;border-left:1rpx solid #eef1f6}.pk-head{background:#f3f6fb;font-weight:600}.pk-income{background:#edf3ff}.pk-income .pk-cell{color:#174ab5;font-weight:650;font-size:34rpx}.pk-current{display:block;font-size:22rpx;font-weight:400;color:#506078}.pk-period{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;min-height:96rpx}.pk-period picker{color:#245bc1;min-height:48px;display:flex;align-items:center}.pk-link{width:100%;text-align:left;min-height:48px;font-size:27rpx;padding:20rpx 0;color:#245bc1;background:transparent}.pk-notes{font-size:25rpx;line-height:1.75;color:#506078}.pk-notes view{margin-bottom:12rpx}.pk-dock{position:fixed;left:0;right:0;bottom:0;background:#fff;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dce4ef;z-index:10}.pk-dock button{max-width:820rpx;margin:auto}.pk-empty{padding:40rpx 0;color:#506078;font-size:28rpx}.pk-overview{background:white;border-radius:20rpx;padding:12rpx}.pk-over-line{display:flex;align-items:center;width:100%;min-height:48px;font-size:25rpx;text-align:left;background:white}.pk-over-line text{flex:1}.pk-over-line text:last-child{max-width:56rpx}.pk-over-line:first-child{color:#506078}
.pk-chips button{width:calc((100% - 28rpx) / 3);min-width:0;flex:none;flex-direction:column;justify-content:center;padding:10rpx 4rpx;gap:2rpx;line-height:1.35}.pk-scroll{width:100%}

.pk-select-tools{display:flex;align-items:center;gap:16rpx}.pk-select-tools button{min-height:44px;padding:6rpx 20rpx;font-size:26rpx;color:var(--brand);background:#edf3ff;border:1rpx solid #d7e2f3}
.pk-select-label{align-items:center}.pk-label{position:sticky;left:0;background:#fff;z-index:1}.pk-head .pk-label{background:#f3f6fb}.pk-income .pk-label{background:#edf3ff}
.period-select{display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:44px;min-width:210rpx;padding:10rpx 22rpx;box-sizing:border-box;border:1rpx solid #b9c8de;border-radius:18rpx;background:#fff;color:var(--ink)}
.select-chevron{width:12rpx;height:12rpx;border-right:3rpx solid #526984;border-bottom:3rpx solid #526984;transform:rotate(45deg);margin-top:-6rpx;flex:none}
