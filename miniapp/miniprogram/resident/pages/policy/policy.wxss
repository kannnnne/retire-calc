.policy-region{margin:24rpx 0;font-size:32rpx;font-weight:600}.policy-region>view{font-size:26rpx;font-weight:400;color:var(--muted);margin-top:10rpx}.standards-table{border:1rpx solid var(--line);border-radius:20rpx;overflow:hidden;margin-top:24rpx}.standard-row{display:flex;align-items:stretch;border-bottom:1rpx solid var(--line);font-size:29rpx}.standard-row:last-child{border:0}.standard-row>view{flex:1;padding:20rpx 18rpx}.standard-row>view+view{border-left:1rpx solid var(--line)}.table-head{background:#edf4ff;color:#245cb4;font-size:26rpx;font-weight:600}.standard-row text{display:block;font-size:25rpx;color:var(--muted)}.policy-base{font-size:32rpx;color:var(--brand);margin-top:24rpx}.source-link{width:100%!important;text-align:left;min-height:96rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line);color:var(--brand);font-size:28rpx}.source-link text{display:block;font-size:25rpx;color:var(--muted);margin-top:8rpx}
