<import src="../../templates/cost-summary.wxml"/>
<view class="shell {{result && !planning && !quickPlan && !referencePlan && !approvedPlanning && !planIllustration && !recordHelp && !registrationPlan?'result-shell':''}} basic-page {{!result?'has-submit':''}}"><view class="mast"><view class="title">{{editingResult?'修改资料':'养老金计算'}}</view><button wx:if="{{editingResult && !result}}" class="navigation-link return-result" bindtap="cancelResultEdit">返回结果</button><button wx:if="{{!editingResult}}" class="navigation-link" bindtap="home">其他计算 ›</button></view>
<block wx:if="{{!result}}"><view class="card single-form"><view class="card-top"><view class="card-title">先填基本信息</view></view>
<region-picker value="{{form.regionId}}" kind="resident" resident-area="{{form.localArea}}" compact bindchange="regionChoice"/>
<view wx:if="{{region.areas && !region.hideAreaPicker}}" class="basic-row"><text>参保区县</text><picker range="{{areaLabels}}" value="{{areaIndex}}" bindchange="localArea"><view class="control">{{areaLabels[areaIndex]}}</view></picker></view>
<view class="basic-row"><view class="row-label">{{form.ageOnly?'现在年龄':'出生年月'}}</view><view class="basic-entry"><view wx:if="{{form.ageOnly}}" class="input-wrap"><input type="number" value="{{form.age}}" data-key="age" bindinput="input"/><text>岁</text></view><picker wx:else mode="date" fields="month" start="1950-01" end="{{birthEnd}}" value="{{form.birth}}" data-key="birth" bindchange="input"><view class="control">{{form.birth}}</view></picker><button class="age-link" bindtap="ageMode">{{form.ageOnly?'用出生年月':'改填年龄'}}</button></view></view>
<view wx:if="{{region.residenceRequired}}" class="basic-row"><text>参保身份</text><picker range="{{['农村居民','城镇居民']}}" value="{{form.cdResidence==='urban'?1:0}}" bindchange="residence"><view class="control">{{form.cdResidence==='urban'?'城镇居民':'农村居民'}}</view></picker></view>
<view class="basic-row"><text>每年交多少</text><picker wx:if="{{!region.annualInput && !region.continuous}}" range="{{labels}}" value="{{tierIndex}}" bindchange="tier"><view class="control">{{labels[tierIndex]}}</view></picker><view wx:else class="input-wrap"><input type="number" value="{{form.tier}}" data-key="tier" bindinput="input" placeholder="当地可选金额"/><text>元／年</text></view></view>
<view wx:if="{{needsCurrentYearTier}}" class="basic-row"><text>今年可交档次</text><picker range="{{currentLabels}}" value="{{currentIndex}}" bindchange="currentTier"><view class="control">{{currentLabels[currentIndex]}}</view></picker></view><view wx:if="{{needsCurrentYearTier}}" class="hint">当地年度调整期已过，今年按经办确认的档次填，以后按上面所选档次交。</view><view wx:if="{{region.continuous}}" class="hint">当地可选1000—9000元／年。</view><block wx:if="{{region.annualInput}}"><view class="hint">本地档次尚未核齐，请填当地缴费页面的可选金额。</view></block>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view></view><button class="basic-shortcut" bindtap="makeup">以前交过或有漏交？去算补缴 ›</button><view class="submit-dock"><button class="primary" bindtap="calculate">开始计算</button></view></block>
<block wx:else><view class="result-place">{{region.name}}<text>{{region.referenceLabel||'当地参考标准'}}</text><button bindtap="policy">缴费标准 ›</button></view><view class="result-card pension-income"><view wx:if="{{result.autoPlan}}" class="receipt-scope">{{result.autoPlan.title}}</view><view wx:if="{{display.receiptGuide}}" class="receipt-scope">{{display.receiptGuide.label}}</view><view class="pension-label">{{result.chosen.ageIncreaseSummary?'起领时，每月约领':'以后，每月约领'}}</view><view class="pension-value">{{display.monthly}}<text>元</text></view><view class="basic-receipt">{{display.age}}岁起领 · {{display.receipt}}</view><view wx:if="{{display.receiptGuide}}" class="hint">{{display.receiptGuide.text}}</view><view wx:if="{{result.chosen.ageIncreaseSummary}}" class="hint">{{result.chosen.ageIncreaseSummary}} · 现行规则</view><template is="resident-cost-summary" data="{{payback:display.payback}}"/></view>
<button wx:if="{{display.receiptGuide}}" class="basic-shortcut" bindtap="makeup">查看补缴办法 ›</button><button class="compare-entry" bindtap="openTierPK" aria-label="多档缴费对比，查看各档费用与养老金"><view class="compare-copy"><view class="compare-title">多档缴费对比</view><text>每档交多少、领多少，一张表看清</text></view><view class="compare-chevron" aria-hidden="true"/></button><view class="card basic-pay"><view class="card-top"><view class="card-title">这样交</view><button class="info-trigger" bindtap="paymentInfo" aria-label="查看缴费说明">?</button></view><view wx:if="{{display.immediate}}" class="pay-line"><text>现在补{{result.makeup.addedYears}}年</text><view>{{display.immediate}}元</view></view><view wx:if="{{display.years}}" class="pay-line"><text>每年交</text><view>{{display.annual}}元 × {{display.years}}年</view></view><view wx:if="{{display.years}}" class="hint">{{display.first===display.last?display.first:display.first+'—'+display.last}}年</view><view wx:if="{{display.lumpYears}}" class="pay-line"><text>{{display.lumpAge}}岁时补</text><view>{{display.lumpCost}}元</view></view><view wx:if="{{display.lumpYears}}" class="hint">补{{display.lumpYears}}年</view></view>
<button wx:if="{{!display.receiptGuide}}" class="basic-shortcut" bindtap="makeup">{{result.autoPlan?'按实际记录调整 ›':'想比较补缴办法？带资料去算 ›'}}</button><button wx:if="{{details && region.rule==='GUANGXI_ORDINARY'}}" class="text-button" bindtap="toggleAutoMakeup">{{form.makeupStrategy==='ANNUAL_ONLY'?'按政策自动补足':'不补往年，只逐年交'}}</button><button class="fold" bindtap="details">计算说明<text>{{details?'收起 −':'展开 ＋'}}</text></button><view wx:if="{{details}}" class="hint">按尚未参保、从今年开始缴费计算。需累计交{{display.required}}年，基础额按现有标准，未来调整和利息未计。<view wx:for="{{result.warnings}}" wx:key="*this">{{item}}</view></view></block><view wx:if="{{result && !planning && !quickPlan && !referencePlan && !approvedPlanning && !planIllustration && !recordHelp && !registrationPlan}}" class="result-tools"><view class="result-action-row"><button class="secondary result-edit" bindtap="beginResultEdit"><image class="action-glyph" src="{{resultEditIcon}}" mode="aspectFit" aria-hidden="true"/>修改资料</button><button class="primary result-save" bindtap="openShareCard">保存／分享方案</button></view></view></view><tool-nav active="resident" resident-hub/>
