<view class="shell has-submit basic-page"><view class="mast"><view class="title">养老金计算</view><button class="text-button" bindtap="home">其他计算 ›</button></view>
<block wx:if="{{!result}}"><view class="card single-form"><view class="card-top"><view class="card-title">从现在开始交</view></view>
<region-picker value="{{form.regionId}}" kind="resident" resident-area="{{form.localArea}}" compact bindchange="regionChoice"/>
<view wx:if="{{region.areas && !region.hideAreaPicker}}" class="basic-row"><text>参保区县</text><picker range="{{areaLabels}}" value="{{areaIndex}}" bindchange="localArea"><view class="control">{{areaLabels[areaIndex]}}</view></picker></view>
<view class="basic-row"><view class="row-label">{{form.ageOnly?'现在年龄':'出生年月'}}</view><view class="basic-entry"><view wx:if="{{form.ageOnly}}" class="input-wrap"><input type="number" value="{{form.age}}" data-key="age" bindinput="input"/><text>岁</text></view><picker wx:else mode="date" fields="month" start="1950-01" end="{{birthEnd}}" value="{{form.birth}}" data-key="birth" bindchange="input"><view class="control">{{form.birth}}</view></picker><button class="age-link" bindtap="ageMode">{{form.ageOnly?'用出生年月':'改填年龄'}}</button></view></view>
<view wx:if="{{region.residenceRequired}}" class="basic-row"><text>参保身份</text><picker range="{{['农村居民','城镇居民']}}" value="{{form.cdResidence==='urban'?1:0}}" bindchange="residence"><view class="control">{{form.cdResidence==='urban'?'城镇居民':'农村居民'}}</view></picker></view>
<view class="basic-row"><text>每年交多少</text><picker wx:if="{{!region.annualInput && !region.continuous}}" range="{{labels}}" value="{{tierIndex}}" bindchange="tier"><view class="control">{{labels[tierIndex]}}</view></picker><view wx:else class="input-wrap"><input type="number" value="{{form.tier}}" data-key="tier" bindinput="input" placeholder="当地可选金额"/><text>元／年</text></view></view>
<view wx:if="{{needsCurrentYearTier}}" class="basic-row"><text>今年可交档次</text><picker range="{{currentLabels}}" value="{{currentIndex}}" bindchange="currentTier"><view class="control">{{currentLabels[currentIndex]}}</view></picker></view><view wx:if="{{needsCurrentYearTier}}" class="hint">当地年度调整期已过，今年按经办确认的档次填，以后按上面所选档次交。</view><view wx:if="{{region.continuous}}" class="hint">当地可选1000—9000元／年。</view><block wx:if="{{region.annualInput}}"><view class="hint">本地档次尚未核齐，请填当地缴费页面的可选金额。</view><checkbox-group bindchange="confirmLocal"><label class="local-check"><checkbox value="yes" checked="{{form.localAnnualConfirmed==='yes'}}"/>这个金额在当地可以交</label></checkbox-group></block>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view></view><button class="basic-shortcut" bindtap="makeup">以前交过或有漏交？去算补缴 ›</button><view class="submit-dock"><button class="primary" bindtap="calculate">开始计算</button></view></block>
<block wx:else><view class="result-place">{{region.name}}<text>{{region.referenceLabel||'当地参考标准'}}</text><button bindtap="policy">缴费标准 ›</button></view><view class="result-card pension-income"><view class="pension-label">以后，每月约领</view><view class="pension-value">{{display.monthly}}<text>元</text></view><view class="basic-receipt">{{display.age}}岁起领 · {{display.receipt}}</view><button class="resident-payback" bindtap="recoveryInfo"><text>领多久回本 ⓘ</text><text>{{display.payback.text}}</text></button></view>
<view class="card basic-pay"><view class="card-top"><view class="card-title">这样交</view><button class="info-trigger" bindtap="paymentInfo" aria-label="查看缴费说明">!</button></view><view wx:if="{{display.years}}" class="pay-line"><text>每年交</text><view>{{display.annual}}元 × {{display.years}}年</view></view><view wx:if="{{display.years}}" class="hint">{{display.first}}—{{display.last}}年</view><view wx:if="{{display.lumpYears}}" class="pay-line"><text>{{display.lumpAge}}岁时补</text><view>{{display.lumpCost}}元</view></view><view wx:if="{{display.lumpYears}}" class="hint">补{{display.lumpYears}}年</view><view class="total-row"><text>还需交</text><text>{{display.total}}元</text></view></view>
<button class="basic-shortcut" bindtap="makeup">想比较补缴办法？带资料去算 ›</button><button class="fold" bindtap="details">计算说明<text>{{details?'收起 −':'展开 ＋'}}</text></button><view wx:if="{{details}}" class="hint">按尚未参保、从今年开始缴费计算。需累计交{{display.required}}年，基础额按现有标准，未来调整和利息未计。<view wx:for="{{result.warnings}}" wx:key="*this">{{item}}</view></view><view class="submit-dock"><view class="result-actions"><button class="secondary restart-button" bindtap="reset">重新填写</button><button class="primary" bindtap="edit">修改信息</button></view></view></block></view><tool-nav active="resident" resident-hub/>
