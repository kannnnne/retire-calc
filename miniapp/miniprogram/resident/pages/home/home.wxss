.entry-intro{font-size:30rpx;color:var(--muted);margin:12rpx 0 28rpx}.module-card{width:100%!important;display:flex;align-items:center;gap:24rpx;text-align:left;min-height:208rpx;padding:30rpx 24rpx;background:#fff;border:1rpx solid var(--line);border-radius:20rpx;margin-bottom:24rpx}.module-number{width:72rpx;height:72rpx;flex:none;border-radius:18rpx;background:#edf4ff;color:var(--brand);display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:600}.module-content{flex:1;min-width:0}.module-title{font-size:34rpx;font-weight:600;margin-bottom:12rpx}.module-content text{font-size:28rpx;color:var(--muted);line-height:1.65}.module-arrow{color:var(--brand);font-size:44rpx;flex:none}
