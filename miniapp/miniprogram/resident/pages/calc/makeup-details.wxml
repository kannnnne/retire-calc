<block wx:if="{{more}}"><block wx:if="{{!form.never}}"><view wx:if="{{form.historyUncertain}}" class="hint">查到记录后，改选“记得清”再填写账户余额或分年记录。</view><view class="entry-row"><text class="row-label">个人账户</text><picker class="row-picker" range="{{['按缴费估算','填查询金额']}}" value="{{form.accountMode==='balance'?1:0}}" bindchange="accountPicker"><view class="control">{{form.accountMode==='balance'?'填查询金额':'按缴费估算'}}</view></picker></view><block wx:if="{{form.accountMode==='balance'}}"><view class="entry-row"><text class="row-label">账户储存额</text><view class="row-entry input-wrap"><input type="digit" value="{{form.balance}}" data-key="balance" bindinput="input" placeholder="查询金额，含补贴利息"/><text>元</text></view></view><view wx:if="{{region.residenceRequired}}" class="entry-row"><text class="row-label">以前每年自己交</text><view class="row-entry input-wrap"><input type="digit" value="{{form.pastAnnual}}" data-key="pastAnnual" bindinput="input" placeholder="用于推算基础养老金"/><text>元</text></view></view></block><block wx:if="{{form.accountMode!=='balance'}}"><button class="fold history-options" data-key="showHistory" bindtap="fold">{{form.historyMode==='segments'?'分段填写历史缴费':'历史缴费明细（选填）'}}<text>{{showHistory?'收起':'展开'}}</text></button><block wx:if="{{showHistory || form.historyMode==='segments'}}"><view class="segment"><button class="{{form.historyMode!=='segments'?'selected':''}}" data-value="simple" bindtap="historyMode">平均金额</button><button class="{{form.historyMode==='segments'?'selected':''}}" data-value="segments" bindtap="historyMode">分段填写</button></view><picker wx:if="{{form.historyMode!=='segments'}}" range="{{['每年缴费','以前按月缴费']}}" value="{{form.pastMonthly?1:0}}" bindchange="pastPeriod"><view class="control">{{form.pastMonthly?'按月填写，自动乘12':'按年填写'}}</view></picker><view wx:if="{{!form.never && form.historyMode==='segments'}}" class="field"><view class="hint">只填实际缴过的年份；每段视为连续已缴，漏缴年度拆成两段。合计须与已缴年限一致。</view><view class="plan-row" wx:for="{{form.segments}}" wx:key="index"><input class="control" type="number" value="{{item.start}}" data-index="{{index}}" data-key="start" bindinput="segmentInput" placeholder="开始年份，例如2015"/><input class="control" type="number" value="{{item.end}}" data-index="{{index}}" data-key="end" bindinput="segmentInput" placeholder="结束年份，例如2019"/><input class="control" type="digit" value="{{item.annual}}" data-index="{{index}}" data-key="annual" bindinput="segmentInput" placeholder="该段每年本人交多少元"/><button class="text-button" data-index="{{index}}" bindtap="removeSegment">删除这段</button></view><button class="tutorial" bindtap="addSegment">＋ 增加历史阶段</button></view></block></block></block></block>
