<view class="segment-record plan-row" wx:for="{{segmentRows}}" wx:key="index"><view class="segment-year-grid"><picker range="{{item.startLabels}}" value="{{item.startIndex}}" data-index="{{index}}" data-key="start" bindchange="segmentYear"><view class="control">{{item.startLabels[item.startIndex]}}</view></picker><picker range="{{item.endLabels}}" value="{{item.endIndex}}" data-index="{{index}}" data-key="end" bindchange="segmentYear"><view class="control">{{item.endLabels[item.endIndex]}}</view></picker></view><view class="entry-row"><text class="row-label">每年交</text><picker class="row-entry" range="{{item.tierLabels}}" value="{{item.tierIndex}}" data-index="{{index}}" bindchange="segmentTier"><view class="control">{{item.manual?'自己填写':item.annual?item.annual+'元／年':'选择金额'}}</view></picker></view><view wx:if="{{!item.historical && item.tiers.length}}" class="hint">现行档次供参考，旧年金额可手填。</view><view wx:if="{{item.manual}}" class="entry-row"><text class="row-label">实际金额</text><view class="input-wrap row-entry"><input type="digit" value="{{item.annual}}" data-index="{{index}}" data-key="annual" bindinput="segmentInput"/><text>元／年</text></view></view><button class="text-button" data-index="{{index}}" bindtap="removeSegment">删除这段</button></view>