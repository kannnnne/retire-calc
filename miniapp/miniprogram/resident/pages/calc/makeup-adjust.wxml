<view wx:if="{{quickPlan.details}}" class="quick-adjust"><view class="entry-row"><text class="row-label">补缴年档</text><picker class="row-entry" range="{{quickPlan.uniformLabels}}" value="{{quickPlan.manualTier?quickPlan.uniformLabels.length-1:quickPlan.uniformIndex}}" bindchange="selectQuickUniform"><view class="control">{{quickPlan.manualTier?'自己填写':quickPlan.tier+'元／年'}}</view></picker></view><view wx:if="{{quickPlan.manualTier}}" class="entry-row"><text class="row-label">填写年档</text><view class="row-entry input-wrap"><input type="number" value="{{quickPlan.tierInput}}" bindinput="quickTierInput" bindconfirm="updateQuickDetails" confirm-type="done"/><text>元</text><button class="text-button" bindtap="updateQuickDetails">更新</button></view></view><view class="hint">统一换档会重配下面各年；旧年封顶、已交较高档的保持不变。</view><view wx:if="{{quickPlan.summary.normalYears}}" class="entry-row"><text class="row-label">{{quickPlan.summary.currentCost!=='0.00'?'今年及以后年缴':'以后每年交'}}</text><picker class="row-entry" range="{{quickPlan.tierLabels}}" value="{{quickPlan.futureIndex}}" bindchange="selectQuickFuture"><view class="control">{{quickPlan.futureTier}}元／年</view></picker></view><view wx:for="{{quickPlan.draft.editable}}" wx:key="year" class="entry-row"><view class="row-label">{{item.year}}年<text class="year-origin">{{item.original?'原已交'+item.original+'元':'漏交的年份'}}</text></view><picker class="row-entry" range="{{item.labels}}" value="{{item.index}}" data-year="{{item.year}}" bindchange="selectQuickTarget"><view class="control">{{item.target}}元</view></picker></view><view class="hint">已交的只补差额。</view><button class="primary confirm-plan" bindtap="updateQuickDetails" disabled="{{!quickPlan.dirty}}">更新方案</button></view>
