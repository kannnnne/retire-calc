<view class="shell {{region.status!=='PENDING'?'has-submit':''}}"><view class="mast"><view class="title">居民养老</view></view>
<view wx:if="{{!result}}" class="location-panel"><view class="region-row"><picker range="{{provinces}}" value="{{provinceIndex}}" bindchange="selectProvince"><view class="control">{{provinces[provinceIndex]}}</view></picker><picker range="{{cities}}" value="{{cityIndex}}" bindchange="selectCity"><view class="control">{{cities[cityIndex]}}</view></picker></view><picker wx:if="{{districts.length}}" range="{{districts}}" value="{{districtIndex}}" bindchange="selectDistrict"><view class="control">{{districts[districtIndex]}}</view></picker><button wx:if="{{region.status!=='PENDING'}}" class="text-button" bindtap="sources">政策文件 ⓘ</button></view>
<block wx:if="{{region.status!=='PENDING'}}"><block wx:if="{{!result}}"><view class="card single-form"><view class="card-top"><view class="card-title">参保信息</view><button class="text-button" bindtap="reset">恢复默认</button></view>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<view class="entry-row age-entry"><text class="row-label">{{form.ageOnly?'周岁年龄':'出生年月'}}</text><view class="row-entry"><view wx:if="{{form.ageOnly}}" class="input-wrap"><input type="number" value="{{form.age}}" data-key="age" bindinput="input" placeholder="输入年龄"/><text>岁</text></view><picker wx:else mode="date" fields="month" value="{{form.birth}}" data-key="birth" bindchange="input"><view class="control">{{form.birth||'请选择'}}</view></picker></view><button class="age-mode-button" data-value="{{form.ageOnly?'birth':'age'}}" bindtap="ageMode">{{form.ageOnly?'用出生年月':'改填年龄'}}</button></view>
<view class="entry-row"><text class="row-label">以前缴过吗</text><view class="segment row-entry"><button class="{{form.never?'selected':''}}" data-value="never" bindtap="history">没交过</button><button class="{{!form.never?'selected':''}}" data-value="paid" bindtap="history">交过</button></view></view>
<block wx:if="{{!form.never}}"><view class="entry-row"><text class="row-label">计算方式</text><picker class="row-picker" range="{{['按历年缴费估算','用已知账户余额']}}" value="{{form.accountMode==='balance'?1:0}}" bindchange="accountPicker"><view class="control">{{form.accountMode==='balance'?'已知账户余额':'历年缴费估算'}}</view></picker></view><view class="entry-row"><text class="row-label">已缴年数</text><view class="row-entry input-wrap"><input type="number" value="{{form.years}}" data-key="years" bindinput="input" placeholder="实际缴过几年"/><text>年</text></view></view><block wx:if="{{form.accountMode==='balance'}}"><view class="entry-row"><text class="row-label">账户储存额</text><view class="row-entry input-wrap"><input type="digit" value="{{form.balance}}" data-key="balance" bindinput="input" placeholder="查询金额，含补贴利息"/><text>元</text></view></view></block><block wx:else><view wx:if="{{form.historyMode!=='segments'}}" class="entry-row"><text class="row-label">{{form.pastMonthly?'每月自己交':'每年自己交'}}</text><view class="row-entry input-wrap"><input type="digit" value="{{form.pastAnnual}}" data-key="pastAnnual" bindinput="input" placeholder="按实际填写，例如300"/><text>元</text></view></view><button class="fold history-options" data-key="showHistory" bindtap="fold">{{form.historyMode==='segments'?'分段填写历史缴费':'历史缴费明细（选填）'}}<text>{{showHistory?'收起':'展开'}}</text></button><block wx:if="{{showHistory || form.historyMode==='segments'}}"><view class="segment"><button class="{{form.historyMode!=='segments'?'selected':''}}" data-value="simple" bindtap="historyMode">平均金额</button><button class="{{form.historyMode==='segments'?'selected':''}}" data-value="segments" bindtap="historyMode">分段填写</button></view><picker wx:if="{{form.historyMode!=='segments'}}" range="{{['每年缴费','以前按月缴费']}}" value="{{form.pastMonthly?1:0}}" bindchange="pastPeriod"><view class="control">{{form.pastMonthly?'按月填写，自动乘12':'按年填写'}}</view></picker><view wx:if="{{!form.never && form.historyMode==='segments'}}" class="field"><view class="hint">只填实际缴过的年份；每段视为连续已缴，漏缴年度拆成两段。合计须与已缴年限一致。</view><view class="plan-row" wx:for="{{form.segments}}" wx:key="index"><input class="control" type="number" value="{{item.start}}" data-index="{{index}}" data-key="start" bindinput="segmentInput" placeholder="开始年份，例如2015"/><input class="control" type="number" value="{{item.end}}" data-index="{{index}}" data-key="end" bindinput="segmentInput" placeholder="结束年份，例如2019"/><input class="control" type="digit" value="{{item.annual}}" data-index="{{index}}" data-key="annual" bindinput="segmentInput" placeholder="该段每年本人交多少元"/><button class="text-button" data-index="{{index}}" bindtap="removeSegment">删除这段</button></view><button class="tutorial" bindtap="addSegment">＋ 增加历史阶段</button></view></block></block>
<view class="entry-row"><text class="row-label">今年缴费</text><view class="segment row-entry"><button class="{{form.paidThisYear==='no'?'selected':''}}" data-key="paidThisYear" data-value="no" bindtap="choice">未缴</button><button class="{{form.paidThisYear==='yes'?'selected':''}}" data-key="paidThisYear" data-value="yes" bindtap="choice">已含在年数中</button></view></view></block>
<view class="entry-row"><text class="row-label">以后每年交</text><picker class="row-entry" range="{{tierLabels}}" value="{{tierIndex}}" bindchange="tier"><view class="control">{{form.tier}} 元／年</view></picker></view>
<button class="fold settings-fold" bindtap="toggle">更多设置<text>{{more?'收起 −':'选填 ＋'}}</text></button><block wx:if="{{more}}"><view class="field"><text>数据截至月份</text><picker mode="date" fields="month" value="{{form.asOf}}" data-key="asOf" bindchange="input"><view class="control">{{form.asOf}}</view></picker></view><view class="field"><text>一次性缴费预算（选填）</text><input class="control" type="digit" value="{{form.budget}}" data-key="budget" bindinput="input" placeholder="留空不限制一次性预算"/></view><view class="field"><text>已享受政府补贴合计（未知留空）</text><input class="control" type="digit" value="{{form.usedSubsidy}}" data-key="usedSubsidy" bindinput="input" placeholder="未知时后续补贴保守按0"/></view></block>
<view wx:if="{{needsTransition || needsExtended}}" class="policy-checks">
 <view class="policy-check-title">这类情况需先向街镇核对</view>
 <view wx:if="{{needsTransition}}" class="field"><view class="hint">你可能符合老参保人的特殊领取办法，不能直接按普通办法计算。</view><button class="policy-confirm {{form.transition==='no'?'confirmed':''}}" data-key="transition" data-value="{{form.transition==='no'?'unknown':'no'}}" bindtap="choice">{{form.transition==='no'?'✓ 已核对，按普通办法算':'我已核对，按普通办法算'}}</button></view>
 <view wx:if="{{needsExtended}}" class="field"><view class="hint">已满65岁但没交够15年，需确认能否补足。</view><button class="policy-confirm {{form.extended==='yes'?'confirmed':''}}" data-key="extended" data-value="{{form.extended==='yes'?'unknown':'yes'}}" bindtap="choice">{{form.extended==='yes'?'✓ 已核对，可按延缴办法补足':'我已核对，可按延缴办法补足'}}</button></view>
</view>
<view class="eligibility-row"><button class="eligibility-check {{form.eligible==='yes'?'checked':''}}" data-key="eligible" data-value="{{form.eligible==='yes'?'unknown':'yes'}}" bindtap="choice"><text>{{form.eligible==='yes'?'✓':'○'}}</text>我符合参保条件</button><button class="condition-link" bindtap="eligibilityInfo">查看条件</button></view><view class="submit-dock"><button class="primary calculate-button" bindtap="calculate">开始计算</button></view></view></block><block wx:else>
<view class="income-tile">
 <view class="receive-badge">{{result.chosen.timeline.receivingAge}}岁起领 · {{result.chosen.receiptYear}}年</view>
 <view class="income-label">退休后，每月约领</view>
 <view class="income-number">{{display.monthly}}<text>元</text></view>
</view>
<view class="card payment-tile">
 <view class="payment-label">{{result.missing?'还要交':'不用再交'}}</view>
 <view class="remaining-number">{{display.total}}<text>元</text></view>
 <view wx:if="{{result.missing}}" class="payment-parts">
  <view wx:if="{{result.chosen.timeline.normalYears}}" class="payment-part"><view class="part-label">以后每年交</view><view class="part-number">{{result.chosen.annualTotal}}<text>元</text></view><view class="part-duration">× {{result.chosen.timeline.normalYears}}年</view><view class="part-date">{{result.chosen.timeline.firstYear}}—{{result.chosen.timeline.lastYear}}</view></view>
  <view wx:if="{{result.chosen.timeline.normalYears && result.chosen.lumpYears}}" class="part-plus">＋</view>
  <view wx:if="{{result.chosen.lumpYears}}" class="payment-part"><view class="part-label">{{result.chosen.timeline.lumpAge}}岁时补</view><view class="part-number">{{display.lump}}<text>元</text></view><view class="part-duration">补{{result.chosen.lumpYears}}年 · 同档暂算</view><view class="part-date">{{result.chosen.receiptYear}}年</view></view>
 </view>
 <view wx:else class="completed-label">已交够，{{result.age>=60?'可办理领取':'到60岁办理领取'}}</view>
 <view wx:if="{{!result.chosen.affordable}}" class="error">一次补缴超预算{{result.chosen.shortfall}}元</view>
</view>
<view class="submit-dock result-dock"><view class="result-actions"><button class="secondary restart-button" bindtap="reset">重新填写</button><button class="primary" bindtap="edit">修改信息</button></view></view>
<view class="card future-plans">
 <button class="section-trigger future-trigger" data-key="compare" bindtap="fold"><view><view class="section-title">想多领？调整以后怎么交</view><view class="trigger-sub">{{compare?'点击方案，更新上面的结果':'查看可选方案'}}</view></view><text class="expand-mark">{{compare?'−':'＋'}}</text></button>
 <view wx:if="{{compare}}" class="section-body">
  <view class="fixed-history">以前交的{{result.paidYears}}年不变，只选以后怎么交</view>
  <view wx:if="{{result.chosen.selfCollective}}" class="active-extra">已包含每年额外交{{result.chosen.selfCollective}}元</view>
  <view wx:if="{{!result.chosen.timeline.normalYears}}" class="notice-box">没有待缴的正常年度。本页不把过去缴费改成高档；到龄补缴的可选档须先向经办核定。</view>
  <block wx:else>
   <view class="option-heading">退休后，每月约领多少？<text>7档可选</text></view>
   <view class="income-options">
    <button wx:for="{{planOptions}}" wx:key="annual" class="income-choice {{item.annual===result.chosen.annual?'chosen-option':''}}" data-annual="{{item.annual}}" bindtap="chooseFuture" aria-label="每月约{{item.monthly}}元，{{item.annual===result.chosen.annual?'已选':'点击选择'}}"><view class="choice-number"><text class="approx">约</text>{{item.monthly}}<text>元／月</text></view><view class="choice-state">{{item.annual===result.chosen.annual?'✓ 已选':'选择'}}</view></button>
   </view>
   <button class="extra-toggle" data-key="extraOpen" bindtap="fold">其他增额方式（选填）<text>{{extraOpen?'收起 −':'展开 ＋'}}</text></button>
   <view wx:if="{{extraOpen}}" class="extra-options">
    <view class="hint">村集体没有给你补助时，才可选这一项。</view>
    <button class="collective-check" bindtap="toggleCollective">{{form.noCollective==='yes'?'☑':'□'}} 我确认没有村集体补助，想额外交费</button>
    <picker wx:if="{{form.noCollective==='yes'}}" range="{{['不加交','另外360元／年','另外600元／年','另外900元／年','另外1200元／年','另外1800元／年','另外3600元／年','另外4800元／年']}}" value="{{collectiveIndex||0}}" bindchange="collectiveTier"><view class="control">以后每年额外交：{{form.selfCollectiveTier||0}}元</view></picker>
    <view class="hint">这笔钱也由你承担，属于自费集体档；只加到以后每年缴费，不补以前的年份，也不加入到龄补缴。</view>
   </view>
  </block>
 </view>
</view>
<view class="card policy-choices"><button class="section-trigger" data-key="policyOpen" bindtap="fold"><view class="section-title">过去交低了，还能补差吗？</view><text class="expand-mark">{{policyOpen?'−':'＋'}}</text></button><view wx:if="{{policyOpen}}" class="section-body">
 <view class="policy-item"><view class="policy-heading">以后换高档 <text class="policy-status">可以</text></view><view class="hint">按年度选档，不要求一直沿用以前360元。今年已缴的，调整从下一缴费年度开始。</view></view>
 <view class="policy-item"><view class="policy-heading">把过去低档补成高档 <text class="policy-status muted-status">暂不支持</text></view><view class="hint">过去低档补成高档的办理期已在2022年底结束。目前没查到重新开放的通知，暂时不能按补十几万来计算。</view></view>
 <view class="policy-item"><view class="policy-heading">65岁补不足的年数 <text class="policy-status">有条件</text></view><view class="hint">普通人延缴到65岁仍不足15年才可补足。这是补年数，不是把过去已交的年份提档；补缴不享政府补贴。能选哪些补缴档，请向户籍街镇确认。</view></view>
 <view class="policy-item"><view class="policy-heading">自己承担集体补助档 <text class="policy-status">有条件</text></view><view class="hint">村集体没有给予补助时，可以另选集体补助档自己交。本页只计算今后正常年缴，补缴、已交年度补差不自动加入。</view></view>
 <button class="tutorial" data-url="https://www.gzns.gov.cn/zwgk/tzgg/content/post_8719039.html" bindtap="policyDocument">历史提档什么时候截止？查看文件 ›</button>
 <button class="tutorial" data-url="https://www.gz.gov.cn/gfxwj/szfgfxwj/gzsrmzfbgt/content/post_7304595.html" bindtap="policyDocument">缴费档次和补缴条件 · 查看文件 ›</button>
</view></view>
<view class="card compact-folds"><button class="section-trigger" data-key="showNotes" bindtap="fold"><view class="section-title">缴费记录与计算详情</view><text class="expand-mark">{{showNotes?'−':'＋'}}</text></button><view wx:if="{{showNotes}}" class="section-body">
 <view class="detail-group"><view class="option-heading">已交情况</view><view>已交{{result.paidYears}}年 · 还差{{result.missing}}年</view><view wx:if="{{result.pastPaid!==null}}">以前自己交了约{{result.pastPaid}}元</view></view>
 <view class="detail-group"><view class="option-heading">这份方案</view><view>退休后每月约领：{{display.monthly}}元（取整显示）</view><view>正常年缴：个人{{result.chosen.annual}}元＋自费集体档{{result.chosen.selfCollective}}元／年</view><view>到龄补缴：{{result.chosen.lumpYears}}年×个人{{result.chosen.annual}}元档（暂按此档计算，办理时确认）</view><view>领取后约{{result.chosen.recoveryYearsFast}}～{{result.chosen.recoveryYearsSlow}}年，能领回以后交的这笔钱。计算包含以前积累的账户金额，没有算等待领取的时间和这笔钱的利息。</view></view>
 <view class="detail-group"><view class="option-heading">逐年费用</view><view wx:for="{{result.chosen.schedule}}" wx:key="year" class="schedule-item">{{item.year}}年：{{item.cost}}元（{{item.years}}年）</view></view>
 <view class="detail-group"><view class="option-heading">怎么算的</view><view class="hint">基础养老金沿用{{result.baseYear}}年标准；利息为0，假设未来规则不变。当前办法有效至2028年5月。年度缴费截止及起付月份需向户籍街镇确认。</view><view class="hint" wx:for="{{result.warnings}}" wx:key="*this">{{item}}</view></view>
 <button wx:for="{{result.sources}}" wx:key="url" class="tutorial" data-url="{{item.url}}" bindtap="policyDocument">{{item.name}} ›</button>
</view></view>
<view class="bill-disclaimer">金额供参考，以实际核定为准。</view>
</block></block><view wx:if="{{region.status==='PENDING'}}" class="card pending-card"><view class="pending-title">该地区暂未开放</view><view class="hint">整理好当地政策后再开放，这里不能用广州的标准计算。</view></view></view><tool-nav active="resident"/>

