<view class="shell {{region.status!=='PENDING'?'has-submit':''}}"><view class="mast"><view class="title">{{moduleMode?'补缴／断缴':'居民养老'}}</view><button wx:if="{{moduleMode}}" class="text-button" bindtap="basicModule">养老金计算 ›</button></view>
<region-picker wx:if="{{!moduleMode}}" value="{{form.regionId}}" kind="resident" resident-area="{{form.localArea}}" bindchange="regionChoice"/>
<block wx:if="{{recordHelp}}"><view class="card record-help">
 <view class="card-top"><view class="card-title">{{form.never?'先确认怎么参保':'先把记录查清楚'}}</view><button class="text-button" bindtap="closeRecordHelp">返回</button></view>
 <view class="lookup-region">{{region.name}} · 居民养老</view><view class="lookup-lead">到参保地村委、乡镇社保窗口或当地社保经办窗口，把下面三句话给工作人员看。</view>
 <view class="lookup-question"><text>1</text><view>{{form.never?'我还没参加，可以登记参保吗？':'我已经交了哪几年？'}}<text>{{form.never?'请帮我确认登记条件和所需材料。':'请帮我查缴费记录和账户余额。'}}</text></view></view>
 <view class="lookup-question"><text>2</text><view>{{form.never?'我这类情况有没有补缴办法？':'以前没交的，哪些年能补？'}}<text>{{form.never?'需要哪些条件、允许补哪些年？':'每年能补多少钱，一共要交多少？'}}</text></view></view>
 <view class="lookup-question"><text>3</text><view>按我的记录，补完何时能领？<text>还需不需要接着交，什么时候前办？</text></view></view>
 <view class="lookup-note">先查记录，不用急着交钱。能不能补、能补哪些年，由工作人员按你的情况核对。</view>
 <button wx:if="{{!form.never}}" class="primary" bindtap="recordsReady">查到记录了，按记录填写</button><button class="secondary" bindtap="closeRecordHelp">先返回看大概</button>
</view></block><block wx:else>

<block wx:if="{{registrationPlan}}"><view class="card single-form"><view class="card-top"><view class="card-title">还没参保，先选下一步</view><button class="text-button" bindtap="closeRegistrationPlan">{{result?'返回结果':'返回填写'}}</button></view><view class="hint">先登记，再选正常缴费档。满60岁不等于能直接补足，能补哪些年需经办核定。</view><button class="registration-choice" bindtap="registrationAnnual"><view>先看从现在每年交</view><text>选个档次，看看每月能领多少、要交多久 ›</text></button><button class="registration-choice" bindtap="registrationQuestions"><view>先问能不能补</view><text>带着这几句话去村委或社保窗口核对 ›</text></button></view></block><block wx:elif="{{referencePlan}}"><view class="card single-form"><view class="card-top"><view class="card-title">先看补缴大概花多少</view><button class="text-button" bindtap="closeReferencePlan">返回原结果</button></view><button class="quiet-info" bindtap="resultInfo">补缴参考 ⓘ</button><view class="form-section-title">选一个每月领取金额</view><view class="income-choices"><button wx:for="{{referencePlan.options}}" wx:key="tier" class="income-choice {{(referencePlan.pendingTier===null || referencePlan.pendingTier===undefined?referencePlan.tier:referencePlan.pendingTier)===item.tier?'active':''}}" data-tier="{{item.tier}}" bindtap="selectReference"><view>约 <text>{{item.monthly}}</text> 元／月</view><view class="choice-note">年档参考 {{item.tier}}元{{(referencePlan.pendingTier===null || referencePlan.pendingTier===undefined?referencePlan.tier:referencePlan.pendingTier)===item.tier?' · 已选':''}}</view></button></view><button class="primary confirm-plan" bindtap="confirmReference" disabled="{{referencePlan.pendingTier===null || referencePlan.pendingTier===undefined}}">按所选方案计算</button><view class="quick-income"><view class="pension-start">{{referencePlan.selected.added?'假设可补后':'按以后每年交'}} · {{referencePlan.selected.receipt}}起领参考</view><view class="pension-label">每月约领</view><view class="pension-value">{{referencePlan.selected.monthly}}<text>元</text></view><button class="resident-payback" bindtap="recoveryInfo"><text>领多久回本 ⓘ</text><text>{{referencePlan.selected.payback.text}}</text></button></view><view class="payment-grid"><view>现在需交<text>{{referencePlan.selected.nowCost}}元</text><view wx:if="{{referencePlan.selected.currentCost!=='0.00'}}" class="payment-detail">补以前的{{referencePlan.selected.historyCost}}元<view></view>今年正常交{{referencePlan.selected.currentCost}}元</view><view wx:else class="payment-detail">{{referencePlan.selected.added?'假设可补'+referencePlan.selected.added+'年':'不补以前的'}}</view></view><view wx:if="{{referencePlan.selected.laterYears}}">以后每年交<text>{{referencePlan.selected.laterAnnual}}元</text><view class="payment-detail">共{{referencePlan.selected.laterYears}}年 · {{referencePlan.selected.laterFirstYear}}—{{referencePlan.selected.laterLastYear}}</view></view></view><view class="total-row"><text>还需交</text><text>{{referencePlan.selected.total}}元</text></view><button class="primary" bindtap="referenceRecords">核对记录，再填实际方案</button><button class="secondary" bindtap="closeReferencePlan">返回原结果</button></view></block><block wx:elif="{{quickPlan}}"><block wx:if="{{moduleMode}}"><include src="makeup-preview.wxml"/></block><block wx:else><view class="card single-form quick-plan"><view class="card-top"><view class="card-title">{{quickPlan.enough?'年数已够，比较提档':'补缴方案'}}</view><button class="text-button" bindtap="cancelMaxPlan">返回</button></view>
<view wx:if="{{quickPlan.canChooseTiming}}" class="segment"><button class="{{(quickPlan.pendingMode||quickPlan.mode)==='TO_SIXTY'?'selected':''}}" data-mode="TO_SIXTY" bindtap="selectQuickMode">到60岁交够15年</button><button class="{{(quickPlan.pendingMode||quickPlan.mode)==='NOW'?'selected':''}}" data-mode="NOW" bindtap="selectQuickMode">现在补够15年</button></view>
<view wx:if="{{quickPlan.enough}}" class="hint">已交够15年，不用再补年数。选高档只是比较提高月领金额。</view><view class="form-section-title">选一个每月领取金额</view><view class="income-choices"><button wx:for="{{quickPlan.options}}" wx:key="tier" class="income-choice {{(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined?quickPlan.tier:quickPlan.pendingTier)===item.tier && !quickPlan.custom?'active':''}}" data-tier="{{item.tier}}" bindtap="selectQuick" aria-label="每月约领{{item.monthly}}元，年缴参考{{item.tier}}元"><view>约 <text>{{item.monthly}}</text> 元／月</view><view class="choice-note">年缴参考 {{item.tier}}元{{(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined?quickPlan.tier:quickPlan.pendingTier)===item.tier && !quickPlan.custom?' · 已选':''}}</view></button></view><button class="primary confirm-plan" bindtap="confirmQuick">按所选方案计算</button><button class="text-button" bindtap="openPaymentPlanner">按实际年份填写 ›</button><view wx:if="{{quickPlan.config.inferred && quickPlan.details}}" class="hint">已按最近的缴费年份自动匹配，属于参考假设，不是查询记录。{{quickPlan.config.currentAssumed?'今年暂按已含在年数中。':''}}{{quickPlan.config.amountAssumed?'以前每年暂按200元。':''}}</view><button wx:if="{{!quickPlan.config.complete}}" class="fold" bindtap="quickEditYears">修改自动匹配的年份<text>{{quickPlan.editYears?'收起 −':'展开 ＋'}}</text></button><block wx:if="{{!quickPlan.config.complete && quickPlan.editYears}}"><view class="segment"><button class="{{quickPlan.config.paidThisYear==='yes'?'selected':''}}" data-value="yes" bindtap="quickPaid">今年已含</button><button class="{{quickPlan.config.paidThisYear==='no'?'selected':''}}" data-value="no" bindtap="quickPaid">今年未交</button></view><view class="form-section-title">点选已经交过的{{quickPlan.base.years}}个年份</view><view class="missed-years"><button wx:for="{{quickPlan.config.years}}" wx:key="year" class="{{item.selected?'picked':''}}" data-year="{{item.year}}" bindtap="quickYear">{{item.year}}<text>{{item.selected?'已交':'未选'}}</text></button></view><view class="entry-row"><text class="row-label">以前每年交</text><view class="input-wrap row-entry"><input type="digit" value="{{quickPlan.annual}}" bindinput="quickAnnual" confirm-type="done" bindconfirm="quickGenerate"/><text>元</text></view></view></block>
<view wx:if="{{quickPlan.subsidyInputVisible}}" class="entry-row"><text class="row-label">今年原档补贴</text><view class="input-wrap row-entry"><input type="digit" value="{{quickPlan.currentSubsidy!==undefined?quickPlan.currentSubsidy:quickPlan.subsidyDisplay}}" bindinput="quickSubsidy" confirm-type="done" bindconfirm="quickGenerate"/><text>元</text></view></view><view wx:if="{{quickPlan.subsidyInputVisible}}" class="hint">按已填金额或原档补贴参考，查到不同金额可直接修改。</view>
<view wx:if="{{quickPlan.error}}" class="error" role="alert">{{quickPlan.error}}</view><button wx:if="{{!quickPlan.summary}}" class="primary" bindtap="quickRefresh">更新方案</button>
<block wx:if="{{quickPlan.summary}}"><view class="quick-income"><view class="pension-start">{{quickPlan.dirty?'金额修改中，请点击更新':quickPlan.summary.receipt+'起领 · 方案预览'}}</view><view class="pension-label">按这份方案，每月约领</view><view class="pension-value">{{quickPlan.summary.monthly}}<text>元</text></view><button class="resident-payback" bindtap="recoveryInfo"><text>领多久回本 ⓘ</text><text>{{quickPlan.summary.payback.text}}</text></button></view>
<view class="payment-condition">{{quickPlan.enough?'年数已够':'保留已交'+quickPlan.summary.paid+'年 · 补'+quickPlan.summary.added+'年'}}<block wx:if="{{quickPlan.summary.upgraded}}"> · 比较提高{{quickPlan.summary.upgraded}}年档次</block></view><view wx:if="{{quickPlan.summary.nowCost!=='0.00' || quickPlan.summary.laterYears}}" class="payment-grid"><view wx:if="{{quickPlan.summary.nowCost!=='0.00'}}">现在需交<text>{{quickPlan.summary.nowCost}}元</text><view wx:if="{{quickPlan.summary.currentCost!=='0.00'}}" class="payment-detail">补以前的{{quickPlan.summary.historyCost}}元<view></view>今年正常交{{quickPlan.summary.currentCost}}元</view></view><view wx:if="{{quickPlan.summary.laterYears}}">以后每年交<text>{{quickPlan.summary.laterAnnual}}元</text><view class="payment-detail">{{quickPlan.summary.laterFirstYear}}—{{quickPlan.summary.laterLastYear}} · 共{{quickPlan.summary.laterYears}}年</view></view></view><view class="payment-condition">补漏交 {{quickPlan.summary.missingCost}}元 · 提档补差 {{quickPlan.summary.upgradeCost}}元</view><view class="total-row"><text>以后共交</text><text>{{quickPlan.summary.total}}元</text></view>
<view wx:if="{{quickPlan.details}}" class="hint">按所选档次安排，旧年不超过当年上限，已交的钱不重算。交够15年就停。拟补年度须社保审核；金额不代表已获批准。</view><view wx:if="{{quickPlan.summary.ageOnly && quickPlan.details}}" class="hint">当前按周岁估算，生日月份可能影响所需补缴年数。</view>
<button class="fold" bindtap="quickDetails">自己调整怎么交<text>{{quickPlan.details?'收起 −':'展开 ＋'}}</text></button><view wx:if="{{quickPlan.details}}" class="quick-adjust"><view class="entry-row"><text class="row-label">补缴年档</text><picker class="row-entry" range="{{quickPlan.uniformLabels}}" value="{{quickPlan.manualTier?quickPlan.uniformLabels.length-1:quickPlan.uniformIndex}}" bindchange="quickUniformTier"><view class="control">{{quickPlan.manualTier?'自己填写':quickPlan.tier+'元／年'}}</view></picker></view><view wx:if="{{quickPlan.manualTier}}" class="entry-row"><text class="row-label">填写年档</text><view class="row-entry input-wrap"><input type="number" value="{{quickPlan.tierInput}}" bindinput="quickTierInput" bindconfirm="quickTierSubmit" confirm-type="done"/><text>元</text><button class="text-button" bindtap="quickTierSubmit">更新</button></view></view><view class="hint">统一换档会重配下面各年；旧年封顶、已交较高档的保持不变。</view><view wx:if="{{quickPlan.summary.normalYears}}" class="entry-row"><text class="row-label">{{quickPlan.summary.currentCost!=='0.00'?'今年及以后年缴':'以后每年交'}}</text><picker class="row-entry" range="{{quickPlan.tierLabels}}" value="{{quickPlan.futureIndex}}" bindchange="quickFuture"><view class="control">{{quickPlan.futureTier}}元／年</view></picker></view><view wx:for="{{quickPlan.draft.editable}}" wx:key="year" class="entry-row"><view class="row-label">{{item.year}}年<text class="year-origin">{{item.original?'原已交'+item.original+'元':'漏交的年份'}}</text></view><picker class="row-entry" range="{{item.labels}}" value="{{item.index}}" data-year="{{item.year}}" bindchange="quickTarget"><view class="control">{{item.target}}元</view></picker></view><view class="hint">已交的只补差额；选择后，上方金额自动更新。</view></view>
<button wx:if="{{quickPlan.draft.rows.length}}" class="eligibility-check {{quickPlan.confirmed?'checked':''}}" bindtap="quickConfirm"><text>{{quickPlan.confirmed?'✓':'○'}}</text>{{quickPlan.config.inferred?'推定年份已与实际记录、可补范围及补贴核对，尚未领养老金':'记录、可补年份及补贴已核对，尚未领养老金'}}</button><button class="primary" bindtap="applyMaxPlan">{{quickPlan.draft.rows.length?'核对后加入方案':'使用这个缴费档次'}}</button></block></view></block></block><block wx:elif="{{approvedPlanning}}"><view class="card single-form"><view class="card-top"><view class="card-title">补缴方案</view><button class="text-button" bindtap="cancelApprovedPlan">返回原方案</button></view><view class="hint">{{approvedPolicy.note}}</view><view wx:for="{{approvedRows}}" wx:key="index" class="detail-group"><view class="option-heading">第{{index+1}}段<button class="text-button" data-index="{{index}}" bindtap="approvedRemoveRow">删除</button></view><view>{{item.summary}}</view></view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view class="entry-row"><text class="row-label">怎么补</text><picker class="row-entry" range="{{approvedModes}}" value="{{approvedModeIndex}}" bindchange="approvedMode"><view class="control">{{approvedModes[approvedModeIndex]}}</view></picker></view><block wx:if="{{approvedDraft.mode==='missing'||approvedDraft.mode==='upgrade'}}"><view class="entry-row"><text class="row-label">开始年度</text><view class="row-entry input-wrap"><input type="number" value="{{approvedDraft.start}}" data-key="start" bindinput="approvedInput" placeholder="社保确认的年份"/><text>年</text></view></view><view class="entry-row"><text class="row-label">结束年度</text><view class="row-entry input-wrap"><input type="number" value="{{approvedDraft.end}}" data-key="end" bindinput="approvedInput" placeholder="只补一年就填相同年份"/><text>年</text></view></view></block><block wx:if="{{approvedDraft.mode==='transition'}}"><view class="entry-row"><text class="row-label">原制度建立年月</text><picker class="row-entry" mode="date" fields="month" end="2014-02" value="{{approvedDraft.schemeStart}}" data-key="schemeStart" bindchange="approvedInput"><view class="control">{{approvedDraft.schemeStart||'按社保核定填写'}}</view></picker></view><view wx:if="{{approvedPolicy.firstRegistrationFrom}}" class="entry-row"><text class="row-label">首次参保年份</text><view class="row-entry input-wrap"><input type="number" value="{{approvedDraft.firstRegistrationYear}}" data-key="firstRegistrationYear" bindinput="approvedInput" placeholder="本入口仅2015年及以后"/><text>年</text></view></view><view class="entry-row"><text class="row-label">核定共需交</text><view class="row-entry input-wrap"><input type="number" value="{{approvedDraft.requiredYears}}" data-key="requiredYears" bindinput="approvedInput" placeholder="不是只填还差几年"/><text>年</text></view></view><button class="eligibility-check {{approvedDraft.transitionReviewed==='yes'?'checked':''}}" bindtap="approvedTransitionConfirm"><text>{{approvedDraft.transitionReviewed==='yes'?'✓':'○'}}</text>社保确认我适用原制度过渡办法</button></block><view wx:if="{{approvedDraft.mode==='extension'}}" class="entry-row"><text class="row-label">60岁以后已交</text><view class="row-entry input-wrap"><input type="number" value="{{approvedDraft.extensionPaidYears}}" data-key="extensionPaidYears" bindinput="approvedInput" placeholder="按社保核对的逐年缴费记录"/><text>年</text></view></view><view wx:if="{{approvedDraft.mode==='upgrade'}}" class="entry-row"><text class="row-label">原来每年交</text><view class="row-entry input-wrap"><input type="digit" value="{{approvedDraft.original}}" data-key="original" bindinput="approvedInput" placeholder="按原缴费记录"/><text>元</text></view></view><view class="entry-row"><text class="row-label">{{approvedDraft.mode==='upgrade'?'提档后每年金额':'核定每年补多少'}}</text><view class="row-entry input-wrap"><input type="digit" value="{{approvedDraft.annual}}" data-key="annual" bindinput="approvedInput" placeholder="{{approvedDraft.mode==='transition'?'已交够核定年数可填0':'按社保核定金额填写'}}"/><text>元</text></view></view><view wx:if="{{approvedDraft.mode==='lump'}}" class="hint">按原有年数和到60岁前的正常缴费，计算还需补足多少年。具体可补档次先向社保确认。</view><button class="eligibility-check {{approvedDraft.confirmed==='yes'?'checked':''}}" bindtap="approvedConfirm"><text>{{approvedDraft.confirmed==='yes'?'✓':'○'}}</text>我尚未领养老金，资格、年份和金额已向社保核对</button><button wx:if="{{canAddApprovedRows}}" class="text-button" bindtap="approvedSaveRow">＋ 保存这段，再填一段</button><button class="primary" bindtap="applyApprovedPlan">看看补完后领多少</button><button class="text-button" data-id="{{approvedPolicy.sources[0].id}}" bindtap="policyDocument">查看补缴规定 ›</button></view></block><block wx:else><block wx:if="{{planning}}"><view class="card planning-screen"><view class="card-top"><view class="card-title">以前的缴费</view><button class="text-button" bindtap="cancelPaymentPlanner">返回原方案</button></view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<button wx:if="{{region.rule==='GUANGXI_ORDINARY'}}" class="primary quick-entry" bindtap="openPlanEntry">{{form.never?'参保与缴费选择':'补缴方案'}}</button><view wx:if="{{form.never}}" class="notice-box">还没参加过居民养老，需先登记并确认可补年份。这里先看费用参考。</view><button class="lookup-link" bindtap="openRecordHelp">不知道这些记录？先看怎么查 ›</button><view class="segment"><button class="{{planMode==='missing'?'selected':''}}" data-value="missing" bindtap="plannerMode">补漏交的年份</button><button class="{{planMode==='upgrade'?'selected':''}}" data-value="upgrade" bindtap="plannerMode">补以前的差额</button><button wx:if="{{canGXTransition}}" class="{{planMode==='confirmed'?'selected':''}}" data-value="confirmed" bindtap="plannerMode">一次补足</button></view>
<view wx:if="{{gxPlanOpen && planIllustration && !gxPlan.years.length}}" class="conditional-example">
<view wx:if="{{planIllustration.limited}}">{{planIllustration.note}}</view><block wx:else><view class="option-heading">补缴费用参考</view><view>如果允许补足{{planIllustration.years}}年</view><view class="example-cost">共{{planIllustration.cost}}元<text>按200元／年</text></view><view>{{planIllustration.age}}岁起每月约{{planIllustration.monthly}}元</view><view class="hint">{{planIllustration.note}}</view></block>
</view><view wx:if="{{gxPlanOpen}}" class="missing-planner">
<view class="card-title">以前哪些年漏交了？</view>
<view class="entry-row"><text class="row-label">可补年份从</text><view class="row-entry input-wrap"><input type="number" value="{{form.gxStartYear}}" bindinput="missingStart" placeholder="拟申请的起始年"/><text>年</text></view></view>
<view wx:if="{{form.gxStartYear && gxPlan.error}}" class="error">{{gxPlan.error}}</view>
<view class="hint">2012年已全区覆盖，但可补年份仍须审核，不以首次缴费年为起点。点选以前实际漏交的年份，已交的不重复选。</view>
<button wx:if="{{gxPlan.complete}}" class="secondary" bindtap="suggestMissing">选出凑够60岁领取需补的年份</button><view wx:if="{{gxPlan.years.length}}" class="missed-years"><button wx:for="{{gxPlan.years}}" wx:key="year" class="{{item.selected?'picked':''}}" disabled="{{item.paid}}" data-year="{{item.year}}" bindtap="missingYear">{{item.year}}<text>{{item.paid?'已交':item.selected?'已选':'漏交？'}}</text></button></view>
<block wx:if="{{gxPlan.count}}"><view class="entry-row"><text class="row-label">每年补多少</text><picker class="row-entry" range="{{gxPlan.labels}}" value="{{gxPlan.tierIndex}}" bindchange="missingTier"><view class="control">{{gxPlan.targetLabel}}</view></picker></view><view class="missing-total">补{{gxPlan.count}}年<text>共{{gxPlan.cost}}元</text></view><view class="hint">{{gxPlan.target==='MAX'?'按各年上限分段计算，旧年不会套6000元。':'按所选年份共同能选的档次计算。'}}历史补缴不加补贴。</view>
<button class="eligibility-check {{form.gxScopeReviewed==='yes'?'checked':''}}" bindtap="missingConfirm"><text>{{form.gxScopeReviewed==='yes'?'✓':'○'}}</text>已核对这些年份可补，且未领基本养老金</button><button class="primary" bindtap="applyMissingPlan">按这个方案计算</button></block>
</view>
<button wx:if="{{planMode==='missing'}}" class="fold" bindtap="plannerRecords">按缴费记录填写<text>{{planRecords?'收起 −':'展开 ＋'}}</text></button>
<button wx:if="{{planRecords && canGXTransition && planMode!=='confirmed'}}" class="text-button" data-value="confirmed" bindtap="plannerMode">已有社保确认的补费答复 ›</button><block wx:if="{{region.gxMakeup && planRecords}}"><view><view class="hint">补没交的年份，或只补低档差额；上面的已交本金不变。先核对参保地允许补的起始年。</view>
<block wx:if="{{gxUiRows.length}}"><view class="entry-row"><text class="row-label">可补起始年度</text><view class="row-entry input-wrap"><input type="number" value="{{form.gxStartYear}}" data-key="gxStartYear" bindinput="input" placeholder="经办确认的年度，如2012"/><text>年</text></view></view>
<view class="detail-group" wx:for="{{gxUiRows}}" wx:key="rowKey"><view class="option-heading option-top">第{{index+1}}段<button class="text-button" data-index="{{index}}" bindtap="gxRemove">删除</button></view>
<view class="entry-row"><text class="row-label">怎么补</text><picker class="row-entry" range="{{['补没交的年份','提高已交年份档次']}}" value="{{item.mode==='missing'?0:1}}" data-index="{{index}}" bindchange="gxMode"><view class="control">{{item.mode==='missing'?'补没交的年份':'提高已交年份档次'}}</view></picker></view>
<view class="entry-row"><text class="row-label">开始年度</text><view class="row-entry input-wrap"><input type="number" value="{{item.start}}" data-index="{{index}}" data-key="start" bindinput="gxInput" placeholder="如2019"/><text>年</text></view></view><view class="entry-row"><text class="row-label">结束年度</text><view class="row-entry input-wrap"><input type="number" value="{{item.end}}" data-index="{{index}}" data-key="end" bindinput="gxInput" placeholder="仅一年则填相同年份"/><text>年</text></view></view>
