<view class="shell {{region.status!=='PENDING'?'has-submit':''}}"><view class="mast"><view class="title">居民养老</view></view>
<region-picker value="{{form.regionId}}" kind="resident" resident-area="{{form.localArea}}" bindchange="regionChoice"/>
<block wx:if="{{approvedPlanning}}"><view class="card single-form"><view class="card-top"><view class="card-title">补缴方案</view><button class="text-button" bindtap="cancelApprovedPlan">返回原方案</button></view><view class="hint">{{approvedPolicy.note}}</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view class="entry-row"><text class="row-label">怎么补</text><picker class="row-entry" range="{{approvedModes}}" value="{{approvedModeIndex}}" bindchange="approvedMode"><view class="control">{{approvedModes[approvedModeIndex]}}</view></picker></view><block wx:if="{{approvedDraft.mode!=='lump'}}"><view class="entry-row"><text class="row-label">开始年度</text><view class="row-entry input-wrap"><input type="number" value="{{approvedDraft.start}}" data-key="start" bindinput="approvedInput" placeholder="社保确认的年份"/><text>年</text></view></view><view class="entry-row"><text class="row-label">结束年度</text><view class="row-entry input-wrap"><input type="number" value="{{approvedDraft.end}}" data-key="end" bindinput="approvedInput" placeholder="只补一年就填相同年份"/><text>年</text></view></view></block><view wx:if="{{approvedDraft.mode==='upgrade'}}" class="entry-row"><text class="row-label">原来每年交</text><view class="row-entry input-wrap"><input type="digit" value="{{approvedDraft.original}}" data-key="original" bindinput="approvedInput" placeholder="按原缴费记录"/><text>元</text></view></view><view class="entry-row"><text class="row-label">{{approvedDraft.mode==='upgrade'?'提档后每年金额':'核定每年补多少'}}</text><view class="row-entry input-wrap"><input type="digit" value="{{approvedDraft.annual}}" data-key="annual" bindinput="approvedInput" placeholder="按社保核定金额填写"/><text>元</text></view></view><view wx:if="{{approvedDraft.mode==='lump'}}" class="hint">按原有年数和到60岁前的正常缴费，计算还需补足多少年。具体可补档次先向社保确认。</view><button class="eligibility-check {{approvedDraft.confirmed==='yes'?'checked':''}}" bindtap="approvedConfirm"><text>{{approvedDraft.confirmed==='yes'?'✓':'○'}}</text>我尚未领养老金，资格、年份和金额已向社保核对</button><button class="primary" bindtap="applyApprovedPlan">看看补完后领多少</button><button class="text-button" data-id="{{approvedPolicy.sources[0].id}}" bindtap="policyDocument">查看补缴规定 ›</button></view></block><block wx:else><block wx:if="{{planning}}"><view class="card planning-screen"><view class="card-top"><view class="card-title">以前的缴费</view><button class="text-button" bindtap="cancelPaymentPlanner">返回原方案</button></view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<view wx:if="{{form.never}}" class="notice-box">还没参加过居民养老，需先登记并确认可补年份。这里先看费用参考。</view><view class="segment"><button class="{{planMode==='missing'?'selected':''}}" data-value="missing" bindtap="plannerMode">补漏交的年份</button><button class="{{planMode==='upgrade'?'selected':''}}" data-value="upgrade" bindtap="plannerMode">补以前的差额</button><button wx:if="{{canGXTransition}}" class="{{planMode==='confirmed'?'selected':''}}" data-value="confirmed" bindtap="plannerMode">一次补足</button></view>
<view wx:if="{{gxPlanOpen && planIllustration && !gxPlan.years.length}}" class="conditional-example">
<view wx:if="{{planIllustration.limited}}">{{planIllustration.note}}</view><block wx:else><view class="option-heading">补缴费用参考</view><view>如果允许补足{{planIllustration.years}}年</view><view class="example-cost">共{{planIllustration.cost}}元<text>按200元／年</text></view><view>{{planIllustration.age}}岁起每月约{{planIllustration.monthly}}元</view><view class="hint">{{planIllustration.note}}</view></block>
</view><view wx:if="{{gxPlanOpen}}" class="missing-planner">
<view class="card-title">以前哪些年漏交了？</view>
<view class="entry-row"><text class="row-label">第一次交费</text><view class="row-entry input-wrap"><input type="number" value="{{form.firstPaidYear}}" bindinput="missingStart" placeholder="记不清可以留空"/><text>年</text></view></view>
<view wx:if="{{form.firstPaidYear && gxPlan.error}}" class="error">{{gxPlan.error}}</view>
<view class="hint">点选以前实际漏交的年份，已交的不重复选。今年的缴费在填写页修改。</view>
<view wx:if="{{gxPlan.years.length}}" class="missed-years"><button wx:for="{{gxPlan.years}}" wx:key="year" class="{{item.selected?'picked':''}}" disabled="{{item.paid}}" data-year="{{item.year}}" bindtap="missingYear">{{item.year}}<text>{{item.paid?'已交':item.selected?'已选':'漏交？'}}</text></button></view>
<block wx:if="{{gxPlan.count}}"><view class="entry-row"><text class="row-label">每年补多少</text><picker class="row-entry" range="{{gxPlan.labels}}" value="{{gxPlan.tierIndex}}" bindchange="missingTier"><view class="control">{{gxPlan.target}}元／年</view></picker></view><view class="missing-total">补{{gxPlan.count}}年<text>共{{gxPlan.cost}}元</text></view><view class="hint">按所选年份共同能选的档次计算，未加补贴。</view>
<button class="eligibility-check {{form.gxScopeReviewed==='yes'?'checked':''}}" bindtap="missingConfirm"><text>{{form.gxScopeReviewed==='yes'?'✓':'○'}}</text>已核对这些年份可补，且未领基本养老金</button><button class="primary" bindtap="applyMissingPlan">按这个方案计算</button></block>
</view>
<button wx:if="{{planMode==='missing'}}" class="fold" bindtap="plannerRecords">按缴费记录填写<text>{{planRecords?'收起 −':'展开 ＋'}}</text></button>
<button wx:if="{{planRecords && canGXTransition && planMode!=='confirmed'}}" class="text-button" data-value="confirmed" bindtap="plannerMode">已有社保确认的补费答复 ›</button><block wx:if="{{region.gxMakeup && planRecords}}"><view><view class="hint">补没交的年份，或只补低档差额；上面的已交本金不变。先核对参保地允许补的起始年。</view>
<block wx:if="{{gxUiRows.length}}"><view class="entry-row"><text class="row-label">可补起始年度</text><view class="row-entry input-wrap"><input type="number" value="{{form.gxStartYear}}" data-key="gxStartYear" bindinput="input" placeholder="经办确认的年度，如2012"/><text>年</text></view></view>
<view class="detail-group" wx:for="{{gxUiRows}}" wx:key="rowKey"><view class="option-heading option-top">第{{index+1}}段<button class="text-button" data-index="{{index}}" bindtap="gxRemove">删除</button></view>
<view class="entry-row"><text class="row-label">怎么补</text><picker class="row-entry" range="{{['补没交的年份','提高已交年份档次']}}" value="{{item.mode==='missing'?0:1}}" data-index="{{index}}" bindchange="gxMode"><view class="control">{{item.mode==='missing'?'补没交的年份':'提高已交年份档次'}}</view></picker></view>
<view class="entry-row"><text class="row-label">开始年度</text><view class="row-entry input-wrap"><input type="number" value="{{item.start}}" data-index="{{index}}" data-key="start" bindinput="gxInput" placeholder="如2019"/><text>年</text></view></view><view class="entry-row"><text class="row-label">结束年度</text><view class="row-entry input-wrap"><input type="number" value="{{item.end}}" data-index="{{index}}" data-key="end" bindinput="gxInput" placeholder="仅一年则填相同年份"/><text>年</text></view></view>
<view wx:if="{{item.mode==='upgrade'}}" class="entry-row"><text class="row-label">原来每年交</text><view class="row-entry input-wrap"><input type="digit" value="{{item.original}}" data-index="{{index}}" data-key="original" bindinput="gxInput" placeholder="按原缴费记录"/><text>元</text></view></view>
<view class="entry-row"><text class="row-label">目标年档</text><picker class="row-entry" range="{{item.targetLabels}}" value="{{item.targetIndex}}" data-index="{{index}}" bindchange="gxTarget"><view class="control">{{item.targetLabels[item.targetIndex]}}</view></picker></view>
<view wx:if="{{item.currentUpgrade}}" class="entry-row"><text class="row-label">今年已享补贴</text><view class="row-entry input-wrap"><input type="digit" value="{{item.subsidyAlready}}" data-index="{{index}}" data-key="subsidyAlready" bindinput="gxInput" placeholder="按记录，未享受填0"/><text>元</text></view></view></view>
<button class="eligibility-check {{form.gxScopeReviewed==='yes'?'checked':''}}" data-key="gxScopeReviewed" data-value="{{form.gxScopeReviewed==='yes'?'unknown':'yes'}}" bindtap="choice"><text>{{form.gxScopeReviewed==='yes'?'✓':'○'}}</text>我未领基本养老金，补缴起点和原记录已向经办核对</button></block>
<view wx:if="{{canGXTransition}}" class="detail-group"><button class="eligibility-check {{form.gxTransitionEnabled==='yes'?'checked':''}}" data-key="gxTransitionEnabled" data-value="{{form.gxTransitionEnabled==='yes'?'no':'yes'}}" bindtap="choice"><text>{{form.gxTransitionEnabled==='yes'?'✓':'○'}}</text>社保已确认我能补足剩余年数</button><block wx:if="{{form.gxTransitionEnabled==='yes'}}"><view class="entry-row"><text class="row-label">当地制度开始年月</text><picker class="row-entry" mode="date" fields="month" start="2009-10" end="2012-12" value="{{form.gxTransitionStart}}" data-key="gxTransitionStart" bindchange="input"><view class="control">{{form.gxTransitionStart||'按经办核定填写'}}</view></picker></view><view class="entry-row"><text class="row-label">社保确认能补几年</text><view class="row-entry input-wrap"><input type="number" value="{{form.gxTransitionYears}}" data-key="gxTransitionYears" bindinput="input" placeholder="按经办核定填写"/><text>年</text></view></view><view class="hint">原制度指当地新农保或城居保，请先核对建立年月，并改填出生年月。须已按规定逐年交至60岁且未领待遇；历史欠费请分开处理。</view><button class="eligibility-check {{form.gxTransitionReviewed==='yes'?'checked':''}}" data-key="gxTransitionReviewed" data-value="{{form.gxTransitionReviewed==='yes'?'unknown':'yes'}}" bindtap="choice"><text>{{form.gxTransitionReviewed==='yes'?'✓':'○'}}</text>我未领基本养老金，上述资格和补足年数已经办核定</button></block></view>
<button class="tutorial" bindtap="gxAdd">＋ 添加补缴或提档记录</button><button class="text-button" data-id="gx-resident-makeup-2023" bindtap="policyDocument">查看补缴规定 ›</button></view></block>
<button wx:if="{{planRecords}}" class="primary" bindtap="calculate">算补完后的金额</button></view></block><block wx:else>
<block wx:if="{{region.status!=='PENDING'}}"><block wx:if="{{!result}}"><view class="card single-form pension-form"><view class="card-top"><view class="card-title">参保信息</view><button class="text-button" bindtap="reset">重新填写</button></view>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<view class="entry-row age-entry"><text class="row-label">{{form.ageOnly?'周岁年龄':'出生年月'}}</text><view class="row-entry"><view wx:if="{{form.ageOnly}}" class="input-wrap"><input type="number" value="{{form.age}}" data-key="age" bindinput="input" placeholder="输入年龄"/><text>岁</text></view><picker wx:else mode="date" fields="month" value="{{form.birth}}" data-key="birth" bindchange="input"><view class="control">{{form.birth||'请选择'}}</view></picker></view><button class="age-mode-button" data-value="{{form.ageOnly?'birth':'age'}}" bindtap="ageMode">{{form.ageOnly?'用出生年月':'改填年龄'}}</button></view>
<view wx:if="{{region.areas && !region.hideAreaPicker}}" class="entry-row"><text class="row-label">参保所在地</text><picker class="row-entry" range="{{areaLabels}}" value="{{areaIndex}}" bindchange="localArea"><view class="control">{{areaLabels[areaIndex]}}</view></picker></view><view wx:if="{{region.residenceRequired}}" class="entry-row"><text class="row-label">成都参保身份</text><view class="segment row-entry"><button class="{{form.cdResidence==='rural'?'selected':''}}" data-value="rural" bindtap="cdResidence">农村居民</button><button class="{{form.cdResidence==='urban'?'selected':''}}" data-value="urban" bindtap="cdResidence">城镇居民</button></view></view><view class="form-section-title">已经交的</view><view class="entry-row"><text class="row-label">居民养老</text><view class="segment row-entry"><button class="{{form.never?'selected':''}}" data-value="never" bindtap="history">没参加过</button><button class="{{!form.never?'selected':''}}" data-value="paid" bindtap="history">参加过</button></view></view>
<block wx:if="{{!form.never}}"><view class="entry-row"><text class="row-label">已交年数</text><view class="row-entry input-wrap"><input type="number" value="{{form.years}}" data-key="years" bindinput="input" placeholder="实际缴过几年"/><text>年</text></view></view><block wx:if="{{form.accountMode!=='balance'}}"><view wx:if="{{form.historyMode!=='segments'}}" class="entry-row"><text class="row-label">{{form.pastMonthly?'以前每月交':'以前每年交'}}</text><view class="row-entry input-wrap"><input type="digit" value="{{form.pastAnnual}}" data-key="pastAnnual" bindinput="input" placeholder="按实际填写，例如300"/><text>元</text></view></view></block>
<view wx:if="{{form.accountMode==='balance' || form.historyMode==='segments'}}" class="entry-row"><text class="row-label">以前缴费</text><view>{{form.accountMode==='balance'?'按账户'+form.balance+'元计算':'按已填的分段记录计算'}}</view></view><view class="entry-row"><text class="row-label">今年交了吗</text><view class="segment row-entry"><button class="{{form.paidThisYear==='no'?'selected':''}}" data-key="paidThisYear" data-value="no" bindtap="choice">未缴</button><button class="{{form.paidThisYear==='yes'?'selected':''}}" data-key="paidThisYear" data-value="yes" bindtap="choice">已算在年数里</button></view></view></block>
<view wx:if="{{needsCurrentYearTier}}" class="entry-row"><text class="row-label">今年实际年缴档</text><picker class="row-entry" range="{{currentTierLabels}}" value="{{currentTierIndex}}" bindchange="currentYearTier"><view class="control">{{currentTierLabels[currentTierIndex]}}</view></picker></view><view class="form-section-title">以后怎么交</view><view wx:if="{{canContinueTo60}}" class="entry-row"><text class="row-label">缴费时间</text><picker class="row-entry" range="{{payUntilLabels}}" value="{{payUntilIndex}}" bindchange="payUntil"><view class="control">{{payUntilLabels[payUntilIndex]}}</view></picker></view><view class="entry-row"><text class="row-label">{{form.gxTransitionEnabled==='yes'?'补足所选年档':cdLumpOnly?'到龄补缴档':'自己每年交'}}</text><picker wx:if="{{!region.annualInput}}" class="row-entry" range="{{tierLabels}}" value="{{tierIndex}}" bindchange="tier"><view class="control">{{region.residenceRequired || cdLumpOnly?tierLabels[tierIndex]:form.tier+' 元／年'}}</view></picker><view wx:if="{{region.annualInput}}" class="row-entry input-wrap"><input type="number" value="{{form.tier}}" data-key="tier" bindinput="input" placeholder="填当地可选的年度金额"/><text>元</text></view></view><view wx:if="{{region.annualInput}}" class="field"><view class="hint">按当地缴费页面填写，暂不计未核实的缴费补贴。</view><button class="policy-confirm {{form.localAnnualConfirmed==='yes'?'confirmed':''}}" data-key="localAnnualConfirmed" data-value="{{form.localAnnualConfirmed==='yes'?'unknown':'yes'}}" bindtap="choice">{{form.localAnnualConfirmed==='yes'?'✓ 已核对当地可选金额':'这个金额在当地可以交'}}</button></view>
<view wx:if="{{region.continuous}}" class="entry-row"><text class="row-label">或自选年缴</text><view class="row-entry input-wrap"><input type="digit" value="{{form.tier}}" data-key="tier" bindinput="input" placeholder="1000至9000"/><text>元</text></view></view><button class="fold settings-fold" bindtap="toggle">更多设置<text>{{more?'收起 −':'选填 ＋'}}</text></button><block wx:if="{{more}}"><block wx:if="{{!form.never}}"><view class="entry-row"><text class="row-label">个人账户</text><picker class="row-picker" range="{{['按缴费估算','填查询金额']}}" value="{{form.accountMode==='balance'?1:0}}" bindchange="accountPicker"><view class="control">{{form.accountMode==='balance'?'填查询金额':'按缴费估算'}}</view></picker></view><block wx:if="{{form.accountMode==='balance'}}"><view class="entry-row"><text class="row-label">账户储存额</text><view class="row-entry input-wrap"><input type="digit" value="{{form.balance}}" data-key="balance" bindinput="input" placeholder="查询金额，含补贴利息"/><text>元</text></view></view><view wx:if="{{region.residenceRequired}}" class="entry-row"><text class="row-label">以前每年自己交</text><view class="row-entry input-wrap"><input type="digit" value="{{form.pastAnnual}}" data-key="pastAnnual" bindinput="input" placeholder="用于推算基础养老金"/><text>元</text></view></view></block><block wx:if="{{form.accountMode!=='balance'}}"><button class="fold history-options" data-key="showHistory" bindtap="fold">{{form.historyMode==='segments'?'分段填写历史缴费':'历史缴费明细（选填）'}}<text>{{showHistory?'收起':'展开'}}</text></button><block wx:if="{{showHistory || form.historyMode==='segments'}}"><view class="segment"><button class="{{form.historyMode!=='segments'?'selected':''}}" data-value="simple" bindtap="historyMode">平均金额</button><button class="{{form.historyMode==='segments'?'selected':''}}" data-value="segments" bindtap="historyMode">分段填写</button></view><picker wx:if="{{form.historyMode!=='segments'}}" range="{{['每年缴费','以前按月缴费']}}" value="{{form.pastMonthly?1:0}}" bindchange="pastPeriod"><view class="control">{{form.pastMonthly?'按月填写，自动乘12':'按年填写'}}</view></picker><view wx:if="{{!form.never && form.historyMode==='segments'}}" class="field"><view class="hint">只填实际缴过的年份；每段视为连续已缴，漏缴年度拆成两段。合计须与已缴年限一致。</view><view class="plan-row" wx:for="{{form.segments}}" wx:key="index"><input class="control" type="number" value="{{item.start}}" data-index="{{index}}" data-key="start" bindinput="segmentInput" placeholder="开始年份，例如2015"/><input class="control" type="number" value="{{item.end}}" data-index="{{index}}" data-key="end" bindinput="segmentInput" placeholder="结束年份，例如2019"/><input class="control" type="digit" value="{{item.annual}}" data-index="{{index}}" data-key="annual" bindinput="segmentInput" placeholder="该段每年本人交多少元"/><button class="text-button" data-index="{{index}}" bindtap="removeSegment">删除这段</button></view><button class="tutorial" bindtap="addSegment">＋ 增加历史阶段</button></view></block></block></block><view class="field"><text>数据截至月份</text><picker mode="date" fields="month" value="{{form.asOf}}" data-key="asOf" bindchange="input"><view class="control">{{form.asOf}}</view></picker></view><view class="field"><text>一次性缴费预算（选填）</text><input class="control" type="digit" value="{{form.budget}}" data-key="budget" bindinput="input" placeholder="留空不限制一次性预算"/></view><view wx:if="{{form.regionId==='440100'}}" class="field"><text>已享受政府补贴合计（未知留空）</text><input class="control" type="digit" value="{{form.usedSubsidy}}" data-key="usedSubsidy" bindinput="input" placeholder="未知时后续补贴保守按0"/></view></block>
<view wx:if="{{needsTransition || needsExtended}}" class="policy-checks">
 <view class="policy-check-title">这类情况需先向街镇核对</view>
 <view wx:if="{{needsTransition}}" class="field"><view class="hint">你可能适用以前的领取办法。可先看不补缴、继续逐年交的方案。</view><button class="policy-confirm {{form.transition==='no'?'confirmed':''}}" data-key="transition" data-value="{{form.transition==='no'?'unknown':'no'}}" bindtap="choice">{{form.transition==='no'?'✓ 先按逐年交计算':'先看逐年交的方案'}}</button></view>
 <view wx:if="{{needsExtended}}" class="field"><view class="hint">已满65岁但没交够15年，需确认能否补足。</view><button class="policy-confirm {{form.extended==='yes'?'confirmed':''}}" data-key="extended" data-value="{{form.extended==='yes'?'unknown':'yes'}}" bindtap="choice">{{form.extended==='yes'?'✓ 已核对，可按延缴办法补足':'我已核对，可按延缴办法补足'}}</button></view>
</view>
<view wx:if="{{form.socialAidAnnual}}" class="entry-row"><text class="row-label">家人每年资助{{form.socialAidAnnual}}元</text><button class="condition-link" bindtap="socialAidCancel">取消资助</button></view><view class="entry-row"><text class="row-label">已领养老金吗</text><view class="segment row-entry"><button class="{{form.receiving!=='yes'?'selected':''}}" data-key="receiving" data-value="no" bindtap="choice">还没领</button><button class="{{form.receiving==='yes'?'selected':''}}" data-key="receiving" data-value="yes" bindtap="choice">已经领了</button></view></view><view class="submit-dock"><button class="primary calculate-button" bindtap="calculate">开始计算</button></view></view></block><block wx:else>
<view wx:if="{{result.referenceLabel}}" class="notice-box field">{{result.referenceLabel}}</view><view class="pension-income">
 <view class="pension-start">{{result.transition?'补费到账次月起领':(region.rule==='GUANGXI_ORDINARY' && result.remainingAfterMakeup>0?'按逐年交费 · ':'')+result.chosen.timeline.receivingAge+'岁起领 · '+result.chosen.receiptYear+'年'}}</view>
 <view class="pension-label">退休后，每月约领</view>
 <view class="pension-value">{{display.monthly}}<text>元</text></view>
</view>
<view wx:if="{{region.rule==='GUANGXI_ORDINARY' && result.remainingAfterMakeup>0 && !result.transition}}" class="scope-note">这是逐年交费的结果。想看补缴后何时能领，点“换个方案”。</view>
<view class="card field payment-card"><view class="card-title">接下来这样交</view><view wx:if="{{result.chosen.timeline.lockedYear}}" class="hint">{{result.chosen.timeline.lockedYear}}年待交{{result.chosen.timeline.lockedAnnual}}元，已计入总额。</view>
 <view wx:if="{{result.missing || result.makeup || result.chosen.timeline.normalYears}}" class="payment-grid"><view wx:if="{{result.makeup}}">现在补交<text>{{result.chosen.immediateCost}}元</text><view class="payment-detail"><block wx:if="{{result.makeup.addedYears}}">补{{result.makeup.addedYears}}年</block><block wx:if="{{result.makeup.upgradedYears}}"> 提高{{result.makeup.upgradedYears}}年档次</block></view><view class="payment-date">{{result.approvedPlan?'按核定方案办理参考':'按已填年度办理参考'}}</view></view>
  <view wx:if="{{result.chosen.timeline.normalYears && result.chosen.timeline.futureNormalYears!==0}}">{{result.transition?'先交今年':'以后每年交'}}<text>{{result.chosen.annualTotal}}元</text><view wx:if="{{result.chosen.socialAidAnnual}}" class="payment-detail">自己{{result.chosen.annual}}元＋家人资助{{result.chosen.socialAidAnnual}}元</view><view class="payment-detail">× {{result.chosen.timeline.lockedYear?result.chosen.timeline.futureNormalYears:result.chosen.timeline.normalYears}}年</view><view class="payment-date">{{result.chosen.timeline.lockedYear?result.chosen.timeline.futureFirstYear:result.chosen.timeline.firstYear}}—{{result.chosen.timeline.lastYear}}</view></view>
  <view wx:if="{{result.chosen.lumpYears}}">{{result.transition?'现在补足':result.chosen.timeline.lumpAge+'岁时补'}}<text>{{display.lump}}元</text><view class="payment-detail">补{{result.chosen.lumpYears}}年 · {{result.chosen.lumpUnit?result.chosen.lumpUnit+'元／年':'所选档参考'}}</view><view class="payment-date">{{result.chosen.timeline.lumpMonth}}办理参考</view></view>
 </view>
 <view wx:else class="hint">已交够，{{result.age>=60?'可办理领取':'到60岁办理领取'}}</view>
 <view class="total-row"><text>{{result.transition?'本次需交':'以后共交'}}</text><text>{{display.total}}元</text></view>
 <view wx:if="{{!result.chosen.affordable}}" class="error">一次缴费超预算{{result.chosen.shortfall}}元</view>
</view>
<view class="submit-dock result-dock"><view class="result-actions"><button class="secondary restart-button" bindtap="reset">重新填写</button><button class="primary" bindtap="edit">修改信息</button></view></view>
<view class="card result-section future-plans">
 <button class="fold result-fold" data-key="compare" bindtap="fold"><view>换个方案</view><text>{{compare?'收起 −':'展开 ＋'}}</text></button>
 <view wx:if="{{compare}}" class="section-body">
<block wx:if="{{paymentGuide}}"><button class="fold" data-key="paymentGuideOpen" bindtap="fold">补缴办法<text>{{paymentGuideOpen?'收起 −':'展开 ＋'}}</text></button><view wx:if="{{paymentGuideOpen}}" class="detail-text"><view class="detail-group" wx:for="{{paymentGuide.rows}}" wx:key="id"><view class="option-heading">{{item.title}}</view><view>{{item.text}}</view><view wx:if="{{item.quote}}">{{item.quote}}</view><button wx:if="{{item.action}}" class="text-button" data-mode="{{item.mode}}" bindtap="guideAction">{{item.action}} ›</button></view><view class="hint">{{paymentGuide.note}}</view><button class="text-button" data-id="{{paymentGuide.sourceId}}" bindtap="policyDocument">查看缴费规定 ›</button></view></block>
<button wx:if="{{region.rule==='GUANGXI_ORDINARY'}}" class="planner-entry" bindtap="openPaymentPlanner"><view>补缴或提高以前的金额<text>看看能否早点领，或每月多领些</text></view><text>›</text></button>
  <view wx:if="{{canContinueTo60}}" class="entry-row"><text class="row-label">缴费时间</text><picker class="row-entry" range="{{payUntilLabels}}" value="{{payUntilIndex}}" bindchange="payUntil"><view class="control">{{payUntilLabels[payUntilIndex]}}</view></picker></view>
 <button wx:if="{{form.approvedPlan}}" class="text-button" bindtap="removeApprovedPlan">取消这次补缴，查看原方案</button><view class="fixed-history">{{result.transition?'已交的'+result.paidYears+'年不变，比较核定补足'+result.transition.years+'年的档次':result.makeup?'补缴方案不变，只选以后每年交多少':result.chosen.lumpYears?'已交的'+result.paidYears+'年不变，比较以后缴费和补足档次':'以前交的'+result.paidYears+'年不变，只选以后怎么交'}}</view>
  <view wx:if="{{result.chosen.selfCollective}}" class="active-extra">已包含每年额外交{{result.chosen.selfCollective}}元</view>
  <view wx:if="{{!canComparePayment}}" class="notice-box">{{result.makeup?'已按上面记录安排补缴／提档，没有待缴的以后年度。':result.chosen.timeline.lockedYear?'今年按已确认档次交，没有可更换的以后年度。':'没有待缴的正常年度。本页不把过去缴费改成高档；到龄补缴的可选档须先向经办核定。'}}</view>
  <block wx:else>
   <view class="option-heading">退休后，每月约领多少？<text>{{region.parameterStatus==='NATIONAL_FLOOR_REFERENCE'?'当地缴费档':region.provincial?'省级参考档':region.continuous?'常用金额':planOptions.length+'档可选'}}</text></view>
   <view class="income-options">
    <button wx:for="{{planOptions}}" wx:key="annual" class="income-choice {{item.annual===result.chosen.annual?'chosen-option':''}}" data-annual="{{item.annual}}" bindtap="chooseFuture" aria-label="每月约{{item.monthly}}元，{{item.annual===result.chosen.annual?'已选':'点击选择'}}"><view class="choice-number"><text class="approx">约</text>{{item.monthly}}<text>元／月</text></view><view class="choice-state">{{item.annual===result.chosen.annual?'✓ 已选':'选择'}}</view></button>
   </view>
   <block wx:if="{{region.socialAidCap && result.chosen.timeline.normalYears && result.chosen.timeline.futureNormalYears!==0}}">
    <button class="extra-toggle" data-key="extraOpen" bindtap="fold">家人还能帮你加一笔（选填）<text>{{extraOpen?'收起 −':'展开 ＋'}}</text></button>
    <view wx:if="{{extraOpen}}" class="extra-options">
     <view class="hint">先交当年养老费，再由子女等申请资助。每年与集体补助合计最多{{region.socialAidCap}}元，不增加缴费年数。</view>
     <checkbox-group bindchange="socialAidConfirm"><label class="aid-confirm"><checkbox value="yes" checked="{{form.socialAidConfirmed==='yes'}}" color="#2463eb"/>没有其他集体补助或社会资助</label></checkbox-group>
     <view wx:if="{{form.socialAidConfirmed==='yes'}}" class="field"><text>以后每年资助 · 常用金额</text><picker range="{{socialAidLabels}}" value="{{socialAidIndex}}" bindchange="socialAidChoose"><view class="control">{{socialAidLabels[socialAidIndex]}}</view></picker></view>
     <view class="hint">只计上面尚待缴费的正常年度，不补过去、不加到到龄补费；没有额外政府补贴。</view>
    </view>
   </block>
   <button wx:if="{{form.regionId==='440100'}}" class="extra-toggle" data-key="extraOpen" bindtap="fold">其他增额方式（选填）<text>{{extraOpen?'收起 −':'展开 ＋'}}</text></button>
   <view wx:if="{{extraOpen && form.regionId==='440100'}}" class="extra-options">
    <view class="hint">村集体没有给你补助时，才可选这一项。</view>
    <button class="collective-check" bindtap="toggleCollective">{{form.noCollective==='yes'?'☑':'□'}} 我确认没有村集体补助，想额外交费</button>
    <picker wx:if="{{form.noCollective==='yes'}}" range="{{['不加交','另外360元／年','另外600元／年','另外900元／年','另外1200元／年','另外1800元／年','另外3600元／年','另外4800元／年']}}" value="{{collectiveIndex||0}}" bindchange="collectiveTier"><view class="control">以后每年额外交：{{form.selfCollectiveTier||0}}元</view></picker>
    <view class="hint">这笔钱也由你承担，属于自费集体档；只加到以后每年缴费，不补以前的年份，也不加入到龄补缴。</view>
   </view>
  </block>
 </view>
</view>
<view wx:if="{{form.regionId==='440100'}}" class="card result-section policy-choices"><button class="fold result-fold" data-key="policyOpen" bindtap="fold"><view>补缴与提档说明</view><text>{{policyOpen?'收起 −':'展开 ＋'}}</text></button><view wx:if="{{policyOpen}}" class="section-body">
 <view class="policy-item"><view class="policy-heading">以后换高档 <text class="policy-status">可以</text></view><view class="hint">按年度选档，不要求一直沿用以前360元。今年已缴的，调整从下一缴费年度开始。</view></view>
 <view class="policy-item"><view class="policy-heading">把过去低档补成高档 <text class="policy-status muted-status">暂不支持</text></view><view class="hint">过去低档补成高档的办理期已在2022年底结束。目前没查到重新开放的通知，暂时不能按补十几万来计算。</view></view>
 <view class="policy-item"><view class="policy-heading">65岁补不足的年数 <text class="policy-status">有条件</text></view><view class="hint">普通人延缴到65岁仍不足15年才可补足。这是补年数，不是把过去已交的年份提档；补缴不享政府补贴。能选哪些补缴档，请向户籍街镇确认。</view></view>
 <view class="policy-item"><view class="policy-heading">自己承担集体补助档 <text class="policy-status">有条件</text></view><view class="hint">村集体没有给予补助时，可以另选集体补助档自己交。本页只计算今后正常年缴，补缴、已交年度补差不自动加入。</view></view>
 <button class="tutorial" data-url="https://www.gzns.gov.cn/zwgk/tzgg/content/post_8719039.html" bindtap="policyDocument">历史提档什么时候截止？查看文件 ›</button>
 <button class="tutorial" data-url="https://www.gz.gov.cn/gfxwj/szfgfxwj/gzsrmzfbgt/content/post_7304595.html" bindtap="policyDocument">缴费档次和补缴条件 · 查看文件 ›</button>
</view></view>
<view class="card result-section compact-folds"><button class="fold result-fold" data-key="showNotes" bindtap="fold"><view>缴费记录与计算详情</view><text>{{showNotes?'收起 −':'展开 ＋'}}</text></button><view wx:if="{{showNotes}}" class="section-body">
 <view class="detail-group"><view class="option-heading">已交情况</view><view>已交{{result.paidYears}}年 · 还差{{result.missing}}年</view><view wx:if="{{result.makeup}}">按这次补缴办理后，还需正常交{{result.remainingAfterMakeup}}年</view><view wx:if="{{result.pastPaid!==null}}">以前自己交了约{{result.pastPaid}}元</view></view>
 <view class="detail-group"><view class="option-heading">这份方案</view><view>退休后每月约领：{{display.monthly}}元（取整显示）</view><view>{{result.chosen.timeline.lockedYear?'以后年度年缴':'正常年缴'}}：个人{{result.chosen.annual}}元<block wx:if="{{result.chosen.socialAidAnnual}}">＋家人资助{{result.chosen.socialAidAnnual}}元</block><block wx:if="{{result.chosen.selfCollective}}">＋自费集体档{{result.chosen.selfCollective}}元</block>／年</view><view>到龄补缴：{{result.chosen.lumpYears}}年×个人{{result.chosen.lumpUnit||result.chosen.annual}}元（每年补缴单价，办理时确认）</view><view wx:if="{{result.chosen.recoverySlow>0}}">开始领取后，按{{display.recovery}}算，能领回以后交的这笔钱。包含以前积累的权益，未计等待时间和利息。</view></view>
 <view wx:if="{{result.makeup}}" class="detail-group"><view class="option-heading">补缴／提档记录</view><view wx:for="{{result.makeup.entries}}" wx:key="year" class="schedule-item">{{item.year}}年：{{item.mode==='missing'?'补未缴':'原'+item.original+'元'}} → {{item.target}}元；另交{{item.cost}}元，补贴{{item.subsidy}}元</view></view><view class="detail-group"><view class="option-heading">逐年费用</view><view wx:for="{{result.chosen.schedule}}" wx:key="year" class="schedule-item">{{item.year}}年：{{item.cost}}元（{{item.years}}年）</view></view>
 <view class="detail-group"><view class="option-heading">怎么算的</view><view class="hint">基础养老金沿用{{result.baseYear}}年标准；利息为0，假设未来规则不变。年度缴费截止及起付月份需向户籍街镇确认。</view><view class="hint" wx:for="{{result.warnings}}" wx:key="*this">{{item}}</view></view>
 <button wx:for="{{result.sources}}" wx:key="url" class="tutorial" data-url="{{item.url}}" bindtap="policyDocument">{{item.name}} ›</button>
</view></view>
<view class="result-disclaimer">按所选地区、尚未领取养老金的情况计算，金额供参考。</view>
</block></block></block></block></view><tool-nav active="resident"/>

