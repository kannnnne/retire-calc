  <view wx:if="{{paymentBreakdown && !result.makeup && paymentBreakdown.currentCost!=='0.00'}}">今年需交<text>{{paymentBreakdown.currentCost}}元</text><view wx:if="{{result.uncertainty.yearUnknown}}" class="payment-detail">今年先按未交参考</view></view><view wx:if="{{(paymentBreakdown?paymentBreakdown.laterYears:result.chosen.timeline.normalYears) && result.chosen.timeline.futureNormalYears!==0}}">{{result.transition?'先交今年':'以后每年交'}}<text>{{paymentBreakdown?paymentBreakdown.laterAnnual:result.chosen.annualTotal}}元</text><view wx:if="{{result.chosen.socialAidAnnual}}" class="payment-detail">自己{{result.chosen.annual}}元＋家人资助{{result.chosen.socialAidAnnual}}元</view><view class="payment-detail">还需交{{result.uncertainty?'最多':''}}{{paymentBreakdown?paymentBreakdown.laterYears:result.chosen.timeline.lockedYear?result.chosen.timeline.futureNormalYears:result.chosen.timeline.normalYears}}年</view><view class="payment-date">{{paymentBreakdown?paymentBreakdown.laterFirstYear:result.chosen.timeline.lockedYear?result.chosen.timeline.futureFirstYear:result.chosen.timeline.firstYear}}—{{paymentBreakdown?paymentBreakdown.laterLastYear:result.chosen.timeline.lastYear}}</view></view>
