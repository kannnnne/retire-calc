ent"><button class="{{form.historyMode!=='segments'?'selected':''}}" data-value="simple" bindtap="historyMode">平均金额</button><button class="{{form.historyMode==='segments'?'selected':''}}" data-value="segments" bindtap="historyMode">分段填写</button></view><picker wx:if="{{form.historyMode!=='segments'}}" range="{{['每年缴费','以前按月缴费']}}" value="{{form.pastMonthly?1:0}}" bindchange="pastPeriod"><view class="control">{{form.pastMonthly?'按月填写，自动乘12':'按年填写'}}</view></picker><view wx:if="{{!form.never && form.historyMode==='segments'}}" class="field"><view class="hint">只填实际缴过的年份；每段视为连续已缴，漏缴年度拆成两段。合计须与已缴年限一致。</view><include src="history-segments.wxml"/><button class="tutorial" bindtap="addSegment">＋ 增加历史阶段</button></view></block></block></block><view class="field"><text>数据截至月份</text><picker mode="date" fields="month" value="{{form.asOf}}" data-key="asOf" bindchange="input"><view class="control">{{form.asOf}}</view></picker></view><view class="field"><text>一次性缴费预算（选填）</text><input class="control" type="digit" value="{{form.budget}}" data-key="budget" bindinput="input" placeholder="留空不限制一次性预算"/></view><view wx:if="{{form.regionId==='440100'}}" class="field"><text>已享受政府补贴合计（未知留空）</text><input class="control" type="digit" value="{{form.usedSubsidy}}" data-key="usedSubsidy" bindinput="input" placeholder="未知时后续补贴保守按0"/></view></block>
