<view class="card single-form pension-form makeup-intake"><view class="card-top"><view class="card-title">以前交过的情况</view><button class="text-button" bindtap="reset">重新填写</button></view>
<region-picker value="{{form.regionId}}" kind="resident" resident-area="{{form.localArea}}" compact bindchange="regionChoice"/>
<view class="entry-row age-entry"><text class="row-label">{{form.ageOnly?'现在年龄':'出生年月'}}</text><view class="row-entry"><view wx:if="{{form.ageOnly}}" class="input-wrap"><input type="number" value="{{form.age}}" data-key="age" bindinput="input"/><text>岁</text></view><picker wx:else mode="date" fields="month" value="{{form.birth}}" data-key="birth" bindchange="input"><view class="control">{{form.birth||'请选择'}}</view></picker></view><button class="age-mode-button" data-value="{{form.ageOnly?'birth':'age'}}" bindtap="ageMode">{{form.ageOnly?'用出生年月':'改填年龄'}}</button></view>
<view wx:if="{{region.areas && !region.hideAreaPicker}}" class="entry-row"><text class="row-label">参保区县</text><picker class="row-entry" range="{{areaLabels}}" value="{{areaIndex}}" bindchange="localArea"><view class="control">{{areaLabels[areaIndex]}}</view></picker></view>
<view wx:if="{{region.residenceRequired}}" class="entry-row"><text class="row-label">参保身份</text><view class="segment row-entry"><button class="{{form.cdResidence==='rural'?'selected':''}}" data-value="rural" bindtap="cdResidence">农村</button><button class="{{form.cdResidence==='urban'?'selected':''}}" data-value="urban" bindtap="cdResidence">城镇</button></view></view>
<view class="entry-row"><text class="row-label">已经交了</text><view class="row-entry input-wrap"><input type="number" value="{{form.years}}" bindinput="moduleYears" placeholder="大概交过几年"/><text>年</text></view></view>
<view wx:if="{{!form.never && !form.historyUncertain && form.historyMode!=='segments' && form.accountMode!=='balance'}}" class="entry-row"><text class="row-label">以前每年交</text><picker class="row-entry" range="{{pastTierLabels}}" value="{{pastTierIndex}}" bindchange="pastTier"><view class="control">{{pastManual?'自己填写':form.pastAnnual+'元／年'}}</view></picker></view><view wx:if="{{pastManual && !form.never && !form.historyUncertain}}" class="entry-row"><text class="row-label">实际交的金额</text><view class="input-wrap row-entry"><input type="digit" value="{{form.pastAnnual}}" data-key="pastAnnual" bindinput="input"/><text>{{form.pastMonthly?'元／月':'元／年'}}</text></view></view>
<view wx:if="{{!form.never}}" class="entry-row"><text class="row-label">今年缴费</text><picker class="row-entry" range="{{['不记得','已含在年数中','还没交']}}" value="{{form.paidThisYear==='yes'?1:form.paidThisYear==='no'?2:0}}" bindchange="modulePaid"><view class="control">{{form.paidThisYear==='yes'?'已含在年数中':form.paidThisYear==='no'?'还没交':'不记得'}}</view></picker></view>
<view wx:if="{{needsCurrentYearTier}}" class="entry-row"><text class="row-label">今年实际年档</text><picker class="row-entry" range="{{currentTierLabels}}" value="{{currentTierIndex}}" bindchange="currentYearTier"><view class="control">{{currentTierLabels[currentTierIndex]}}</view></picker></view>
<view class="entry-row"><text class="row-label">以后每年交</text><picker wx:if="{{!region.annualInput}}" class="row-entry" range="{{futureInputLabels}}" value="{{futureInputIndex}}" bindchange="futureTierChoice"><view class="control">{{futureManual?'自己填写':tierLabels[tierIndex]}}</view></picker><view wx:else class="row-entry input-wrap"><input type="number" value="{{form.tier}}" data-key="tier" bindinput="input"/><text>元</text></view></view><view wx:if="{{futureManual}}" class="entry-row"><text class="row-label">自填年缴</text><view class="row-entry input-wrap"><input type="digit" value="{{futureDraft}}" bindinput="futureDraftInput" bindconfirm="futureSubmit"/><button class="text-button" bindtap="futureSubmit">确定</button></view></view>
<button class="fold settings-fold" bindtap="toggle">按记录细填<text>{{more?'收起 −':'选填 ＋'}}</text></button><block wx:if="{{more}}"><view class="memory-choice"><text>以前交的，记得清吗？</text><view class="segment"><button class="{{!form.historyUncertain?'selected':''}}" data-value="exact" bindtap="historyCertainty">记得清</button><button class="{{form.historyUncertain?'selected':''}}" data-value="rough" bindtap="historyCertainty">先看大概</button></view></view><block wx:if="{{form.historyUncertain}}"><view class="entry-row"><text class="row-label">大概交过</text><view class="row-entry rough-range"><input type="number" value="{{form.roughYearsMin}}" data-key="roughYearsMin" bindinput="roughInput"/><text>到</text><input type="number" value="{{form.roughYearsMax}}" data-key="roughYearsMax" bindinput="roughInput"/><text>年</text></view></view><view class="entry-row"><text class="row-label">以前每年交</text><view class="row-entry rough-range"><input type="digit" value="{{form.roughAnnualMin}}" data-key="roughAnnualMin" bindinput="roughInput"/><text>到</text><input type="digit" value="{{form.roughAnnualMax}}" data-key="roughAnnualMax" bindinput="roughInput"/><text>元</text></view></view></block><button wx:if="{{region.annualInput}}" class="policy-confirm" data-key="localAnnualConfirmed" data-value="{{form.localAnnualConfirmed==='yes'?'unknown':'yes'}}" bindtap="choice">{{form.localAnnualConfirmed==='yes'?'✓ 已核对当地金额':'这个金额在当地可以交'}}</button></block>
<include src="makeup-details.wxml"/>
<view wx:if="{{needsTransition}}" class="hint">可能涉及以前的领取办法，先确认是否按普通逐年缴费参考。</view><button wx:if="{{needsTransition}}" class="policy-confirm" data-key="transition" data-value="{{form.transition==='no'?'unknown':'no'}}" bindtap="choice">{{form.transition==='no'?'✓ 先按普通逐年缴费参考':'先按普通逐年缴费参考'}}</button><view wx:if="{{needsExtended}}" class="hint">已满65岁，补足资格需向当地确认。未确认可先查缴费记录。</view><button wx:if="{{needsExtended}}" class="policy-confirm" data-key="extended" data-value="{{form.extended==='yes'?'unknown':'yes'}}" bindtap="choice">{{form.extended==='yes'?'✓ 已核对延缴补足资格':'我已向社保核对延缴补足资格'}}</button><view wx:if="{{error}}" class="error" role="alert">{{error}}</view></view>
<button class="basic-shortcut" bindtap="openRecordHelp">不知道以前交了多少？查看怎么查 ›</button><view class="submit-dock"><button class="primary" bindtap="moduleCalculate">查看补缴方案</button></view>
