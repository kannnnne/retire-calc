<view class="card single-form"><view class="card-top"><view class="card-title">补缴方案 <button class="info-trigger" bindtap="resultInfo" aria-label="查看补缴说明">!</button></view><button class="text-button" bindtap="moduleEdit">修改资料</button></view><view wx:if="{{quickPlan.error}}" class="error">{{quickPlan.error}}</view><block wx:if="{{quickPlan.summary}}"><view class="quick-income"><view wx:if="{{quickPlan.dirty}}" class="choice-note">当前结果 · 修改尚未计算</view><view class="pension-label">补缴后，每月约领</view><view class="pension-value">{{quickPlan.summary.monthly}}<text>元</text></view><view class="pension-start">{{quickPlan.summary.receipt}}起领参考</view></view><view class="payment-grid"><view>现在需交<text>{{quickPlan.display.now}}元</text><view class="payment-detail">{{quickPlan.summary.added?'补'+quickPlan.summary.added+'年':'年数已够'}}<block wx:if="{{quickPlan.summary.upgraded}}"> · 提高{{quickPlan.summary.upgraded}}年档次</block></view></view><view wx:if="{{quickPlan.summary.laterYears}}">以后每年交<text>{{quickPlan.display.later}}元</text><view class="payment-detail">还交{{quickPlan.summary.laterYears}}年 · {{quickPlan.summary.laterFirstYear}}—{{quickPlan.summary.laterLastYear}}</view></view></view><view class="total-row"><text>还需交</text><text>{{quickPlan.display.total}}元</text></view>
<view class="option-heading">换个每月领取金额</view><view class="income-choices"><button wx:for="{{quickPlan.options}}" wx:key="tier" class="income-choice {{(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined?quickPlan.tier:quickPlan.pendingTier)===item.tier && !quickPlan.custom?'active':''}}" data-tier="{{item.tier}}" bindtap="selectQuick"><view>约 <text>{{item.monthly}}</text> 元／月</view><view class="choice-note">年档{{item.tier}}元{{(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined?quickPlan.tier:quickPlan.pendingTier)===item.tier?(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined?' · 当前方案':' · 待确认'):''}}</view></button></view><view wx:if="{{quickPlan.canChooseTiming}}" class="segment"><button class="{{(quickPlan.pendingMode||quickPlan.mode)==='TO_SIXTY'?'selected':''}}" data-mode="TO_SIXTY" bindtap="selectQuickMode">到60岁交够</button><button class="{{(quickPlan.pendingMode||quickPlan.mode)==='NOW'?'selected':''}}" data-mode="NOW" bindtap="selectQuickMode">现在补够</button></view>
<button class="primary confirm-plan" bindtap="confirmQuick" disabled="{{(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined) && !quickPlan.pendingMode}}">按所选方案计算</button><button class="fold" bindtap="quickDetails">调整各年金额<text>{{quickPlan.details?'收起 −':'展开 ＋'}}</text></button><include src="makeup-adjust.wxml"/><button class="basic-shortcut" bindtap="openPaymentPlanner">改按实际年份填写 ›</button><button wx:if="{{quickPlan.draft.rows.length}}" class="eligibility-check {{quickPlan.confirmed?'checked':''}}" bindtap="quickConfirm"><text>{{quickPlan.confirmed?'✓':'○'}}</text>已与社保核对记录、可补年份和补贴，尚未领取养老金</button><button class="primary" bindtap="applyMaxPlan">{{quickPlan.draft.rows.length?'核对后使用方案':'使用这个缴费档次'}}</button></block><button wx:else class="primary" bindtap="quickRefresh">更新方案</button></view>
