<block wx:if="{{quickPlan.summary}}"><view class="quick-result">
<view class="quick-income"><view class="income-top"><text class="pension-label">补缴后，每月约领</text><button class="info-trigger" bindtap="resultInfo" aria-label="查看补缴参考说明">!</button></view><view class="pension-value">{{quickPlan.summary.monthly}}<text>元</text></view><view class="pension-start">{{quickPlan.summary.receipt}}起领 · 补缴参考</view></view>
<view class="card payment-card"><view class="card-title">接下来这样交</view><view class="payment-condition">已交{{quickPlan.summary.paid}}年 · 补{{quickPlan.summary.added}}年<text wx:if="{{quickPlan.summary.laterYears}}"> · 再交{{quickPlan.summary.laterYears}}年</text></view><view class="payment-grid"><view>现在需交<text>{{quickPlan.display.now}}元</text><view class="payment-detail" wx:if="{{quickPlan.summary.upgraded}}">含{{quickPlan.summary.upgraded}}年提档补差</view></view><view wx:if="{{quickPlan.summary.laterYears}}">以后每年交<text>{{quickPlan.display.later}}元</text><view class="payment-detail">{{quickPlan.summary.laterFirstYear}}—{{quickPlan.summary.laterLastYear}}年</view></view></view><view class="total-row"><text>还需交</text><text>{{quickPlan.display.total}}元</text></view>
<button class="fold result-fold" data-key="quickChoicesOpen" bindtap="fold"><view>换个方案</view><text>{{quickChoicesOpen?'收起 −':'选择 ›'}}</text></button>
<view wx:if="{{quickChoicesOpen}}" class="section-body"><view class="option-heading">想每月领多少？</view><view class="income-choices"><button wx:for="{{quickPlan.options}}" wx:key="tier" class="income-choice {{(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined?quickPlan.tier:quickPlan.pendingTier)===item.tier && !quickPlan.custom?'active':''}}" data-tier="{{item.tier}}" bindtap="selectQuick"><view>约 <text>{{item.monthly}}</text> 元／月</view><view class="choice-note">{{(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined?quickPlan.tier:quickPlan.pendingTier)===item.tier?(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined?'当前方案':'待确认'):'选择'}}</view></button></view><view wx:if="{{quickPlan.canChooseTiming}}" class="segment"><button class="{{(quickPlan.pendingMode||quickPlan.mode)==='TO_SIXTY'?'selected':''}}" data-mode="TO_SIXTY" bindtap="selectQuickMode">到60岁交够</button><button class="{{(quickPlan.pendingMode||quickPlan.mode)==='NOW'?'selected':''}}" data-mode="NOW" bindtap="selectQuickMode">现在补够</button></view><view wx:if="{{quickPlan.error}}" class="error" role="alert">{{quickPlan.error}}</view><button class="primary confirm-plan" bindtap="confirmQuick" disabled="{{(quickPlan.pendingTier===null || quickPlan.pendingTier===undefined) && !quickPlan.pendingMode}}">按所选方案计算</button></view></view>
<view class="card result-section compact-folds"><button class="fold result-fold" bindtap="quickDetails"><view>缴费明细</view><text>{{quickPlan.details?'收起 −':'查看 ›'}}</text></button><block wx:if="{{quickPlan.details}}"><view class="hint">{{quickPlan.config.inferred?'已按最近年份匹配，请核对实际记录。':'按已填年份计算。'}}补缴资格与历史档次需当地确认。</view><include src="makeup-adjust.wxml"/><button class="basic-shortcut" bindtap="openPaymentPlanner">修改已交年份 ›</button><button wx:if="{{quickPlan.draft.rows.length}}" class="eligibility-check {{quickPlan.confirmed?'checked':''}}" bindtap="quickConfirm"><text>{{quickPlan.confirmed?'✓':'○'}}</text>已向社保核对可补年份、档次和补贴</button><button class="secondary" bindtap="applyMaxPlan">保存已核对的方案</button></block></view>
<view class="submit-dock result-dock"><view class="result-actions"><button class="secondary restart-button" bindtap="reset">重新填写</button><button class="primary" bindtap="moduleEdit">修改信息</button></view></view></view>
</block><view wx:else class="card"><view class="error">{{quickPlan.error}}</view><button class="primary" bindtap="moduleEdit">返回修改信息</button></view>