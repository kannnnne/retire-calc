<view class="dock"><button wx:for="{{items}}" wx:key="key" hover-class="nav-pressed" hover-stay-time="80" class="nav-button {{active===item.key?'selected':''}}" data-key="{{item.key}}" bindtap="go" aria-label="{{item.label}}"><image class="nav-glyph" src="{{active===item.key?item.selectedIcon:item.icon}}" mode="aspectFit" aria-hidden="true"/><text>{{item.label}}</text></button></view>
