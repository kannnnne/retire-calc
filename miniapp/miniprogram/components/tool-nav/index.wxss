.dock{position:fixed;bottom:0;left:0;right:0;z-index:20;display:flex;padding:10rpx 20rpx calc(10rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e3e8ef}.dock .nav-button{flex:1;background:transparent;color:#576579;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:96rpx;font-size:25rpx;line-height:1.4;padding:8rpx 4rpx;border-radius:10rpx;margin:0}.nav-button::after{border:0}.dock .selected{color:#2463eb;background:#f0f5ff;font-weight:600}.nav-glyph{width:42rpx;height:42rpx;margin:0 auto 6rpx;flex:none}
.dock .nav-button{position:relative;transition:color var(--motion-press) ease,background-color var(--motion-press) ease}.dock .nav-button.nav-pressed{background:#eaf1fd}.dock .selected::before{content:'';position:absolute;top:2rpx;left:calc(50% - 14rpx);width:28rpx;height:4rpx;background:currentColor;border-radius:4rpx}.dock .selected{background:#f4f7fe}@media(prefers-reduced-motion:reduce){.dock .nav-button{transition:none}}
