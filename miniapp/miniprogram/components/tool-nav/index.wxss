.dock{position:fixed;bottom:0;left:0;right:0;z-index:20;display:flex;padding:10rpx 20rpx calc(10rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e3e8ef}.dock .nav-button{flex:1;background:transparent;color:#576579;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:96rpx;font-size:25rpx;line-height:1.4;padding:8rpx 4rpx;border-radius:10rpx;margin:0}.nav-button::after{border:0}.dock .selected{color:#2463eb;background:#f0f5ff;font-weight:600}.nav-icon{width:30rpx;height:30rpx;border:3rpx solid currentColor;border-radius:5rpx;box-sizing:border-box;margin:0 auto 8rpx;position:relative}.home-icon{border-radius:8rpx 8rpx 4rpx 4rpx}.home-icon::after{content:"";position:absolute;left:9rpx;bottom:0;width:6rpx;height:12rpx;background:currentColor}.calc-icon::before{content:"";position:absolute;left:4rpx;right:4rpx;top:4rpx;height:5rpx;background:currentColor}.calc-icon::after{content:"";position:absolute;left:4rpx;right:4rpx;bottom:4rpx;border-top:3rpx dotted currentColor}.plan-icon::after{content:"";position:absolute;left:5rpx;right:5rpx;top:6rpx;height:7rpx;border-top:3rpx solid currentColor;border-bottom:3rpx solid currentColor}
.dock .nav-button{position:relative;transition:color var(--motion-press) ease,background-color var(--motion-press) ease}.dock .nav-button.nav-pressed{background:#eaf1fd}.dock .selected::before{content:'';position:absolute;top:2rpx;left:calc(50% - 14rpx);width:28rpx;height:4rpx;background:currentColor;border-radius:4rpx}.dock .selected{background:#f4f7fe}@media(prefers-reduced-motion:reduce){.dock .nav-button{transition:none}}
