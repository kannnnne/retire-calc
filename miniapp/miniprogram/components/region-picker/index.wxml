<view class="region-panel"><view class="region-heading"><text>{{kind==='resident'?'户籍地区':'领取地区'}}</text><button class="region-policy" bindtap="policy">当地政策 ›</button></view><view class="region-pickers"><picker class="region-picker-item" range="{{provinces}}" value="{{provinceIndex}}" bindchange="province"><view class="region-control">{{provinces[provinceIndex]}}<view class="chevron"/></view></picker><picker class="region-picker-item" range="{{cityLabels}}" value="{{cityIndex}}" bindchange="city"><view class="region-control">{{cityLabels[cityIndex]}}<view class="chevron"/></view></picker></view><view wx:if="{{referenceLabel && !pending}}" class="region-reference"><view class="reference-row"><text>{{referenceLabel}}</text><button class="reference-toggle" bindtap="reference">{{referenceOpen?'收起 −':'说明 ＋'}}</button></view><text wx:if="{{referenceOpen}}">{{referenceText}}</text></view><view wx:if="{{pending}}" class="region-pending">{{kind==='employee'?'该地区暂未开放':'当地规则核对中'}}<view class="region-pending-detail">{{reason}}</view></view></view>
