<view class="region-panel"><view class="region-heading"><text>{{kind==='resident'?'户籍地区':'领取地区'}}</text><button bindtap="policy">当地政策 ›</button></view><view class="region-pickers"><picker range="{{provinces}}" value="{{provinceIndex}}" bindchange="province"><view class="region-control">{{provinces[provinceIndex]}}<view class="chevron"/></view></picker><picker range="{{cityLabels}}" value="{{cityIndex}}" bindchange="city"><view class="region-control">{{cityLabels[cityIndex]}}<view class="chevron"/></view></picker></view><view wx:if="{{pending}}" class="region-pending">当地规则核对中<view>{{reason}}</view></view></view>
