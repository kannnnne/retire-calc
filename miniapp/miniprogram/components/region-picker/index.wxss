.region-panel{margin-bottom:28rpx}.region-heading{display:flex;align-items:center;justify-content:space-between;font-size:25rpx;color:#65718a;margin-bottom:12rpx}.region-policy{margin:0;padding:8rpx 0 8rpx 24rpx;background:transparent;color:#2463eb;font-size:24rpx;line-height:1.5}.region-policy::after{border:0}.region-pickers{display:flex;gap:16rpx}.region-picker-item{flex:1;min-width:0}.region-control{min-height:88rpx;padding:0 24rpx;background:#fff;border:1rpx solid #e1e6ee;border-radius:16rpx;display:flex;align-items:center;justify-content:space-between;color:#26354d;font-size:28rpx}.region-control-text{font-size:30rpx;color:#7083a6;margin-left:12rpx}.region-pending{margin-top:20rpx;padding:24rpx;background:#f1f5fb;border-radius:16rpx;color:#26354d;font-size:27rpx;line-height:1.6}.region-pending-detail{font-size:25rpx;color:#65718a;margin-top:8rpx}
.chevron{width:12rpx;height:12rpx;border-right:3rpx solid #7083a6;border-bottom:3rpx solid #7083a6;transform:rotate(45deg);margin-left:16rpx;margin-top:-6rpx}

.region-reference{margin-top:16rpx;padding:20rpx 24rpx;background:#edf4ff;border-radius:14rpx;line-height:1.55;font-size:24rpx;color:#435879}.region-reference-heading{font-size:25rpx;font-weight:600;color:#245cb4;margin-bottom:6rpx}

.region-reference .reference-row{display:flex;justify-content:space-between;align-items:center;margin:0;gap:16rpx}.reference-toggle{background:transparent;color:#245cb4;font-size:24rpx;line-height:1.5;min-height:72rpx;margin:-12rpx 0;padding:12rpx 0 12rpx 16rpx;white-space:nowrap}.reference-toggle::after{border:0}
