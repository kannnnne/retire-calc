.home-shell{padding-top:36rpx;display:flex;flex-direction:column;min-height:100vh;box-sizing:border-box;padding-bottom:calc(138rpx + env(safe-area-inset-bottom))}.home-intro{padding:20rpx 4rpx 36rpx;animation:soft-appear var(--motion-enter) ease-out both}.home-brand{font-size:48rpx;font-weight:650;line-height:1.45;letter-spacing:1rpx;color:var(--ink);overflow-wrap:anywhere}.home-caption{font-size:28rpx;color:var(--muted);margin-top:16rpx;line-height:1.8}.home-section{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:24rpx 4rpx 20rpx;font-size:29rpx;font-weight:600}.coverage-note{font-size:24rpx;font-weight:400;color:var(--muted)}.tool-list{animation:soft-appear var(--motion-enter) ease-out both}.tool-card{width:100%!important;display:flex!important;align-items:center;gap:24rpx;padding:32rpx 26rpx;min-height:176rpx;border:1rpx solid var(--line);border-radius:20rpx;background:#fff;text-align:left;margin:0 0 20rpx;transition:transform var(--motion-press) ease,background-color var(--motion-press) ease,border-color var(--motion-press) ease}.tool-card.tool-pressed{transform:scale(.985);background:#f0f5ff;border-color:#b7ccf3}.tool-main{flex:1;min-width:0}.tool-name{font-size:35rpx;font-weight:600;color:var(--ink);line-height:1.5}.tool-sub{font-size:26rpx;color:var(--muted);margin-top:8rpx;line-height:1.6}.entry-arrow{font-size:44rpx;color:#72849e;flex:none}.entry-icon{position:relative;width:80rpx;height:80rpx;flex:none;background:#edf4ff;color:var(--brand);border-radius:18rpx}.employee-entry .icon-head{position:absolute;top:20rpx;left:32rpx;width:16rpx;height:16rpx;border:3rpx solid currentColor;border-radius:50%;box-sizing:border-box}.employee-entry .icon-body{position:absolute;top:43rpx;left:23rpx;width:34rpx;height:21rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:18rpx 18rpx 0 0;box-sizing:border-box}.resident-entry{background:#eef2f9;color:#486a9b}.resident-entry .icon-head{position:absolute;left:23rpx;top:20rpx;width:34rpx;height:42rpx;border:3rpx solid currentColor;border-radius:6rpx;box-sizing:border-box}.resident-entry .icon-head::before{content:'';position:absolute;left:5rpx;right:5rpx;top:8rpx;border-top:3rpx solid currentColor}.resident-entry .icon-head::after{content:'';position:absolute;left:5rpx;right:5rpx;bottom:7rpx;height:7rpx;border-top:3rpx solid currentColor;border-bottom:3rpx dotted currentColor}.home-bottom{margin-top:auto;padding-top:64rpx}.help-row{display:flex;align-items:center;justify-content:center;align-self:center;min-height:88rpx;font-size:25rpx;color:var(--muted);padding:16rpx 24rpx;border-radius:12rpx;transition:background-color var(--motion-press) ease}.row-pressed{background:#edf2fa}@media(prefers-reduced-motion:reduce){.home-intro,.tool-list{animation:none}.tool-card,.help-row{transition:none}.tool-card.tool-pressed{transform:none}}
