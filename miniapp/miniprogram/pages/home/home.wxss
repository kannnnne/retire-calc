.home-shell{padding-top:36rpx;display:flex;flex-direction:column;min-height:100vh;box-sizing:border-box;padding-bottom:calc(138rpx + env(safe-area-inset-bottom))}.home-intro{padding:20rpx 4rpx 36rpx;animation:soft-appear var(--motion-enter) ease-out both}.home-brand{font-size:48rpx;font-weight:650;line-height:1.45;letter-spacing:1rpx;color:var(--ink);overflow-wrap:anywhere}.home-caption{font-size:28rpx;color:var(--muted);margin-top:16rpx;line-height:1.8}.home-section{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:24rpx 4rpx 20rpx;font-size:29rpx;font-weight:600}.coverage-note{font-size:24rpx;font-weight:400;color:var(--muted)}.tool-list{animation:soft-appear var(--motion-enter) ease-out both}.tool-card{width:100%!important;display:flex!important;align-items:center;gap:24rpx;padding:32rpx 26rpx;min-height:176rpx;border:1rpx solid var(--line);border-radius:28rpx;background:#fff;text-align:left;margin:0 0 20rpx;transition:transform var(--motion-press) ease,background-color var(--motion-press) ease,border-color var(--motion-press) ease}.tool-card.tool-pressed{transform:scale(.985);background:#f0f5ff;border-color:#b7ccf3}.tool-main{flex:1;min-width:0}.tool-name{font-size:35rpx;font-weight:600;color:var(--ink);line-height:1.5}.tool-sub{font-size:26rpx;color:var(--muted);margin-top:8rpx;line-height:1.6}.entry-arrow{font-size:44rpx;color:#72849e;flex:none}.entry-icon{position:relative;width:80rpx;height:80rpx;flex:none;background:#edf4ff;color:var(--brand);border-radius:28rpx}.entry-icon{display:flex;align-items:center;justify-content:center;background:#edf4ff}.tool-glyph{width:54rpx;height:54rpx}.home-bottom{margin-top:auto;padding-top:64rpx}.help-row{display:flex;align-items:center;justify-content:center;align-self:center;min-height:88rpx;font-size:25rpx;color:var(--muted);padding:16rpx 24rpx;border-radius:20rpx;transition:background-color var(--motion-press) ease}.row-pressed{background:#edf2fa}@media(prefers-reduced-motion:reduce){.home-intro,.tool-list{animation:none}.tool-card,.help-row{transition:none}.tool-card.tool-pressed{transform:none}}

.tool-card{border-radius:28rpx;min-height:164rpx;box-shadow:0 6rpx 20rpx rgba(29,47,76,.035)}.entry-icon{border-radius:24rpx;width:84rpx;height:84rpx}.tool-glyph{width:52rpx;height:52rpx}.help-row{border:1rpx solid #dce4ef;background:#fff;border-radius:999rpx;padding:14rpx 30rpx;min-height:44px}
.help-row{margin-left:auto;margin-right:auto}

.home-bottom .help-row{border:0;border-radius:0;background:transparent;box-shadow:none;font-size:25rpx;min-height:44px;padding:12rpx 20rpx;color:var(--muted)}
