<view class="shell home-shell"><view class="home-intro"><view class="home-brand">{{brand.name}}</view><view class="home-caption">{{brand.caption}}</view></view>
<view class="home-section"><text>养老计算</text><text class="coverage-note">当前支持广州</text></view><view class="tool-list"><button wx:for="{{tools}}" wx:key="id" class="tool-card" hover-class="tool-pressed" hover-stay-time="100" data-id="{{item.id}}" bindtap="open" aria-label="{{item.title}}，{{item.subtitle}}"><view class="entry-icon {{item.id==='resident'?'resident-entry':'employee-entry'}}" aria-hidden="true"><view class="icon-head"></view><view class="icon-body"></view></view><view class="tool-main"><view class="tool-name">{{item.title}}</view><view class="tool-sub">{{item.subtitle}}</view></view><view class="entry-arrow" aria-hidden="true">›</view></button></view>
<view class="home-bottom"><button class="help-row" hover-class="row-pressed" bindtap="help">使用说明与隐私</button></view></view><tool-nav active="home"/>
