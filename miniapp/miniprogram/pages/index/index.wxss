.employee-form{padding:24rpx}.entry-row{display:flex;align-items:center;gap:18rpx;min-height:96rpx;padding:16rpx 0;border-bottom:1rpx solid var(--line)}.row-label{width:170rpx;flex:none;font-size:29rpx}.row-entry{flex:1;min-width:0}.entry-row .control,.entry-row .input-wrap{margin-top:0;min-height:88rpx;font-size:29rpx}.employee-form .segment button{width:50%!important;min-height:88rpx;font-size:28rpx}.default-note{font-size:25rpx;margin-top:12rpx}.small-help{width:100%!important;min-height:88rpx;display:flex;align-items:center;color:var(--brand);font-size:27rpx;text-align:left}.estimate-summary{padding:22rpx;background:#f1f6ff;border-radius:12rpx;margin-top:20rpx;font-size:28rpx}.estimate-summary text{display:block;font-size:36rpx;color:var(--brand);font-weight:600;margin:8rpx 0}.estimate-summary .hint{margin-top:10rpx}.employee-income{padding:30rpx;border:1rpx solid #dce8ff;background:#edf4ff;border-radius:20rpx}.receive-tag{display:inline-block;color:var(--brand);background:#fff;border-radius:10rpx;padding:10rpx 16rpx;font-size:26rpx;font-weight:600}.income-label{font-size:30rpx;margin-top:24rpx}.income-value{font-size:76rpx;font-weight:700;color:var(--brand);line-height:1.3;margin-top:10rpx}.income-value text{font-size:30rpx;font-weight:400;margin-left:12rpx}.payment-grid{display:flex;gap:16rpx;margin-top:24rpx}.payment-grid>view{flex:1;min-width:0;padding:20rpx 10rpx;background:#f6f8fc;border-radius:12rpx;text-align:center;font-size:27rpx}.payment-grid text{display:block;font-size:33rpx;font-weight:600;margin-top:12rpx}.full-width,.first-fold,.plan-choice{width:100%!important}.first-fold{margin:0;border:0;padding:0;min-height:88rpx}.plan-choice{padding:22rpx;border:2rpx solid var(--line);border-radius:12rpx;margin-top:18rpx;text-align:left}.plan-choice>view:first-child{display:flex;justify-content:space-between;gap:10rpx;font-size:28rpx}.plan-choice text{color:var(--brand);font-size:25rpx}.chosen-plan{background:#f1f6ff;border-color:var(--brand)}.plan-monthly{f