.employee-form{padding:24rpx}.employee-form .segment button{width:50%!important;min-height:88rpx;font-size:28rpx}.default-note{font-size:25rpx;margin-top:12rpx}.small-help{width:100%!important;min-height:88rpx;display:flex;align-items:center;color:var(--brand);font-size:27rpx;text-align:left}.estimate-summary{padding:22rpx;background:#f1f6ff;border-radius:12rpx;margin-top:20rpx;font-size:28rpx}.estimate-summary text{display:block;font-size:36rpx;color:var(--brand);font-weight:600;margin:8rpx 0}.estimate-summary .hint{margin-top:10rpx}.full-width,.first-fold,.plan-choice{width:100%!important}.first-fold{margin:0;border:0;padding:0;min-height:88rpx}.plan-choice{padding:22rpx;border:2rpx solid var(--line);border-radius:12rpx;margin-top:18rpx;text-align:left}.plan-choice>view:first-child{display:flex;justify-content:space-between;gap:10rpx;font-size:28rpx}.plan-choice text{color:var(--brand);font-size:25rpx}.chosen-plan{background:#f1f6ff;border-color:var(--brand)}.plan-monthly{font-size:35rpx;font-weight:600;color:var(--brand);margin-top:14rpx}.detail-text{font-size:27rpx;line-height:1.9}.detail-text>view{margin-top:18rpx}

.compact-section{padding:12rpx 0 22rpx;margin-top:18rpx;border-top:1rpx solid var(--line)}.compact-heading{width:100%!important;display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:104rpx;padding:14rpx 0;text-align:left;background:transparent}.compact-title{font-size:30rpx;font-weight:600;flex:none}.compact-values{display:flex;align-items:center;justify-content:flex-end;gap:16rpx;min-width:0}.compact-amount{font-size:32rpx;color:var(--brand);font-weight:600;overflow-wrap:anywhere}.compact-change{font-size:25rpx;color:var(--muted);flex:none}.compact-note{font-size:25rpx;line-height:1.6;color:var(--muted)}.compact-editor{padding:8rpx 0 2rpx}.compact-editor .segment{margin-top:12rpx}.estimate-details{margin-top:18rpx;padding:0;background:transparent}.estimate-details .hint{margin-top:12rpx}.plan-entry .row-label{width:190rpx}.plan-entry .control{border:0;padding-right:0;background:transparent;font-size:27rpx}.plan-entry{padding:8rpx 0}.plan-entry picker{flex:1;min-width:0}

/* Keep groups distinct without stacking row borders and field borders. */
.employee-form>.card-top{margin-bottom:0}.employee-form>.hint{font-size:25rpx;margin-top:8rpx}.basic-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:24rpx}.basic-field{min-width:0}.basic-label{font-size:27rpx;color:var(--muted);margin-bottom:10rpx}.basic-field .control{font-size:27rpx;margin:0;padding-left:16rpx;padding-right:18rpx;white-space:nowrap}.future-label{margin-top:22rpx}.future-section{border-top:0;margin-top:0;padding-top:0;padding-bottom:8rpx}.compact-heading{min-height:88rpx}.account-basis{margin-bottom:6rpx;color:#405978}.plan-entry{border:0!important;padding:6rpx 0!important}.plan-entry .row-label{width:138rpx}.plan-entry .control{border:0!important;background:transparent;padding-left:0;padding-right:18rpx;font-size:28rpx;min-height:88rpx}.default-note{margin:0 0 8rpx;font-size:24rpx}.employee-form .auto-summary{margin-top:12rpx}.employee-form .compact-section:not(.future-section){padding-bottom:12rpx}

.income-top{display:flex;align-items:center;justify-content:space-between}.info-trigger{position:relative;display:inline-flex!important;align-items:center;justify-content:center;width:88rpx!important;min-height:88rpx;padding:0;font-size:25rpx;font-weight:600;color:var(--muted);background:transparent;flex-shrink:0}.info-trigger::before{content:"";position:absolute;width:32rpx;height:32rpx;border:2rpx solid currentColor;border-radius:50%}.info-trigger::after{border:0}.label-with-info{display:flex;align-items:center;justify-content:space-between;min-height:48rpx}.label-with-info .info-trigger{margin:-20rpx -16rpx -20rpx 0}.income-top .info-trigger{margin:-18rpx -16rpx -18rpx 0}.payment-condition{color:var(--muted);font-size:27rpx;line-height:1.6;margin:14rpx 0}.scope-tag{font-size:24rpx;color:var(--muted);margin-top:16rpx}.short-result{font-size:34rpx;margin-top:18rpx}.confirm-plan{margin-top:24rpx}.confirm-plan[disabled]{background:#edf1f7;color:#66758b}.section-body{padding-top:16rpx}.payment-card .total-row{margin-bottom:0}.compact-section.future-section{margin-top:28rpx}.quiet-info{font-size:25rpx;color:var(--muted);min-height:88rpx;padding:12rpx 0;text-align:left}
