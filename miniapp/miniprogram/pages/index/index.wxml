<view class="shell {{!result?'has-submit':''}}"><view wx:if="{{editingResult && !result}}" class="edit-return"><button bindtap="cancelResultEdit">取消修改，返回原结果</button></view><view class="mast"><view class="title">职工养老</view><button wx:if="{{result}}" class="result-region-link" bindtap="toggleRegion" aria-label="更换领取地区"><text>{{result.region}}</text><text>{{regionOpen?'收起 −':'更换 ›'}}</text></button></view>
<region-picker wx:if="{{!result || regionOpen}}" value="{{form.regionId||'440100'}}" kind="employee" bindchange="regionChanged"/>
<block wx:if="{{!result && regionReady}}"><view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<view class="card employee-form pension-form"><view class="card-top"><view class="card-title">参保信息</view><button class="text-button" bindtap="requestResultReset">重新填写</button></view><view wx:if="{{isDemo}}" class="notice-box field">以下是示例数据，请按实际情况修改。</view>
<checkbox-group wx:if="{{form.regionId==='440300'}}" bindchange="szScope"><label class="switch-row"><checkbox value="yes" checked="{{form.szScopeConfirmed==='yes'}}" color="#2463eb"/>非深户，深圳实缴满10年、在此领取，无地方补充权益</label></checkbox-group><view class="basic-grid"><view class="basic-field"><view class="basic-label">出生年月</view><picker mode="date" fields="month" start="{{dateBounds.birthStart}}" end="{{dateBounds.birthEnd}}" value="{{form.birthMonth}}" data-key="birthMonth" bindchange="input"><view class="control">{{form.birthMonth}}</view></picker></view><view wx:if="{{!tibet}}" class="basic-field"><view class="basic-label label-with-info">退休类别<button class="info-trigger" data-key="category" bindtap="info" aria-label="查看退休类别说明">?</button></view><picker range="{{categoryLabels}}" value="{{categoryIndex}}" bindchange="category"><view class="control">{{categoryLabels[categoryIndex]}}</view></picker></view><view wx:if="{{tibet}}" class="basic-field"><view class="basic-label">核对后的退休年月</view><picker mode="date" fields="month" start="{{form.dataAsOf}}" end="{{retirementEnd}}" value="{{form.tibetRetirementMonth}}" data-key="tibetRetirementMonth" bindchange="input"><view class="control">{{form.tibetRetirementMonth||'请选择'}}</view></picker></view></view>
<block wx:if="{{tibet}}"><view class="entry-row"><text class="row-label">退休时在藏工作</text><view class="input-wrap row-entry"><input type="digit" value="{{form.tibetWorkYears}}" data-key="tibetWorkYears" bindinput="input" placeholder="按核对的实际年数"/><text>年</text></view></view><button class="quiet-info" data-key="tibet" bindtap="info">适用范围 ⓘ</button><checkbox-group bindchange="tibetScope"><label class="switch-row"><checkbox value="yes" checked="{{form.tibetScopeConfirmed==='yes'}}" color="#2463eb"/>已核对：在西藏领取、上述退休年月及最低缴费{{tibetMinimumYears}}年；无视同或特殊历史权益</label></checkbox-group></block><view class="form-section-title">已经交的</view><view class="entry-row"><text class="row-label">开始缴费</text><picker class="row-entry" mode="date" fields="month" start="{{firstStart}}" end="{{firstEnd}}" value="{{form.firstInsuredMonth}}" data-key="firstInsuredMonth" bindchange="input"><view class="control">{{form.firstInsuredMonth||'请选择'}}</view></picker></view>
<view class="entry-row"><text class="row-label">停交情况</text><picker class="row-entry" range="{{paidModeLabels}}" value="{{paidModeIndex}}" bindchange="paidMode"><view class="control">{{paidModeLabels[paidModeIndex]}}</view></picker></view>
<view wx:if="{{paidModeIndex===1}}" class="entry-row"><text class="row-label">一共停交</text><view class="input-wrap row-entry"><input type="number" value="{{gapMonths}}" bindinput="gapInput" placeholder="停交月数"/><text>个月</text></view></view>
<view wx:if="{{paidModeIndex===2}}" class="entry-row"><text class="row-label">已交月数</text><view class="input-wrap row-entry"><input type="number" value="{{form.paidMonths}}" data-key="paidMonths" bindinput="input" placeholder="查询记录里的月数"/><text>个月</text></view></view>
<view wx:if="{{form.paidMonths!==''}}" class="auto-summary"><text>累计已交</text><text>{{form.paidMonths}}个月</text></view>
<view class="compact-section"><button class="compact-heading" data-section="accountOpen" bindtap="toggleSection"><text class="compact-title">个人账户{{accountMode==='estimate'?'（估）':''}}</text><view class="compact-values"><view class="compact-amount">{{accountMode==='estimate'?'约':''}}{{accountSummary||'待填写'}}{{accountSummary?'元':''}}</view><text class="compact-change">{{accountOpen?'收起 −':'修改 ›'}}</text></view></button><view wx:if="{{accountOpen && accountMode==='estimate'&&accountEstimate}}" class="compact-note account-basis">每月入账{{accountEstimate.monthly}}元 × 已交{{form.paidMonths}}个月</view><view wx:if="{{accountOpen && accountMode==='estimate'}}" class="compact-note">{{estimateModeIndex===0?'按当前最低档估算，未计历年变化和利息。':'用历史平均金额估算，未加利息。'}}</view><view wx:if="{{accountOpen}}" class="compact-editor"><view class="segment field"><button class="{{accountMode==='estimate'?'selected':''}}" data-value="estimate" bindtap="accountMode">帮我估</button><button class="{{accountMode==='known'?'selected':''}}" data-value="known" bindtap="accountMode">填查询金额</button></view>
<block wx:if="{{accountMode==='estimate'}}"><view class="field"><text>以前大概怎么交</text><picker range="{{['按当前最低档粗算','填以前平均每月养老扣款','填以前平均每月缴费工资']}}" value="{{estimateModeIndex}}" bindchange="estimateMode"><view class="control">{{['按当前最低档粗算','平均每月养老个人扣款','平均每月缴费工资'][estimateModeIndex]}}</view></picker></view>
<view wx:if="{{estimateModeIndex>0}}" class="field"><text>{{estimateModeIndex===1?'以前每月平均养老个人扣款':'以前每月平均缴费工资'}}</text><view class="input-wrap"><input type="digit" value="{{estimateInput}}" bindinput="estimateInput" placeholder="大概金额"/><text>元</text></view><view class="hint">{{estimateModeIndex===1?'只填职工养老个人扣款，不含医保、公积金或灵活就业20%全额。':'填缴费工资，不是到手收入；账户按8%计入。'}}</view></view>
<view wx:if="{{accountEstimate}}" class="estimate-details"><view class="hint">每月入账{{accountEstimate.monthly}}元 × {{form.paidMonths}}个月</view><view class="hint">{{accountEstimate.note}}</view></view><view wx:else class="hint field">{{accountError}}</view></block>
<block wx:else><view class="field"><text>已划入账户金额（不含利息）</text><view class="input-wrap"><input type="digit" value="{{form.principal}}" data-key="principal" bindinput="input" placeholder="填查询到的金额"/><text>元</text></view></view><button class="small-help" bindtap="accountHelp">账户金额去哪查？ ›</button></block>
</view></view>
<view class="compact-section future-section"><button class="compact-heading" data-section="paymentOpen" bindtap="toggleSection"><text class="compact-title">自己每月交</text><view class="compact-values"><view class="compact-amount">{{futurePayment||'待填写'}}{{futurePayment!==''?'元':''}}</view><text class="compact-change">{{paymentOpen?'收起 −':'修改 ›'}}</text></view></button><view wx:if="{{paymentOpen}}" class="compact-editor"><button class="small-help" bindtap="openFlexible">离职后自己交？去灵活就业养老 ›</button>
<view wx:if="{{planIndex===0||planIndex===3}}" class="field"><text>每月缴费金额</text><picker range="{{baseModeLabels}}" value="{{baseModeIndex}}" bindchange="baseMode"><view class="control">{{baseModeLabels[baseModeIndex]}}</view></picker></view>
<view wx:if="{{baseModeIndex>0&&(planIndex===0||planIndex===3)}}" class="field"><text>{{baseModeIndex===1?'工资条上的养老个人扣款':baseModeIndex===2?salaryLabel:'查询到的月缴费基数'}}</text><view class="input-wrap"><input type="digit" value="{{baseInput}}" bindinput="baseInput" placeholder="请输入金额"/><text>元</text></view></view>
<view class="hint">{{(planIndex===1||planIndex===2)?'这份交法按最低档计算。':baseNote}}</view><view wx:if="{{baseError&&baseInput!==''}}" class="error">{{baseError}}</view>
</view></view>
<view class="entry-row plan-entry"><text class="row-label">交多久</text><picker class="row-entry" range="{{planLabels}}" value="{{planIndex}}" bindchange="plan"><view class="control">{{planLabels[planIndex]}}</view></picker></view>
<view wx:if="{{planIndex===3}}" class="field"><text>还准备交多久</text><view class="input-wrap"><input type="number" value="{{form.customMonths}}" data-key="customMonths" bindinput="input"/><text>个月</text></view></view>
<button class="fold" bindtap="toggle">更多设置<text>{{advanced?'收起':'选填 ＋'}}</text></button><view wx:if="{{advanced}}"><view class="field"><text>数据截至月份</text><picker mode="date" fields="month" end="{{dateBounds.todayMonth}}" value="{{form.dataAsOf}}" data-key="dataAsOf" bindchange="input"><view class="control">{{form.dataAsOf}}</view></picker></view><view class="field"><text>账户利息（知道再填）</text><view class="input-wrap"><input type="digit" value="{{form.interest}}" data-key="interest" bindinput="input" placeholder="不知道按0计算"/><text>元</text></view></view><view class="field"><text>先停交几个月</text><input class="control" type="number" value="{{form.pauseMonths}}" data-key="pauseMonths" bindinput="input"/></view><view class="field"><text>平均缴费指数（不知道可留空）</text><input class="control" type="digit" value="{{form.historicalIndex}}" data-key="historicalIndex" bindinput="input" placeholder="不知道可留空"/></view><view class="switch-row"><text>有视同缴费等特殊历史情况</text><switch checked="{{form.historicalRights}}" bindchange="history" color="#2463eb"/></view><view class="hint">计发基数采用{{referenceParameter.year}}年{{referenceParameter.pensionBase}}元／月，未来调整未计入。</view></view>
</view><view class="submit-dock"><button class="primary" bindtap="calculate">开始计算</button></view></block>
<block wx:if="{{result}}">
<view class="pension-income"><view class="income-top"><text class="pension-label">{{result.chosen.qualified?'退休后，每月约领':result.chosen.unsupported?'先核对领取时间':'缴费年限不足'}}</text><button class="info-trigger" bindtap="resultInfo" aria-label="查看计算说明">?</button></view><block wx:if="{{result.chosen.qualified}}"><view class="pension-value">{{result.chosen.monthly}}<text>元</text></view><view class="pension-start">{{result.chosen.receiptMonth}}起领</view></block><view wx:else class="short-result">{{result.chosen.unsupported?result.chosen.error:'还差'+result.chosen.shortMonths+'个月'}}</view><view wx:if="{{result.parameter.status==='REFERENCE'}}" class="scope-tag">{{result.parameter.year}}年参数参考</view><view wx:if="{{result.warnings.length}}" class="scope-tag">日期待核对</view></view>
<view class="card field payment-card"><view class="card-title">接下来这样交</view><view class="payment-condition">已交{{paidDuration}} · 累计需交{{result.chosen.minimumMonths/12}}年</view><view class="payment-grid"><view>自己每月交<text>{{result.chosen.monthlyPersonalPayment}}元</text></view><view>还交<text>{{result.chosen.years}}</text></view></view><view class="payment-date">交至{{result.chosen.lastPaymentMonth}}<text wx:if="{{result.chosen.lastPaymentMonth>result.retirement.month}}"> · 到龄后继续交</text></view><view class="total-row"><text>还需交</text><text>{{result.chosen.futurePersonalCost}}元</text></view></view>

<view class="card result-section"><button class="fold result-fold" bindtap="compare"><view>换个方案</view><text>{{compare?'收起 −':'选择 ›'}}</text></button><view wx:if="{{compare}}" class="section-body"><button wx:for="{{planChoices}}" wx:key="plan" data-plan="{{item.plan}}" bindtap="selectPlan" class="plan-choice {{item.plan===(pendingPlan||form.plan)?'chosen-plan':''}}"><view>{{item.name}}<text>{{item.plan===(pendingPlan||form.plan)?(pendingPlan?'待确认':'当前方案'):'选择'}}</text></view><view class="plan-monthly">{{item.qualified?'每月约'+item.monthly+'元':item.unsupported?(tibet?'需重新核对领取时间':'暂不支持该年龄'):'还差'+item.shortMonths+'个月'}}</view></button><button class="primary confirm-plan" bindtap="applySelectedPlan" disabled="{{!pendingPlan}}">按所选方案计算</button></view></view>
<view class="card result-section"><button class="fold result-fold" bindtap="toggle"><view>缴费明细与说明</view><text>{{advanced?'收起 −':'查看 ›'}}</text></button><view wx:if="{{advanced}}" class="detail-text"><view>出生{{form.birthMonth}} · 首次参保{{form.firstInsuredMonth}}</view><view>已交{{form.paidMonths}}个月 · 记录截至{{form.dataAsOf}}</view><view>账户本金{{result.accountPrincipal}}元{{result.estimatedAccount?'（估算）':''}}</view><view>{{tibet?'已核对退休年月：':'法定退休'}}{{result.retirement.month}}，最低缴费{{result.chosen.minimumMonths/12}}年。</view><view>{{form.contributionType==='EMPLOYEE'?'费用只计个人承担部分，单位部分另计。单位在职须依法参保。':'费用包括灵活就业自己承担的全部养老费。'}}</view><view wx:if="{{form.plan==='MINIMUM_STOP'}}">交够年限后仍须等到领取年龄。</view><view wx:if="{{result.chosen.lastPaymentMonth>result.retirement.month}}">到龄后还需延缴，办理条件请向参保地确认。</view><view wx:if="{{result.estimatedAccount}}">账户按当前最低档或所填历史平均金额估算，未计历年变化和利息。</view><view wx:if="{{result.chosen.qualified && result.chosen.recoveryMonthsSlow>0}}">开始领取后，按{{result.chosen.recovery}}算，能领回以后交的这笔钱。包含以前积累的权益，未计等待时间和利息。</view><view wx:if="{{tibet && result.chosen.plateau}}">其中高原补贴{{result.chosen.plateau}}元／月，按退休时在藏工作{{result.chosen.tibetWorkYears}}年计算；不随缴费方案增加工作年数。</view><view>历史指数未知时按0.6，未知利息为0，参考{{result.parameter.year}}年参数；未来调整未计入。</view><view wx:if="{{result.referenceNote}}">{{result.referenceNote}}</view><view wx:for="{{result.warnings}}" wx:key="*this">{{item}}</view><view>实际领取条件和金额以社保核定为准。</view></view></view></block><view wx:if="{{result}}" class="share-entry"><button class="secondary" bindtap="openShareCard">保存／分享方案</button></view><view wx:if="{{result && !planning && !quickPlan && !referencePlan && !approvedPlanning && !planIllustration && !recordHelp && !registrationPlan}}" class="result-maintenance"><button class="result-quiet" bindtap="beginResultEdit"><image class="action-glyph" src="{{resultEditIcon}}" mode="aspectFit" aria-hidden="true"/>修改资料</button><button class="result-quiet" bindtap="requestResultReset"><image class="action-glyph" src="{{resultResetIcon}}" mode="aspectFit" aria-hidden="true"/>重新填写</button></view></view><tool-nav active="employee"/>
