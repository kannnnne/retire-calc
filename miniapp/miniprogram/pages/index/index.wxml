<view class="shell has-submit"><view class="mast"><view><view class="title">职工养老</view></view></view>
<region-picker value="{{form.regionId||'440100'}}" kind="employee" bindchange="regionChanged"/>
<block wx:if="{{!result && regionReady}}"><view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<view class="card employee-form pension-form"><view class="card-top"><view class="card-title">参保信息</view><button class="text-button" bindtap="reset">恢复默认</button></view><view wx:if="{{isDemo}}" class="notice-box field">这是虚构示例，请换成自己的数据。</view>
<checkbox-group wx:if="{{form.regionId==='440300'}}" bindchange="szScope"><label class="switch-row"><checkbox value="yes" checked="{{form.szNonLocal==='yes'}}" color="#2463eb"/>非深圳户籍，无地方补充养老权益</label></checkbox-group><view class="basic-grid"><view class="basic-field"><view class="basic-label">出生年月</view><picker mode="date" fields="month" start="{{dateBounds.birthStart}}" end="{{dateBounds.birthEnd}}" value="{{form.birthMonth}}" data-key="birthMonth" bindchange="input"><view class="control">{{form.birthMonth}}</view></picker></view><view class="basic-field"><view class="basic-label">退休类别</view><picker range="{{categoryLabels}}" value="{{categoryIndex}}" bindchange="category"><view class="control">{{categoryLabels[categoryIndex]}}</view></picker></view></view><button wx:if="{{categoryIndex>0}}" class="small-help" data-key="category" bindtap="info">不确定女性退休类别？查看说明</button>
<view class="form-section-title">已经交的</view><view class="entry-row"><text class="row-label">开始缴费</text><picker class="row-entry" mode="date" fields="month" start="{{firstStart}}" end="{{firstEnd}}" value="{{form.firstInsuredMonth}}" data-key="firstInsuredMonth" bindchange="input"><view class="control">{{form.firstInsuredMonth||'请选择'}}</view></picker></view>
<view class="entry-row"><text class="row-label">停交情况</text><picker class="row-entry" range="{{paidModeLabels}}" value="{{paidModeIndex}}" bindchange="paidMode"><view class="control">{{paidModeLabels[paidModeIndex]}}</view></picker></view>
<view wx:if="{{paidModeIndex===1}}" class="entry-row"><text class="row-label">一共停交</text><view class="input-wrap row-entry"><input type="number" value="{{gapMonths}}" bindinput="gapInput" placeholder="停交月数"/><text>个月</text></view></view>
<view wx:if="{{paidModeIndex===2}}" class="entry-row"><text class="row-label">已交月数</text><view class="input-wrap row-entry"><input type="number" value="{{form.paidMonths}}" data-key="paidMonths" bindinput="input" placeholder="查询记录里的月数"/><text>个月</text></view></view>
<view wx:if="{{form.paidMonths!==''}}" class="auto-summary"><text>累计已交</text><text>{{form.paidMonths}}个月</text></view>
<view class="compact-section"><button class="compact-heading" data-section="accountOpen" bindtap="toggleSection"><text class="compact-title">个人账户</text><view class="compact-values"><view class="compact-amount">{{accountMode==='estimate'?'约':''}}{{accountSummary||'待填写'}}{{accountSummary?'元':''}}</view><text class="compact-change">{{accountOpen?'收起 −':'修改 ›'}}</text></view></button><view wx:if="{{accountMode==='estimate'&&accountEstimate}}" class="compact-note account-basis">每月入账{{accountEstimate.monthly}}元 × 已交{{form.paidMonths}}个月</view><view wx:if="{{accountMode==='estimate'}}" class="compact-note">{{estimateModeIndex===0?'按当前最低档估算，未计历年变化和利息。':'用历史平均金额估算，未加利息。'}}</view><view wx:if="{{accountOpen}}" class="compact-editor"><view class="segment field"><button class="{{accountMode==='estimate'?'selected':''}}" data-value="estimate" bindtap="accountMode">不知道，帮我估</button><button class="{{accountMode==='known'?'selected':''}}" data-value="known" bindtap="accountMode">查过，直接填</button></view>
<block wx:if="{{accountMode==='estimate'}}"><view class="field"><text>以前大概怎么交</text><picker range="{{['按当前最低档粗算','填以前平均每月养老扣款','填以前平均每月缴费工资']}}" value="{{estimateModeIndex}}" bindchange="estimateMode"><view class="control">{{['按当前最低档粗算','平均每月养老个人扣款','平均每月缴费工资'][estimateModeIndex]}}</view></picker></view>
<view wx:if="{{estimateModeIndex>0}}" class="field"><text>{{estimateModeIndex===1?'以前每月平均养老个人扣款':'以前每月平均缴费工资'}}</text><view class="input-wrap"><input type="digit" value="{{estimateInput}}" bindinput="estimateInput" placeholder="大概金额"/><text>元</text></view><view class="hint">{{estimateModeIndex===1?'只填职工养老个人扣款，不含医保、公积金或灵活就业20%全额。':'填缴费工资，不是到手收入；账户按8%计入。'}}</view></view>
<view wx:if="{{accountEstimate}}" class="estimate-details"><view class="hint">每月入账{{accountEstimate.monthly}}元 × {{form.paidMonths}}个月</view><view class="hint">{{accountEstimate.note}}</view></view><view wx:else class="hint field">{{accountError}}</view></block>
<block wx:else><view class="field"><text>已划入账户金额（不含利息）</text><view class="input-wrap"><input type="digit" value="{{form.principal}}" data-key="principal" bindinput="input" placeholder="填查询到的金额"/><text>元</text></view></view><button class="small-help" bindtap="help">去哪查？看粤省事图解 ›</button></block>
</view></view>
<view class="form-section-title future-label">以后怎么交</view><view class="compact-section future-section"><button class="compact-heading" data-section="paymentOpen" bindtap="toggleSection"><text class="compact-title">自己每月交</text><view class="compact-values"><view class="compact-amount">{{futurePayment||'待填写'}}{{futurePayment!==''?'元':''}}</view><text class="compact-change">{{paymentOpen?'收起 −':'修改 ›'}}</text></view></button><view class="compact-note">{{form.contributionType==='EMPLOYEE'?'单位在职':'灵活就业'}} · {{planIndex===1||planIndex===2||baseModeIndex===0?'最低档':'自填金额'}}{{futureBase?' · 基数'+futureBase+'元':''}}</view><view wx:if="{{paymentOpen}}" class="compact-editor"><button class="small-help" bindtap="openFlexible">离职后自己交？去灵活就业养老 ›</button>
<view wx:if="{{planIndex===0||planIndex===3}}" class="field"><text>每月缴费金额</text><picker range="{{baseModeLabels}}" value="{{baseModeIndex}}" bindchange="baseMode"><view class="control">{{baseModeLabels[baseModeIndex]}}</view></picker></view>
<view wx:if="{{baseModeIndex>0&&(planIndex===0||planIndex===3)}}" class="field"><text>{{baseModeIndex===1?'工资条上的养老个人扣款':baseModeIndex===2?'税前月工资（优先填上年月平均）':'查询到的月缴费基数'}}</text><view class="input-wrap"><input type="digit" value="{{baseInput}}" bindinput="baseInput" placeholder="请输入金额"/><text>元</text></view></view>
<view class="hint">{{(planIndex===1||planIndex===2)?'这份交法按最低档计算。':baseNote}}</view><view wx:if="{{baseError&&baseInput!==''}}" class="error">{{baseError}}</view>
</view></view>
<view class="entry-row plan-entry"><text class="row-label">缴费计划</text><picker class="row-entry" range="{{planLabels}}" value="{{planIndex}}" bindchange="plan"><view class="control">{{planLabels[planIndex]}}</view></picker></view><view wx:if="{{planIndex===2}}" class="hint">领取年龄还没到时，交够年限也要等到龄。单位在职仍须依法参保。</view><view wx:if="{{planIndex===1||planIndex===2}}" class="hint">这个方案的以后缴费按最低档计算。</view>
<view wx:if="{{planIndex===3}}" class="field"><text>还准备交多久</text><view class="input-wrap"><input type="number" value="{{form.customMonths}}" data-key="customMonths" bindinput="input"/><text>个月</text></view></view>
<button class="fold" bindtap="toggle">更多设置<text>{{advanced?'收起':'选填 ＋'}}</text></button><view wx:if="{{advanced}}"><view class="field"><text>数据截至月份</text><picker mode="date" fields="month" end="{{dateBounds.todayMonth}}" value="{{form.dataAsOf}}" data-key="dataAsOf" bindchange="input"><view class="control">{{form.dataAsOf}}</view></picker></view><view class="field"><text>账户利息（知道再填）</text><view class="input-wrap"><input type="digit" value="{{form.interest}}" data-key="interest" bindinput="input" placeholder="不知道按0计算"/><text>元</text></view></view><view class="field"><text>先停交几个月</text><input class="control" type="number" value="{{form.pauseMonths}}" data-key="pauseMonths" bindinput="input"/></view><view class="field"><text>平均缴费指数（不知道可留空）</text><input class="control" type="digit" value="{{form.historicalIndex}}" data-key="historicalIndex" bindinput="input" placeholder="默认0.6"/></view><view class="switch-row"><text>有视同缴费等特殊历史情况</text><switch checked="{{form.historicalRights}}" bindchange="history" color="#2463eb"/></view><view class="hint">计发基数采用{{referenceParameter.year}}年{{referenceParameter.pensionBase}}元／月，未来调整未计入。</view></view>
</view><view class="submit-dock"><button class="primary" bindtap="calculate">开始计算</button></view></block>
<block wx:if="{{result}}"><view wx:for="{{result.warnings}}" wx:key="*this" class="error">{{item}}</view><view class="pension-income"><view class="pension-start">{{result.chosen.qualified?'预计'+result.chosen.receiptMonth+'起领':'还没交够领取年限'}}</view><block wx:if="{{result.chosen.qualified}}"><view class="pension-label">退休后，每月约领</view><view class="pension-value">{{result.chosen.monthly}}<text>元</text></view></block><view wx:else class="field">{{result.chosen.unsupported?result.chosen.error:'还差'+result.chosen.shortMonths+'个月，换个交法试试'}}</view></view>
<view wx:if="{{result.referenceNote}}" class="hint field">{{result.referenceNote}}</view><view class="card field"><view class="card-title">接下来这样交</view><view class="payment-grid"><view>自己每月交<text>{{result.chosen.monthlyPersonalPayment}}元</text></view><view>还要交<text>{{result.chosen.years}}</text></view></view><view class="total-row"><text>以后共交</text><text>{{result.chosen.futurePersonalCost}}元</text></view><view class="hint">{{result.chosen.name}} · {{form.contributionType==='EMPLOYEE'?'单位部分另计':'包含灵活就业自己承担的部分'}}</view><view wx:if="{{form.plan==='MINIMUM_STOP'}}" class="hint">交够年限后仍要等到领取年龄；单位在职须继续依法参保。</view></view>
<view wx:if="{{result.estimatedAccount}}" class="notice-box field">账户本金按{{result.accountPrincipal}}元估算。</view>
<view class="submit-dock result-dock"><view class="result-actions"><button class="secondary restart-button" bindtap="reset">重新填写</button><button class="primary" bindtap="edit">修改信息</button></view></view>
<view class="card result-section"><button class="fold result-fold" bindtap="compare">换个交法看看<text>{{compare?'收起 −':'展开 ＋'}}</text></button><view wx:if="{{compare}}"><button wx:for="{{result.scenarios}}" wx:key="plan" data-plan="{{item.plan}}" bindtap="choosePlan" class="plan-choice {{item.plan===form.plan?'chosen-plan':''}}"><view>{{item.name}}<text>{{item.plan===form.plan?'✓ 已选':'选择'}}</text></view><view class="plan-monthly">{{item.qualified?'每月约'+item.monthly+'元':item.unsupported?'暂不支持该年龄':'还差'+item.shortMonths+'个月'}}</view></button></view></view>
<view class="card result-section"><button class="fold result-fold" bindtap="toggle">缴费记录与计算详情<text>{{advanced?'收起 −':'展开 ＋'}}</text></button><view wx:if="{{advanced}}" class="detail-text"><view>出生{{form.birthMonth}} · 开始参保{{form.firstInsuredMonth}}</view><view>已交{{form.paidMonths}}个月 · 数据截至{{form.dataAsOf}}</view><view>账户本金{{result.accountPrincipal}}元{{result.estimatedAccount?'（粗估）':''}}</view><view>法定退休{{result.retirement.month}}，最低缴费{{result.chosen.minimumMonths/12}}年。</view><view wx:if="{{result.chosen.qualified}}">领取后约{{result.chosen.recovery}}，可领回以后交的这笔钱。这里包含以前积累的权益。</view><view>历史指数不知道时用0.6，未知利息为0，计发参考参数采用{{result.parameter.year}}年{{result.parameter.pensionBase}}元；未来增长和调整未计入。</view><view>金额供参考，实际领取条件和金额由社保确认。</view></view></view><view class="result-disclaimer">金额供参考，以实际核定为准。</view></block></view><tool-nav active="employee"/>
