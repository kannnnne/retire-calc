.share-shell{padding:40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));max-width:680px;margin:auto}.share-title{font-size:38rpx;font-weight:650;color:#182c47;margin-bottom:32rpx}.share-tabs,.share-actions{display:flex;gap:20rpx}.share-tabs button,.share-actions button{flex:1;margin:0;font-size:28rpx;min-height:48px;display:flex;align-items:center;justify-content:center}.share-tabs button{background:#e9eef6;color:#41536d}.share-tabs .active{background:#245bc1;color:#fff}.share-privacy{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;color:#182c47}.share-hint{font-size:25rpx;line-height:1.7;color:#506078;margin:20rpx 0}.poster-preview{width:100%;display:block;border-radius:20rpx;box-shadow:0 12rpx 36rpx #182c4714;margin:28rpx 0}.share-notice,.share-error,.share-status{padding:24rpx;font-size:26rpx;line-height:1.6;background:#edf3ff;color:#3f5575;border-radius:20rpx;margin:24rpx 0}.share-error{color:#9e2424;background:#fff1f1}.share-actions .save-card{background:#245bc1;color:white}.share-actions .send-card{color:#245bc1;background:#e9effa}.share-actions button[disabled]{background:#dce4ef;color:#5e6c80}.export-canvas{position:fixed;left:-10000px;top:0;pointer-events:none}.share-tabs button:after,.share-actions button:after{border:none}
.share-actions button{border-radius:999rpx}.share-actions .send-card{border:1rpx solid #d7e2f3}.poster-preview{border-radius:24rpx}
