<view class="share-shell"><block wx:if="{{personalAvailable}}"><view class="share-title">分享方案</view><view wx:if="{{personalAvailable}}" class="share-privacy"><text>显示方案金额</text><switch checked="{{reveal}}" bindchange="reveal" color="#245bc1"/></view><view wx:if="{{busy}}" class="share-status">正在生成图片…</view><view wx:if="{{image}}" class="poster-frame" style="padding-top:{{previewRatio}}%"><image class="poster-preview" src="{{image}}" mode="aspectFit" aria-label="查看方案大图" bindtap="preview"/></view><view wx:if="{{!hasCode && !busy}}" class="share-notice">预览版尚未接入正式小程序码，暂不能保存推广图片；可以直接发给好友。</view><view wx:if="{{error}}" class="share-error">{{error}}</view><button wx:if="{{error && !image}}" bindtap="render">重新生成</button><view class="share-actions"><button class="save-card" bindtap="save" loading="{{saving}}" disabled="{{busy||saving||!image||!hasCode}}">保存图片</button><button class="send-card" open-type="share">分享工具</button></view></block><view wx:else class="share-notice">请先完成测算，再保存具体方案。<button bindtap="start">去计算</button></view><canvas type="2d" id="shareCard" class="export-canvas" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px"/></view>