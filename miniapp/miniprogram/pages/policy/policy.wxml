<view class="shell"><view class="title">政策文件</view><view class="form-caption">下面是文件要点，由本工具整理，非原文全文。</view><view wx:if="{{pending}}" class="notice-box field">{{pending}}</view>
<view wx:for="{{documents}}" wx:key="id" class="card document-card"><view class="document-title">{{item.title}}</view><view class="document-meta">{{item.publisher}} · {{item.date}}</view><view class="document-meta">{{item.number}}</view><view wx:for="{{item.sections}}" wx:for-item="section" wx:key="title" class="document-section"><view class="card-title">{{section.title}}</view><view class="document-text">{{section.text}}</view><view wx:if="{{section.tiers}}" class="tier-table"><view wx:for="{{section.tiers}}" wx:for-item="tier" wx:key="*this">{{tier}}<text>元／年</text></view></view></view><view class="notice-box field">{{item.note}}</view><view class="document-meta field">完整原文</view><text class="source-url" user-select>{{item.url}}</text><button class="tutorial" data-id="{{item.id}}" bindtap="copy">复制原文链接，在浏览器打开</button></view>
<view class="quiet">参数年份见文件说明，办理前请向当地社保经办机构核对。</view></view><tool-nav/>
