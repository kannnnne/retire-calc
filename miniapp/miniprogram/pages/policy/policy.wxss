.document-card{margin-top:24rpx;padding:28rpx}.document-title{font-size:34rpx;font-weight:600;line-height:1.6}.document-meta{font-size:25rpx;color:var(--muted);line-height:1.7;margin-top:10rpx}.document-section{padding:24rpx 0;border-bottom:1rpx solid var(--line)}.document-text{font-size:29rpx;line-height:1.85;margin-top:14rpx}.tier-table{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:20rpx}.tier-table>view{padding:16rpx;background:#f1f6ff;border-radius:10rpx;font-size:32rpx;font-weight:600;color:var(--brand)}.tier-table text{font-size:25rpx;font-weight:400;margin-left:6rpx}.source-url{display:block;font-size:25rpx;line-height:1.8;overflow-wrap:anywhere;color:var(--muted);margin:16rpx 0}.document-card .tutorial{width:100%!important;white-space:normal;line-height:1.7;min-height:96rpx}
