/* Shared visual hierarchy. Native controls and calculation flows remain intact. */
page{--brand:#2862df;--ink:#20304a;--muted:#59687d;--line:#e1e7f0;--canvas:#f5f7fb;--soft:#eef4ff;--radius-card:28rpx;--radius-control:20rpx;--radius-button:999rpx}
button{border-radius:var(--radius-button)}
.primary{border-radius:var(--radius-button);border:1rpx solid transparent;min-height:48px;box-shadow:0 5rpx 12rpx rgba(40,98,223,.10)}
.secondary{border-radius:var(--radius-button);border:1rpx solid #d7e2f3;background:#edf3fd;color:#285bb5;min-height:46px}
.card,.result-card{border-radius:var(--radius-card);border-color:var(--line);box-shadow:0 6rpx 22rpx rgba(29,47,76,.035)}
.pension-income{border-radius:var(--radius-card);background:#eff5ff;border-color:#d8e5fb;box-shadow:none}
.control,.input-wrap{border-radius:var(--radius-control);border-color:#c5d0df;background:#fff}
picker .control{background:#f9fbff;border-color:#c5d0df}
.text-button,.help-link{border-radius:999rpx;background:#f0f4fa;border:1rpx solid #e1e7f0;padding:10rpx 20rpx;min-height:44px}
.segment button{border-radius:var(--radius-control);min-height:44px}
.segment .selected{background:#edf3ff;border-color:#8eaee9}
.fold{border-radius:0}
.tutorial{border-radius:20rpx;border:1rpx solid #e1e7f0;background:#f2f5fa}
.notice-box,.payback,.auto-summary{border-radius:20rpx}
.payment-grid>view{border-radius:20rpx;background:#f6f8fc}
.share-entry{display:flex;flex-direction:column;gap:16rpx}
.result-maintenance{gap:20rpx;margin-top:28rpx;padding-top:24rpx;border-top:0}
.result-maintenance .result-quiet{display:flex;gap:12rpx;min-width:0;min-height:44px;padding:12rpx 24rpx;border:1rpx solid #cdd7e5;background:#fff;border-radius:999rpx;color:var(--muted);font-size:28rpx;box-shadow:0 3rpx 10rpx rgba(29,47,76,.025)}
.result-maintenance .result-quiet.button-hover{background:#eaf0f8;opacity:1}
.action-glyph{width:32rpx;height:32rpx;flex:none}
.edit-return{border:0;margin-bottom:24rpx}
.edit-return button{border:1rpx solid #d7e0ec;border-radius:999rpx;background:#edf2f8;gap:12rpx;padding:14rpx 24rpx}
.info-trigger{position:relative;z-index:0;min-height:44px;color:#526984}
.info-trigger::before{width:38rpx;height:38rpx;border:1rpx solid #c8d5e8;background:#edf3fc;z-index:-1}
button.button-hover{opacity:.82}
.primary.button-hover{background:#1f50be;opacity:1}

.result-region-link{border:1rpx solid #dce5f3;border-radius:999rpx;background:#f0f5fd;padding:10rpx 18rpx;min-height:44px}
