/* Shared visual hierarchy. Native controls and calculation flows remain intact. */
page{--brand:#2862df;--ink:#20304a;--muted:#59687d;--line:#e1e7f0;--canvas:#f5f7fb;--soft:#eef4ff;--radius-card:28rpx;--radius-control:20rpx;--radius-button:999rpx}
button{border-radius:var(--radius-button)}
.primary{border-radius:var(--radius-button);border:1rpx solid transparent;min-height:48px;box-shadow:0 5rpx 12rpx rgba(40,98,223,.10)}
.secondary{border-radius:var(--radius-button);border:1rpx solid #d7e2f3;background:#edf3fd;color:#285bb5;min-height:46px}
.card,.result-card{border-radius:var(--radius-card);border-color:var(--line);box-shadow:0 6rpx 22rpx rgba(29,47,76,.035)}
.pension-income{border-radius:var(--radius-card);background:#eff5ff;border-color:#d8e5fb;box-shadow:none}
.control,.input-wrap{border-radius:var(--radius-control);border-color:#c5d0df;background:#fff}
picker .control{background:#f9fbff;border-color:#c5d0df}
.text-button,.help-link{border-radius:0;background:transparent;border:0;box-shadow:none;width:auto!important;min-height:44px;padding:8rpx 4rpx}
.segment button{border-radius:var(--radius-control);min-height:44px}
.segment .selected{background:#edf3ff;border-color:#8eaee9}
.fold{border-radius:0}
.tutorial{border-radius:20rpx;border:1rpx solid #e1e7f0;background:#f2f5fa}
.notice-box,.payback,.auto-summary{border-radius:20rpx}
.payment-grid>view{border-radius:20rpx;background:#f6f8fc}
.share-entry{display:flex;flex-direction:column;gap:16rpx}



.action-glyph{width:32rpx;height:32rpx;flex:none}


.info-trigger{position:relative;z-index:0;min-height:44px;color:#526984}
.info-trigger::before{width:38rpx;height:38rpx;border:1rpx solid #c8d5e8;background:#edf3fc;z-index:-1}
button.button-hover{opacity:.82}
.primary.button-hover{background:#1f50be;opacity:1}

.result-region-link{display:inline-flex;align-items:center;gap:8rpx;border:0;border-radius:0;background:transparent;box-shadow:none;width:auto!important;min-width:0;flex:none;padding:8rpx 0;min-height:44px}

/* One result action row, with a compact clearance above the bottom navigation. */
.result-tools{margin-top:40rpx}
.shell.result-shell{display:flex;flex-direction:column;min-height:100vh;box-sizing:border-box;padding-bottom:calc(48px + 44rpx + env(safe-area-inset-bottom))}
.result-shell .result-tools{margin-top:auto;padding-top:40rpx}
.result-action-row{display:flex;align-items:stretch;gap:16rpx}
.result-action-row .result-save{flex:1;min-width:0;width:auto!important;font-size:29rpx;padding:18rpx 12rpx;min-height:48px}
.result-action-row .result-edit{flex:none;width:auto!important;padding:16rpx 22rpx;gap:10rpx;border-color:#cdd7e5;background:#fff;color:var(--muted);font-size:27rpx;min-height:48px}
.compare-entry{width:100%!important;display:flex;align-items:center;justify-content:space-between;gap:20rpx;background:#eaf2ff;border:1rpx solid #c8daf8;border-radius:24rpx;min-height:68px;padding:26rpx 28rpx;margin:24rpx 0;text-align:left;color:#174ba8}
.compare-entry text{display:block;font-size:25rpx;color:#456389;line-height:1.6;margin-top:8rpx}


.mast{align-items:center}.mast .title{flex:1;min-width:0}.navigation-link{display:inline-flex;align-items:center;justify-content:flex-end;flex:none;width:auto!important;min-width:0;min-height:44px;margin:0;padding:8rpx 0;border:0;border-radius:0;background:transparent;box-shadow:none;font-size:27rpx;color:var(--brand)}
.result-region-link text{white-space:nowrap;font-size:26rpx}.result-region-link text:first-child{color:var(--muted)}.result-region-link text:last-child{color:var(--brand)}
.result-action-row .result-edit{order:0}.result-action-row .result-save{order:1}.compare-copy{flex:1;min-width:0}.compare-title{font-size:33rpx;font-weight:650;line-height:1.4}.compare-chevron{flex:none;width:16rpx;height:16rpx;border-top:3rpx solid #2862df;border-right:3rpx solid #2862df;transform:rotate(45deg);margin-right:4rpx}

.source-link{display:block;width:100%!important;height:auto;min-height:44px;text-align:left;white-space:normal;word-break:break-all;overflow:visible;border:0;border-bottom:1rpx solid var(--line);border-radius:0;background:transparent;box-shadow:none;padding:22rpx 0;font-size:28rpx;line-height:1.7;color:var(--brand)}.source-link::after{border:0}
